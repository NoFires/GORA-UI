					widget = {
						visible = "[Not(IsDataModelEmpty(AccessPlayer.GetResearchQueueBottom))]"
						size = { 80 80 }

						button_icon_round = {
							parentanchor = center
							size = { 60 60 }
							onclick = "[GetVariableSystem.Toggle('rq_ovf')]"

							textbox = {
								parentanchor = center
								align = nobaseline
								autoresize = yes
								using = fontsize_xxl
								text = "REMAINING_RESEARCH_QUEUE"
							}
						}
						button = {
							using = expand_arrow
							visible = "[Not(GetVariableSystem.Exists('rq_ovf'))]"
							parentanchor = bottom|right
							size = { 22 22 }
							tooltip = "EXPAND"
							onclick = "[GetVariableSystem.Toggle('rq_ovf')]"
						}
						button = {
							using = expand_arrow_expanded
							visible = "[GetVariableSystem.Exists('rq_ovf')]"
							parentanchor = bottom|right
							size = { 22 22 }
							tooltip = "COLLAPSE"
							onclick = "[GetVariableSystem.Toggle('rq_ovf')]"
						}

					}

					expand = {
						visible = "[IsDataModelEmpty(AccessPlayer.GetResearchQueueTop)]"
					}

					empty_state_dynamic_width = {
						tooltip = "HOW_TO_ADD_TO_RESEARCH_QUEUE"
						visible = "[IsDataModelEmpty(AccessPlayer.GetResearchQueueTop)]"
						text = "NO_TECH_IN_RESEARCH_QUEUE"
						autoresize = yes
					}

					expand = {}
				}

				### GORA UI+ — Latest Research indicator
				vbox = {
					layoutpolicy_vertical = growing
					margin = { 10 5 }
					background = { using = entry_bg_simple }

					textbox = {
						layoutpolicy_horizontal = growing
						using = fontsize_medium
						size = { 150 15 }
						text = "GORA_LATEST_RESEARCH_HEADER"
						elide = right
						align = left|nobaseline
					}

					# Rows are gated on `gora_latest_research_count` (set by the
					# on_action). GetValue returns 0 for an unset variable, so
					# at game start nothing renders and no pink placeholder
					# textures appear.
					hbox = {
						visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.Var('gora_latest_research_count').GetValue, '(CFixedPoint)1')]"
						layoutpolicy_horizontal = growing
						icon = {
							size = { 15 15 }
							texture = "[GetPlayer.MakeScope.Var('gora_latest_research_1').GetTechnology.GetTexture]"
							raw_tooltip = "[GetPlayer.MakeScope.Var('gora_latest_research_1').GetTechnology.GetName]"
						}
						textbox = {
							layoutpolicy_horizontal = growing
							using = fontsize_medium
							size = { 150 15 }
							raw_text = "[GetPlayer.MakeScope.Var('gora_latest_research_1').GetTechnology.GetName]"
							elide = right
							align = left|nobaseline
						}
						expand = {}
					}

					hbox = {
						visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.Var('gora_latest_research_count').GetValue, '(CFixedPoint)2')]"
						layoutpolicy_horizontal = growing
						icon = {
							size = { 15 15 }
							texture = "[GetPlayer.MakeScope.Var('gora_latest_research_2').GetTechnology.GetTexture]"
							raw_tooltip = "[GetPlayer.MakeScope.Var('gora_latest_research_2').GetTechnology.GetName]"
						}
						textbox = {
							layoutpolicy_horizontal = growing
							using = fontsize_medium
							size = { 150 15 }
							raw_text = "[GetPlayer.MakeScope.Var('gora_latest_research_2').GetTechnology.GetName]"
							elide = right
							align = left|nobaseline
						}
						expand = {}
					}

					hbox = {
						visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.Var('gora_latest_research_count').GetValue, '(CFixedPoint)3')]"
						layoutpolicy_horizontal = growing
						icon = {
							size = { 15 15 }
							texture = "[GetPlayer.MakeScope.Var('gora_latest_research_3').GetTechnology.GetTexture]"
							raw_tooltip = "[GetPlayer.MakeScope.Var('gora_latest_research_3').GetTechnology.GetName]"
						}
						textbox = {
							layoutpolicy_horizontal = growing
							using = fontsize_medium
							size = { 150 15 }
							raw_text = "[GetPlayer.MakeScope.Var('gora_latest_research_3').GetTechnology.GetName]"
							elide = right
							align = left|nobaseline
						}
						expand = {}
					}
				}
				### GORA UI+ — end Latest Research indicator

				### WEEKLY INNOVATION
				vbox = {
					layoutstretchfactor_horizontal = 2
					layoutpolicy_horizontal = growing
					minimumsize = { 240 -1 }
					margin = { 12 16 }
					
					background = {
						using = entry_bg_simple
					}
					
					textbox = {
						layoutpolicy_horizontal = growing
						size = { 0 30 }
						elide = right
						datacontext = "[GetPlayer]"
						align = right|nobaseline
						text = "INNOVATION_DESCRIPTION"
						tooltip = "INNOVATION_TOOLTIP"
						using = fontsize_large
					}

					textbox = {
						layoutpolicy_horizontal = growing
						size = { 0 30 }
						elide = right
						datacontext = "[GetPlayer]"
						align = right|nobaseline
						text = "TECHNOLOGY_SPREAD_RATE_DESCRIPTION"
						tooltip = "TECHNOLOGY_SPREAD_RATE_TOOLTIP"
					}
				}
			}

			# RQ: the techs beyond the row, shown by "+N" here instead of in vanilla's
			# right-click menu, so they can be dragged onto the row.
			hbox = {
				visible = "[And(GetVariableSystem.Exists('rq_ovf'), Not(IsDataModelEmpty(AccessPlayer.GetResearchQueueBottom)))]"
				layoutpolicy_horizontal = growing
				margin = { 18 0 }
				margin_bottom = 10

				dynamicgridbox = {
					datamodel = "[AccessPlayer.GetResearchQueueBottom]"
					datamodel_wrap = 14
					flipdirection = yes

					item = {
						widget = {
							size = { 90 90 }
							queued_technology = {
								parentanchor = center
								alwaystransparent = no
								draggable_behavior = {
									draggable_id = "rq_tech"
									drag_widget = {
										widget = {
											size = { 1 1 }
											widget = {
												position = "[GuiCurrentDrag.CurrentPosition]"
												widgetanchor = center
												size = { 80 80 }
												alpha = 0.7
												state = { name = rq_dragstart  trigger_on_create = yes  duration = 0  alpha = 0.7
													on_start = "[GetVariableSystem.Set('rq_xname', Technology.GetNameNoFormatting)]"
												}
												icon = {
													texture = "gfx/interface/backgrounds/round_frame_dec.dds"
													parentanchor = center
													size = { 80 80 }
												}
												icon = {
													parentanchor = center
													size = { 60 60 }
													texture = "[Technology.GetTexture]"
												}
											}
										}
									}
								}
