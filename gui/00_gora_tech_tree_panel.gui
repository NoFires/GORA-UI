# GORA UI+ — tech_tree_panel + queued_technology (partial type override)
# ─────────────────────────────────────────────────────────────────────────────
# Base: Reorder Research Queue: drag & drop techs v0.10 (Steam 3841721873,
#       generated from Victoria 3 1.15 vanilla gui/tech_tree.gui and
#       common/technology/technologies). Redefines tech_tree_panel and
#       queued_technology for drag-and-drop reordering and overflow row.
# Filename `00_gora_tech_tree_panel.gui` sorts before vanilla (`tech_tree.gui`)
# and standalone `00_research_queue_tech_tree_panel.gui` ('g' < 'r'), while
# still yielding to `000_` compat patches (e.g. Project Utopia compat).
#
# GORA deltas spliced into fixed_top:
#   1. Latest Research indicator (3-row stack of most recently acquired techs)
#      inserted between CURRENT RESEARCH and WEEKLY INNOVATION. Variables
#      `gora_latest_research_1/2/3` and `gora_latest_research_count` maintained
#      by common/on_actions/gora_latest_research_on_actions.txt.
#   2. Compact, stretchable fixed_top sizing (progress bar, margins, weekly
#      innovation min-width) so all top-bar elements stay on-screen at smaller
#      resolutions / higher UI scales.
#
# Original mod credits: Uboy.UI (Latest Research), Reorder Research Queue.
# ─────────────────────────────────────────────────────────────────────────────
types gora_tech_tree_panel
{
	type tech_tree_panel = fullscreen_block_window {
		name = "tech_tree_panel"
		enabled = yes

		blockoverride "animation_state_block" {
			state = {
				name = _show
				start_sound = {
					soundeffect = "event:/SFX/UI/SideBar/technology"
				}
				start_sound = {
					soundeffect = "snapshot:/Dynamic/mute_world_80"
				}
				start_sound = {
					soundeffect = "snapshot:/Dynamic/mute_vfx_war_100"

				}
			}

			state = {
				name = _hide
				start_sound = {
					soundeffect = "event:/SFX/UI/SideBar/technology_stop"
				}
			}
		}
		
		blockoverride "window_header_name"
		{
			text = "TECH_TREE"
		}

		blockoverride "fixed_top" {
			hbox = {
				# Compact margins/spacing so Latest Research + queue + innovation stay on-screen.
				spacing = 12
				margin = { 18 10 }
				margin_bottom = 15
				layoutpolicy_horizontal = growing
				
				### HAS NO RESEARCH
				hbox = {
					layoutpolicy_horizontal = growing
					layoutstretchfactor_horizontal = 5
					visible = "[Not(GetPlayer.HasCurrentlyResearchedTechnology)]"
					margin = { 25 12 }
					
					using = entry_bg_fancy
					
					vbox = {
						layoutpolicy_horizontal = growing
						
						textbox = {
							layoutpolicy_horizontal = growing
							autoresize = yes
							text = "NO_ACTIVE_RESEARCH"
							using = fontsize_large
							align = left|nobaseline
							alpha = 0.5
						}
						textbox = {
							layoutpolicy_horizontal = growing
							autoresize = yes
							text = "RESEARCH_PANEL"
							using = fontsize_xxl
							align = left|nobaseline
							
							using = look_at_me_text_animation
						}
					}
				}
				
				### CURRENT RESEARCH
				hbox = {
					layoutpolicy_horizontal = growing
					layoutstretchfactor_horizontal = 5
					visible = "[GetPlayer.HasCurrentlyResearchedTechnology]"
					datacontext = "[AccessPlayer.AccessCurrentlyResearchedTechnology]"

					spacing = 8
					margin = { 10 7 }
					margin_right = 12

					background = {
						using = entry_bg_simple
					}
					
					widget = {
						size = { 80 80 }
						# RQ: dropping a queued tech on the current research makes it the current
						# research (its queued prerequisites first); the old one comes right after.
						alwaystransparent = no
						drop_target = {
							accept_draggable_id = "rq_tech"
							on_receive_drop = "[PdxGuiTriggerAllAnimations(Select_CString(GetVariableSystem.Exists('rq_busy'), 'rq_busyx', Select_CString(EqualTo_string(GetDraggedDatacontext('Technology').GetNameNoFormatting, GetVariableSystem.Get('rq_xname')), Select_CString(And(GreaterThan_int32(GetDraggedDatacontext('Technology').GetResearchQueuePosition(GetPlayer.Self), '(int32)0'), GetVariableSystem.Exists(Concatenate('rq_known_', GetDraggedDatacontext('Technology').GetNameNoFormatting))), 'rq_go_up_0', 'rq_noop'), 'rq_badx')))]"
						}
						# RQ: the current research can be dragged into the queue (a down move from 0).
						draggable_behavior = {
							draggable_id = "rq_tech"
							drag_widget = {
								widget = {
									size = { 1 1 }
									widget = {
										position = "[GuiCurrentDrag.CurrentPosition]"
										widgetanchor = center
										size = { 80 80 }
										alpha = 0.7
										state = { name = rq_dragstart  trigger_on_create = yes  duration = 0  alpha = 0.7
											on_start = "[GetVariableSystem.Set('rq_xname', Technology.GetNameNoFormatting)]"
										}
										icon = {
											texture = "gfx/interface/backgrounds/round_frame_dec.dds"
											parentanchor = center
											size = { 80 80 }
										}
										icon = {
											parentanchor = center
											size = { 60 60 }
											texture = "[Technology.GetTexture]"
										}
									}
								}
							}
						}
						# RQ: shown for a few seconds when a tech did not land where it was dropped.
						textbox = {
							name = "rq_nomove"
							position = { 0 82 }
							autoresize = yes
							align = left|nobaseline
							alpha = 0
							alwaystransparent = yes
							text = "RQ_PREREQUISITES_FIRST"
							state = { name = rq_nomove_show  duration = 0.05  alpha = 1  next = rq_nomove_hold
							}
							state = { name = rq_nomove_hold  duration = 4  alpha = 1  next = rq_nomove_hide }
							state = { name = rq_nomove_hide  duration = 0.5  alpha = 0 }
						}


						icon = {
							parentanchor = center
							using = rotate_glow_animation_02
							size = { 250% 250% }
						}

						icon = {
							size = { 100% 100% }
							parentanchor = center
							texture = "[Technology.GetTexture]"

							tooltipwidget = {
								FancyTooltip_Technology = {}
							}

							### ERA
							widget = {
								size = { 25 25 }
								parentanchor = hcenter|bottom
							
								icon = {
									size = { 100% 100% }
									texture = "gfx/interface/backgrounds/round_button_bg.dds"
								}
								
								textbox = {
									text = "TECHNOLOGY_TYPE_DESCRIPTION"
									align = center|nobaseline
									parentanchor = center
								}
							}
						}

						button_icon_cancel = {
							parentanchor = top|right
							size = { 25 25 }
							tooltip = "REMOVE_CURRENT_RESEARCH_TECH_FROM_QUEUE"
							using = tooltip_ne
							onclick = "[Execute(Technology.RemoveFromQueue(GetPlayer.Self))]"
							enabled = "[IsValid(Technology.RemoveFromQueue(GetPlayer.Self))]"
						}
					}
				
					### TEXT + PROGRESS
					vbox = {
						layoutpolicy_horizontal = growing
						minimumsize = { 220 -1 }
						spacing = 5
						
						hbox = {
							layoutpolicy_horizontal = expanding

							textbox = {
								max_width = 250
								autoresize = yes
								align = nobaseline
								raw_text = "#variable [Technology.GetNameNoFormatting]#!"
								using = fontsize_large
								using = elide_fontsize_min

								tooltipwidget = {
									FancyTooltip_Technology = {}
								}
							}

							expand = {}

							textbox = {
								visible = "[Or(And(GreaterThan_CFixedPoint(Technology.GetProgress(GetPlayer.Self), '(CFixedPoint)0'), Not(Technology.HasResearchedTech(GetPlayer.Self))), GreaterThan_CFixedPoint(GetPlayer.GetMinWeeklyTechnologyProgressForTech(Technology.Self), '(CFixedPoint)0'))]"
								max_width = 150
								autoresize = yes
								margin_left = 10
								align = right|nobaseline
								using = elide_fontsize_min
								tooltip = "TECHNOLOGY_GAIN_BREAKDOWN"
								text = "TECHNOLOGY_PROGRESS_TIME_LEFT"
							}
						}

						### PROGRESS
						default_progressbar_horizontal = {
							visible = "[Or(And(GreaterThan_CFixedPoint(Technology.GetProgress(GetPlayer.Self), '(CFixedPoint)0'), Not(Technology.HasResearchedTech(GetPlayer.Self))), GreaterThan_CFixedPoint(GetPlayer.GetMinWeeklyTechnologyProgressForTech(Technology.Self), '(CFixedPoint)0'))]"
							layoutpolicy_horizontal = growing
							size = { 0 25 }
							tooltip = "TECHNOLOGY_GAIN_BREAKDOWN"

							blockoverride "values" {
								max = "[FixedPointToFloat(Technology.GetCost(GetPlayer.Self))]"
								value = "[FixedPointToFloat(Technology.GetProgress(GetPlayer.Self))]"
							}

							textbox = {
								margin_right = 10
								parentanchor = vcenter|right
								align = nobaseline
								autoresize = yes
								text = "TECHNOLOGY_PROGRESS_WITH_GAIN_NO_TOOLTIP"
							}
						}
					}

					# RQ: the controller, BEFORE the queue row in the widget tree, so the
					# states it triggers on the row and on the overflow list (after the
					# row) run in that order. Outside every datamodel, so it fires once.
					widget = {
						name = "rq_controller"
						size = { 1 1 }
						state = { name = rq_go_up_0  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_up_0')]"
							next = rq_check
						}
						state = { name = rq_go_up_1  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_up_1')]"
							next = rq_check
						}
						state = { name = rq_go_up_2  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_up_2')]"
							next = rq_check
						}
						state = { name = rq_go_up_3  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_up_3')]"
							next = rq_check
						}
						state = { name = rq_go_up_4  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_up_4')]"
							next = rq_check
						}
						state = { name = rq_go_up_5  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_up_5')]"
							next = rq_check
						}
						state = { name = rq_go_up_6  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_up_6')]"
							next = rq_check
						}
						state = { name = rq_go_up_7  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_up_7')]"
							next = rq_check
						}
						state = { name = rq_go_up_8  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_up_8')]"
							next = rq_check
						}
						state = { name = rq_go_up_9  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_up_9')]"
							next = rq_check
						}
						state = { name = rq_go_up_10  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_up_10')]"
							next = rq_check
						}
						state = { name = rq_go_up_11  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_up_11')]"
							next = rq_check
						}
						state = { name = rq_go_up_12  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_up_12')]"
							next = rq_check
						}
						state = { name = rq_go_up_13  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_up_13')]"
							next = rq_check
						}
						state = { name = rq_go_up_14  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_up_14')]"
							next = rq_check
						}
						state = { name = rq_go_up_15  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_up_15')]"
							next = rq_check
						}
						state = { name = rq_go_down_0_1  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_down_0_1')]"
							next = rq_check
						}
						state = { name = rq_go_down_0_2  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_down_0_2')]"
							next = rq_check
						}
						state = { name = rq_go_down_1_2  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_down_1_2')]"
							next = rq_check
						}
						state = { name = rq_go_down_0_3  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_down_0_3')]"
							next = rq_check
						}
						state = { name = rq_go_down_1_3  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
