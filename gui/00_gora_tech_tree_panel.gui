						state = { name = rq_go_down_0_7  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_down_0_7')]"
							next = rq_check
						}
						state = { name = rq_go_down_1_7  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
