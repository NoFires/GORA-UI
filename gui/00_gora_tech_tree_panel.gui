					# RQ: the zone right of the last shown tech ("after the last shown"),
					# holding a hidden copy of the overflow list, AFTER the row in the
					# tree, so the techs beyond the shown ones exist as widgets and are
					# re-queued after the shown ones.
					widget = {
						size = { 60 80 }
						alwaystransparent = no
						drop_target = {
							accept_draggable_id = "rq_tech"
							on_receive_drop = "[PdxGuiTriggerAllAnimations(Select_CString(GetVariableSystem.Exists('rq_busy'), 'rq_busyx', Select_CString(EqualTo_string(GetDraggedDatacontext('Technology').GetNameNoFormatting, GetVariableSystem.Get('rq_xname')), Select_CString(EqualTo_int32(GetDraggedDatacontext('Technology').GetResearchQueuePosition(GetPlayer.Self), '(int32)0'), 'rq_go_down_0_5', Select_CString(EqualTo_int32(GetDraggedDatacontext('Technology').GetResearchQueuePosition(GetPlayer.Self), '(int32)1'), 'rq_go_down_1_5', Select_CString(EqualTo_int32(GetDraggedDatacontext('Technology').GetResearchQueuePosition(GetPlayer.Self), '(int32)2'), 'rq_go_down_2_5', Select_CString(EqualTo_int32(GetDraggedDatacontext('Technology').GetResearchQueuePosition(GetPlayer.Self), '(int32)3'), 'rq_go_down_3_5', Select_CString(EqualTo_int32(GetDraggedDatacontext('Technology').GetResearchQueuePosition(GetPlayer.Self), '(int32)4'), 'rq_go_down_4_5', Select_CString(And(GreaterThan_int32(GetDraggedDatacontext('Technology').GetResearchQueuePosition(GetPlayer.Self), '(int32)6'), GetVariableSystem.Exists(Concatenate('rq_known_', GetDraggedDatacontext('Technology').GetNameNoFormatting))), 'rq_go_up_6', 'rq_noop')))))), 'rq_badx')))]"
