							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_down_1_4')]"
							next = rq_check
						}
						state = { name = rq_go_down_2_4  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_down_2_4')]"
							next = rq_check
						}
						state = { name = rq_go_down_3_4  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_down_3_4')]"
							next = rq_check
						}
						state = { name = rq_go_down_0_5  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_down_0_5')]"
							next = rq_check
						}
						state = { name = rq_go_down_1_5  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_down_1_5')]"
							next = rq_check
						}
						state = { name = rq_go_down_2_5  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_down_2_5')]"
							next = rq_check
						}
						state = { name = rq_go_down_3_5  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_down_3_5')]"
							next = rq_check
						}
						state = { name = rq_go_down_4_5  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_down_4_5')]"
							next = rq_check
						}
						state = { name = rq_go_down_0_6  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
