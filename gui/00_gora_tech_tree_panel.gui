						state = { name = rq_go_down_5_7  duration = 0  alpha = 1
							on_start = "[GetVariableSystem.Set('rq_busy', 'y')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_edges')]"
							on_start = "[PdxGuiTriggerAllAnimations('rq_mv_down_5_7')]"
