
template GDP_tooltip_with_graph
{
	tooltip = "GDP_TOOLTIP"
	tooltipwidget = {
		TooltipWidgetType = {
			blockoverride "tooltip_content_after" {
				v3_plotline_gdp = {

					blockoverride "extra_plotlines" {

						widget = {
							size = { 100% 100% }
							scissor = yes
							visible = "[Not(IsEmpty(Country.GetGDPTrend))]"
							progressbar = {
								size = { 100% 100% }
								direction = vertical
								skip_initial_animation = yes
								progresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
								noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
								alwaystransparent = yes
								min = "[GetMinPadded(Country.GetGDPTrend)]"
								max = "[GetMaxPadded(Country.GetGDPTrend)]"
								value = "[Country.GetGDP]"
								marker = {
									icon = {
										texture = "gfx/interface/progressbar/progressbar_white_glow_line_vertical.dds"
										size = { 100% 3 }
										color = { 1 0.8 0.25 1 }
									}
								}
							}
						}

						widget = {
							size = { 100% 100% }
							position = { 0 6 }
							scissor = yes
							visible = "[Not(IsEmpty(Country.GetGDPTrend))]"
							progressbar = {
								size = { 100% 100% }
								direction = vertical
								skip_initial_animation = yes
								progresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
								noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
								alwaystransparent = yes
								min = "[GetMinPadded(Country.GetGDPTrend)]"
								max = "[GetMaxPadded(Country.GetGDPTrend)]"
								value = "[Country.GetGDP]"
								marker = {
									textbox = {
										widgetanchor = left|top
										parentanchor = left
										margin_left = -10
										size = { 60 14 }
										align = right|nobaseline
										using = fontsize_small
										raw_text = "#bold #yellow [Country.GetGDP|K]#!#!"
									}
								}
							}
						}

						widget = {
							size = { 100% 100% }
							position = { 0 22 }
							scissor = yes
							visible = "[GreaterThan_CFixedPoint(Subtract_CFixedPoint(GetMax(Country.GetGDPTrend), Country.GetGDP), '(CFixedPoint)0')]"
							progressbar = {
								size = { 100% 100% }
								direction = vertical
								skip_initial_animation = yes
								progresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
								noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
								alwaystransparent = yes
								min = "[GetMinPadded(Country.GetGDPTrend)]"
								max = "[GetMaxPadded(Country.GetGDPTrend)]"
								value = "[Country.GetGDP]"
								marker = {
									textbox = {
										widgetanchor = left|top
										parentanchor = left
										margin_left = -10
										size = { 60 14 }
										align = right|nobaseline
										using = fontsize_small
										raw_text = "#bold #red -[Subtract_CFixedPoint(GetMax(Country.GetGDPTrend), Country.GetGDP)|K]#!#!"
									}
								}
							}
						}
					}
				}
			}
		}
	}
}


