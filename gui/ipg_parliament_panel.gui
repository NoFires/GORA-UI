	# On-demand foreign AI country parliament viewer (spliced into country_panel_politics_content)
	type ipg_foreign_parliament_section = flowcontainer {
		visible = "[Not(Country.IsLocalPlayer)]"
		parentanchor = hcenter
		direction = vertical
		ignoreinvisible = yes
		spacing = 6

		# Before inspection: sleek zero-overhead trigger button
		flowcontainer = {
			visible = "[Not(Country.MakeScope.Var('ipg_real_total_seats_val').IsSet)]"
			parentanchor = hcenter
			direction = vertical
			spacing = 6

			default_header = {
				parentanchor = hcenter
				blockoverride "text" {
					text = "ipg_single_chamber_title"
				}
			}

			button = {
				parentanchor = hcenter
				size = { 260 34 }
				using = default_button
				text = "ipg_inspect_foreign_btn"
				tooltip = "ipg_inspect_foreign_tt"
				using = fontsize_medium
				onclick = "[GetScriptedGui('ipg_inspect_foreign_sg').Execute(GuiScope.SetRoot(Country.MakeScope).End)]"
			}
		}

		# After inspection: compact scaled parliament panel (540px)
		flowcontainer = {
			visible = "[Country.MakeScope.Var('ipg_real_total_seats_val').IsSet]"
			parentanchor = hcenter
			direction = vertical
			ignoreinvisible = yes
			spacing = 6

			default_header = {
				visible = "[And(Not(IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties'))), Or(GetVariableSystem.HasValue('ipg_foreign_view', 'electoral'), Not(GetVariableSystem.Exists('ipg_foreign_view'))))]"
				parentanchor = hcenter
				blockoverride "text" {
					text = "ipg_foreign_header_electoral"
				}
			}
			default_header = {
				visible = "[Or(GetVariableSystem.HasValue('ipg_foreign_view', 'power'), And(IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties')), Not(GetVariableSystem.HasValue('ipg_foreign_view', 'alignment'))))]"
				parentanchor = hcenter
				blockoverride "text" {
					text = "ipg_foreign_header_power"
				}
			}
			default_header = {
				visible = "[GetVariableSystem.HasValue('ipg_foreign_view', 'alignment')]"
				parentanchor = hcenter
				blockoverride "text" {
					text = "ipg_foreign_header_alignment"
				}
			}

			# Compact 3-tab strip + refresh button
			widget = {
				parentanchor = hcenter
				size = { 540 28 }

				hbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					spacing = 5

					widget = { size = { 0 1 } layoutpolicy_horizontal = expanding }

					# Party Structure tab
					widget = {
						size = { 140 26 }
						button = {
							size = { 140 26 }
							using = default_button_primary
							enabled = no
							visible = "[Or(GetVariableSystem.HasValue('ipg_foreign_view', 'electoral'), And(Not(GetVariableSystem.Exists('ipg_foreign_view')), Not(IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties')))))]"
							text = "ipg_view_electoral"
							using = fontsize_small
						}
						button = {
							size = { 140 26 }
							using = default_button
							visible = "[Not(Or(GetVariableSystem.HasValue('ipg_foreign_view', 'electoral'), And(Not(GetVariableSystem.Exists('ipg_foreign_view')), Not(IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties'))))))]"
							onclick = "[GetVariableSystem.Set('ipg_foreign_view', 'electoral')]"
							text = "ipg_view_electoral"
							using = fontsize_small
						}
					}

					# Power Structure tab
					widget = {
						size = { 140 26 }
						button = {
							size = { 140 26 }
							using = default_button_primary
							enabled = no
							visible = "[Or(GetVariableSystem.HasValue('ipg_foreign_view', 'power'), And(Not(GetVariableSystem.Exists('ipg_foreign_view')), IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties'))))]"
							text = "ipg_view_power"
							using = fontsize_small
						}
						button = {
							size = { 140 26 }
							using = default_button
							visible = "[Not(Or(GetVariableSystem.HasValue('ipg_foreign_view', 'power'), And(Not(GetVariableSystem.Exists('ipg_foreign_view')), IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties')))))]"
							onclick = "[GetVariableSystem.Set('ipg_foreign_view', 'power')]"
							text = "ipg_view_power"
							using = fontsize_small
						}
					}

					# Political Alignment tab
					widget = {
						size = { 140 26 }
						button = {
							size = { 140 26 }
							using = default_button_primary
							enabled = no
							visible = "[GetVariableSystem.HasValue('ipg_foreign_view', 'alignment')]"
							text = "ipg_view_alignment"
							using = fontsize_small
						}
						button = {
							size = { 140 26 }
							using = default_button
							visible = "[Not(GetVariableSystem.HasValue('ipg_foreign_view', 'alignment'))]"
							onclick = "[GetVariableSystem.Set('ipg_foreign_view', 'alignment')]"
							text = "ipg_view_alignment"
							using = fontsize_small
						}
					}

					button = {
						size = { 74 26 }
						using = default_button
						text = "ipg_refresh_foreign_btn"
						tooltip = "ipg_inspect_foreign_tt"
						using = fontsize_small
						onclick = "[GetScriptedGui('ipg_inspect_foreign_sg').Execute(GuiScope.SetRoot(Country.MakeScope).End)]"
					}

					widget = { size = { 0 1 } layoutpolicy_horizontal = expanding }
				}
			}

			# Party Structure scaled canvas card (falls back seamlessly to Power Structure when no active parties exist)
			widget = {
				visible = "[And(Not(IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties'))), Or(GetVariableSystem.HasValue('ipg_foreign_view', 'electoral'), Not(GetVariableSystem.Exists('ipg_foreign_view'))))]"
				parentanchor = hcenter
				size = { 540 206 }
				using = entry_bg_fancy
				using = tooltip_below
				tooltipwidget = { ipg_tooltip_electoral_dynamic = {} }

				widget = {
					parentanchor = center
					size = { 600 230 }
					scale = 0.86
					ipg_foreign_canvas_electoral = {}
				}
			}

			# Power Structure scaled canvas card (also serves as seamless fallback for non-party countries)
			widget = {
				visible = "[Or(GetVariableSystem.HasValue('ipg_foreign_view', 'power'), And(IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties')), Not(GetVariableSystem.HasValue('ipg_foreign_view', 'alignment'))))]"
				parentanchor = hcenter
				size = { 540 206 }
				using = entry_bg_fancy
				using = tooltip_below
				tooltipwidget = { ipg_tooltip_power_dynamic = {} }

				widget = {
					parentanchor = center
					size = { 600 230 }
					scale = 0.86
					ipg_foreign_canvas_power = {}
				}
			}

			# Political Alignment scaled canvas card
			widget = {
				visible = "[GetVariableSystem.HasValue('ipg_foreign_view', 'alignment')]"
				parentanchor = hcenter
				size = { 540 206 }
				using = entry_bg_fancy
				using = tooltip_below
				tooltipwidget = { ipg_tooltip_alignment_dynamic = {} }

				widget = {
					parentanchor = center
					size = { 600 230 }
					scale = 0.86
					ipg_foreign_canvas_alignment = {}
				}
			}
		}
	}
}


# -----------------------------------------------------------------------------
# Native Victoria 3 Styled Dynamic Tooltips
# -----------------------------------------------------------------------------
types TooltipTypes
{
	# Reusable compact section banner: [Gov/Opp Icon] [Label] ...... [Seats]
	type ipg_tooltip_group_header = widget {
		size = { 436 24 }

		background = {
			using = dark_area
			alpha = 0.28
		}

		hbox = {
			margin = { 8 0 }
			spacing = 6
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			icon = {
				size = { 16 16 }
				block "group_icon" {
					texture = "gfx/interface/icons/generic_icons/in_government_icon.dds"
				}
			}

			textbox = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				align = left|nobaseline
				using = fontsize_small
				fonttintcolor = "[TooltipInfo.GetTintColor]"
				block "group_label" {
					text = "concept_in_government"
					default_format = "#P"
				}
			}

			textbox = {
				autoresize = yes
				align = right|nobaseline
				using = fontsize_small
				fonttintcolor = "[TooltipInfo.GetTintColor]"
				block "group_total" {}
			}
		}
	}

	# Power Structure table row (436 x 26)
	type ipg_tooltip_power_row = widget {
		datacontext = "[Scope.GetInterestGroup]"
		size = { 436 26 }

		background = {
			visible = "[IsOdd_int32(PdxGuiWidget.GetIndexInDataModel)]"
			using = dark_area
			alpha = 0.45
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			margin = { 8 0 }

			# Col 1 (180): color dot + IG icon + name
			widget = {
				size = { 180 26 }
				layoutpolicy_horizontal = fixed

				hbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					spacing = 5

					icon = {
						size = { 8 8 }
						texture = "gfx/interface/icons/ipg_white_circle.dds"
						tintcolor = "[InterestGroup.GetColor]"
					}
					icon = {
						size = { 20 20 }
						texture = "[InterestGroup.GetTexture]"
					}
					textbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						text = "[InterestGroup.GetNameNoFormatting]"
						align = left|nobaseline
						elide = right
						fontsize_min = 12
						fonttintcolor = "[TooltipInfo.GetTintColor]"
					}
				}
			}

			# Col 2 (56): seats
			textbox = {
				size = { 56 26 }
				layoutpolicy_horizontal = fixed
				text = "ipg_power_seats_cell"
				align = right|nobaseline
				fonttintcolor = "[TooltipInfo.GetTintColor]"
			}

			# Col 3 (66): clout %
			textbox = {
				size = { 66 26 }
				layoutpolicy_horizontal = fixed
				text = "ipg_power_share_cell"
				align = right|nobaseline
				alpha = 0.85
				fonttintcolor = "[TooltipInfo.GetTintColor]"
			}

			# Col 4 (118): approval
			textbox = {
				size = { 118 26 }
				layoutpolicy_horizontal = fixed
				text = "ipg_ig_approval_cell"
				align = right|nobaseline
				elide = right
				fontsize_min = 12
				fonttintcolor = "[TooltipInfo.GetTintColor]"
			}
		}
	}

	# Political Alignment table row (436 x 26)
