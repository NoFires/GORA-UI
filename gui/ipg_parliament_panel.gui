					}

					textbox = {
						max_width = 364
						min_width = 364
						autoresize = yes
						multiline = yes
						align = left|nobaseline
						using = fontsize_small
						fonttintcolor = "[TooltipInfo.GetTintColor]"
						block "opt_cond" {}
					}
				}
			}
		}
	}

	type ipg_tooltip_opt_auto = ipg_tooltip_layout_option_base {
		blockoverride "icon_texture" { texture = "gfx/interface/icons/law_icons/parliamentary_republic.dds" }
		blockoverride "color" { color = { 0.36 0.54 0.44 1 } }
		blockoverride "name" { text = "ipg_layout_auto" }
