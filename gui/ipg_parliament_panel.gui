	# -------------------------------------------------------------------------
	# View 1: Power Structure
	# -------------------------------------------------------------------------
	type ipg_view_power = widget {
		size = { 100% 230 }
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = preferred
		using = tooltip_below
		using = entry_bg_fancy
		tooltipwidget = { ipg_tooltip_power_dynamic = {} }

		# Left corner title & subtitle (toggleable via Info button)
		flowcontainer = {
			visible = "[Not(GetVariableSystem.Exists('ipg_hide_info'))]"
			direction = vertical
			position = { 14 10 }
			spacing = 2

			textbox = {
				autoresize = yes
				text = "ipg_upper_chamber_title"
				using = fontsize_medium
				align = left|nobaseline
			}
			textbox = {
				size = { 165 44 }
				multiline = yes
				autoresize = no
				text = "ipg_power_desc"
				using = fontsize_small
				align = left|nobaseline
				alpha = 0.78
			}
		}

		# Right corner coalition readout + election dates (toggleable via Info button)
		flowcontainer = {
			visible = "[Not(GetVariableSystem.Exists('ipg_hide_info'))]"
			parentanchor = top|right
			position = { -14 10 }
			direction = vertical
			spacing = 2

			flowcontainer = {
				parentanchor = right
				spacing = 5

				icon = {
					size = { 16 16 }
					parentanchor = vcenter
					texture = "gfx/interface/icons/generic_icons/in_government_icon.dds"
				}
				textbox = {
					autoresize = yes
					parentanchor = vcenter
					text = "ipg_power_coalition_badge"
					using = fontsize_small
					align = right|nobaseline
				}
			}

			textbox = {
				visible = "[AccessPlayer.HasElections]"
				parentanchor = right
				autoresize = yes
				text = "ipg_election_dates_line"
				using = fontsize_small
				align = right|nobaseline
				alpha = 0.82
			}
		}

		hbox = {
			size = { 100% 230 }
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = preferred

			widget = { size = { 0 1 } layoutpolicy_horizontal = expanding }
			ipg_canvas_power = {}
			widget = { size = { 0 1 } layoutpolicy_horizontal = expanding }
		}
	}


