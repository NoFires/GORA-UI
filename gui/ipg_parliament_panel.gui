			}
			overlappingitembox = {
				size = { 600 230 }
				visible = "[Or(Not(Country.MakeScope.Var('ipg_visual_seats_val').IsSet), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_visual_seats_val').GetValue, '(CFixedPoint)300'))]"
				datamodel = "[Country.MakeScope.GetList('ipg_electoral_parties')]"
				item = { ipg_assembly_300_electoral = {} }
			}
			ipg_ruler_seat = { position = { 288 18 } }
		}
	}

	# -------------------------------------------------------------------------
	# Bicameral Split View: Left Upper House (Power) + Right Lower House
	# (Electoral when captured & not Alignment tab, else Political Alignment)
	# -------------------------------------------------------------------------
	type ipg_view_bicameral = widget {
		size = { 100% 230 }
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = preferred
		using = tooltip_below
		using = entry_bg_fancy
		tooltipwidget = { ipg_tooltip_bicameral_dynamic = {} }

		hbox = {
			size = { 100% 230 }
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = preferred

			widget = { size = { 0 1 } layoutpolicy_horizontal = expanding }

			widget = {
				size = { 600 230 }

				# Chamber titles
				textbox = {
					position = { 44 52 }
					size = { 215 24 }
					align = center|nobaseline
					text = "ipg_bicameral_upper"
					using = fontsize_medium
				}
				textbox = {
					visible = "[And(Not(IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties'))), Not(GetVariableSystem.HasValue('ipg_parl_view', 'alignment')))]"
					position = { 326 30 }
					size = { 236 24 }
					align = center|nobaseline
					text = "ipg_bicameral_lower_electoral"
					using = fontsize_medium
				}
				textbox = {
					visible = "[Or(IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties')), GetVariableSystem.HasValue('ipg_parl_view', 'alignment'))]"
					position = { 326 30 }
					size = { 236 24 }
					align = center|nobaseline
					text = "ipg_bicameral_lower_alignment"
					using = fontsize_medium
				}

				# Upper House (Power, mapped from tier 100 / 200 / 300)
				overlappingitembox = {
					size = { 600 230 }
					visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_visual_seats_val').GetValue, '(CFixedPoint)100')]"
					datamodel = "[Country.MakeScope.GetList('ipg_power_igs')]"
					item = { ipg_bicameral_upper_100_power = {} }
				}
				overlappingitembox = {
					size = { 600 230 }
					visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_visual_seats_val').GetValue, '(CFixedPoint)200')]"
					datamodel = "[Country.MakeScope.GetList('ipg_power_igs')]"
					item = { ipg_bicameral_upper_200_power = {} }
				}
				overlappingitembox = {
					size = { 600 230 }
					visible = "[Or(Not(Country.MakeScope.Var('ipg_visual_seats_val').IsSet), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_visual_seats_val').GetValue, '(CFixedPoint)300'))]"
					datamodel = "[Country.MakeScope.GetList('ipg_power_igs')]"
					item = { ipg_bicameral_upper_300_power = {} }
				}

				# Lower House (Electoral when available & not Alignment tab)
				widget = {
					size = { 600 230 }
					visible = "[And(Not(IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties'))), Not(GetVariableSystem.HasValue('ipg_parl_view', 'alignment')))]"

					overlappingitembox = {
						size = { 600 230 }
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_visual_seats_val').GetValue, '(CFixedPoint)100')]"
						datamodel = "[Country.MakeScope.GetList('ipg_electoral_parties')]"
						item = { ipg_bicameral_lower_100_electoral = {} }
					}
					overlappingitembox = {
						size = { 600 230 }
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_visual_seats_val').GetValue, '(CFixedPoint)200')]"
						datamodel = "[Country.MakeScope.GetList('ipg_electoral_parties')]"
						item = { ipg_bicameral_lower_200_electoral = {} }
					}
					overlappingitembox = {
						size = { 600 230 }
						visible = "[Or(Not(Country.MakeScope.Var('ipg_visual_seats_val').IsSet), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_visual_seats_val').GetValue, '(CFixedPoint)300'))]"
						datamodel = "[Country.MakeScope.GetList('ipg_electoral_parties')]"
						item = { ipg_bicameral_lower_300_electoral = {} }
					}
				}

				# Lower House (Political Alignment fallback / selected)
				widget = {
					size = { 600 230 }
					visible = "[Or(IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties')), GetVariableSystem.HasValue('ipg_parl_view', 'alignment'))]"

					widget = {
						size = { 600 230 }
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_visual_seats_val').GetValue, '(CFixedPoint)100')]"
						overlappingitembox = {
							size = { 600 230 }
							datamodel = "[Country.MakeScope.GetList('ipg_alignment_igs')]"
							item = { ipg_bicameral_lower_100_alignment = {} }
						}
						ipg_bicameral_lower_100_unaligned = {}
					}
					widget = {
						size = { 600 230 }
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_visual_seats_val').GetValue, '(CFixedPoint)200')]"
						overlappingitembox = {
							size = { 600 230 }
							datamodel = "[Country.MakeScope.GetList('ipg_alignment_igs')]"
							item = { ipg_bicameral_lower_200_alignment = {} }
						}
						ipg_bicameral_lower_200_unaligned = {}
					}
					widget = {
						size = { 600 230 }
						visible = "[Or(Not(Country.MakeScope.Var('ipg_visual_seats_val').IsSet), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_visual_seats_val').GetValue, '(CFixedPoint)300'))]"
						overlappingitembox = {
							size = { 600 230 }
							datamodel = "[Country.MakeScope.GetList('ipg_alignment_igs')]"
							item = { ipg_bicameral_lower_300_alignment = {} }
						}
						ipg_bicameral_lower_300_unaligned = {}
					}
				}

				ipg_ruler_seat = { position = { 276 188 } }
			}

			widget = { size = { 0 1 } layoutpolicy_horizontal = expanding }
		}

		# Compact top-left total & top-right election dates (toggleable)
		flowcontainer = {
			visible = "[Not(GetVariableSystem.Exists('ipg_hide_info'))]"
			direction = vertical
			position = { 14 8 }
			spacing = 2

			flowcontainer = {
				spacing = 4
				icon = {
					size = { 16 16 }
					parentanchor = vcenter
					texture = "gfx/interface/icons/generic_icons/in_government_icon.dds"
				}
				textbox = {
					autoresize = yes
					parentanchor = vcenter
					text = "ipg_power_coalition_badge"
					using = fontsize_small
					align = left|nobaseline
				}
			}
			textbox = {
				visible = "[AccessPlayer.HasElections]"
				autoresize = yes
				text = "ipg_election_dates_line"
				using = fontsize_small
				align = left|nobaseline
				alpha = 0.85
			}
		}
	}


	# -------------------------------------------------------------------------
	# Top-level container: header + 3 view tabs + canvas + layout switcher bar
	# -------------------------------------------------------------------------
	type parliament_item = vbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = preferred
		spacing = 5

		# --- Collapsed state: a single bar with an "Expand" button ---
		hbox = {
			size = { 100% 34 }
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = preferred
			spacing = 8
			visible = "[GetVariableSystem.Exists('ipg_parl_collapsed')]"
			using = entry_bg_fancy

			textbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				text = "ipg_panel_title"
				using = fontsize_medium
				align = left|nobaseline
				margin_left = 12
			}

			button = {
				size = { 100 28 }
				using = default_button
				onclick = "[GetVariableSystem.Toggle('ipg_parl_collapsed')]"
				text = "ipg_expand"
				using = fontsize_medium
			}
		}

		# --- Expanded state: tab strip + canvas with bottom-right layout selector ---
		vbox = {
			size = { 100% 266 }
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = preferred
			spacing = 4
			visible = "[Not(GetVariableSystem.Exists('ipg_parl_collapsed'))]"

			# On-demand refresh whenever the panel becomes visible / expanded
			state = {
				name = _show
				on_start = "[GetScriptedGui('ipg_open_refresh_sg').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}

			# --- Top bar: 3 View tabs + Info toggle + Collapse ---
			hbox = {
				spacing = 6
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = preferred

				widget = { size = { 0 1 } layoutpolicy_horizontal = expanding }

				# Party Structure (Electoral) tab
				widget = {
					size = { 168 30 }

					button = {
						size = { 168 30 }
						using = default_button_primary
						enabled = no
						visible = "[Or(GetVariableSystem.HasValue('ipg_parl_view', 'electoral'), And(Not(GetVariableSystem.Exists('ipg_parl_view')), Not(IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties')))))]"
						text = "ipg_view_electoral"
						using = fontsize_medium
					}
					button = {
						size = { 168 30 }
						using = default_button
						visible = "[Not(Or(GetVariableSystem.HasValue('ipg_parl_view', 'electoral'), And(Not(GetVariableSystem.Exists('ipg_parl_view')), Not(IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties'))))))]"
						onclick = "[GetVariableSystem.Set('ipg_parl_view', 'electoral')]"
						onclick = "[GetVariableSystem.Clear('ipg_layout_menu_open')]"
						onclick = "[GetVariableSystem.Clear('ipg_formula_menu_open')]"
						text = "ipg_view_electoral"
						using = fontsize_medium
					}
				}

				# Power Structure tab
				widget = {
					size = { 168 30 }

					button = {
						size = { 168 30 }
						using = default_button_primary
						enabled = no
						visible = "[Or(GetVariableSystem.HasValue('ipg_parl_view', 'power'), And(Not(GetVariableSystem.Exists('ipg_parl_view')), IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties'))))]"
						text = "ipg_view_power"
						using = fontsize_medium
					}
					button = {
						size = { 168 30 }
						using = default_button
						visible = "[Not(Or(GetVariableSystem.HasValue('ipg_parl_view', 'power'), And(Not(GetVariableSystem.Exists('ipg_parl_view')), IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties')))))]"
						onclick = "[GetVariableSystem.Set('ipg_parl_view', 'power')]"
						onclick = "[GetVariableSystem.Clear('ipg_layout_menu_open')]"
						onclick = "[GetVariableSystem.Clear('ipg_formula_menu_open')]"
						text = "ipg_view_power"
						using = fontsize_medium
					}
				}

				# Political Alignment tab
				widget = {
					size = { 168 30 }

					button = {
						size = { 168 30 }
						using = default_button_primary
						enabled = no
						visible = "[GetVariableSystem.HasValue('ipg_parl_view', 'alignment')]"
						text = "ipg_view_alignment"
						using = fontsize_medium
					}
					button = {
						size = { 168 30 }
						using = default_button
						visible = "[Not(GetVariableSystem.HasValue('ipg_parl_view', 'alignment'))]"
						onclick = "[GetVariableSystem.Set('ipg_parl_view', 'alignment')]"
						onclick = "[GetVariableSystem.Clear('ipg_layout_menu_open')]"
						onclick = "[GetVariableSystem.Clear('ipg_formula_menu_open')]"
						text = "ipg_view_alignment"
						using = fontsize_medium
					}
				}

				# Toggle corner overlays (Info)
				button = {
					size = { 68 30 }
					using = default_button
					onclick = "[GetVariableSystem.Toggle('ipg_hide_info')]"
					text = "ipg_toggle_info_btn"
					tooltip = "ipg_toggle_info_tt"
					using = fontsize_small
				}

				# Collapse button
				button = {
					size = { 82 30 }
					using = default_button
					onclick = "[GetVariableSystem.Toggle('ipg_parl_collapsed')]"
					onclick = "[GetVariableSystem.Clear('ipg_layout_menu_open')]"
					onclick = "[GetVariableSystem.Clear('ipg_formula_menu_open')]"
					text = "ipg_collapse"
					using = fontsize_medium
				}

				widget = { size = { 0 1 } layoutpolicy_horizontal = expanding }
			}

			# --- Canvas stage + bottom-right layout selector trigger & popup ---
			widget = {
				size = { 100% 230 }
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = fixed

				# Selected sub-view (single chamber OR Bicameral split, manual OR auto=5)
				ipg_view_bicameral = {
					visible = "[Or(GetVariableSystem.HasValue('ipg_layout_mode', 'bicameral'), And(Not(GetVariableSystem.Exists('ipg_layout_mode')), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_layout').GetValue, '(CFixedPoint)5')))]"
				}
				ipg_view_electoral = {
					visible = "[And(Not(Or(GetVariableSystem.HasValue('ipg_layout_mode', 'bicameral'), And(Not(GetVariableSystem.Exists('ipg_layout_mode')), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_layout').GetValue, '(CFixedPoint)5')))), And(Not(IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties'))), Or(GetVariableSystem.HasValue('ipg_parl_view', 'electoral'), Not(GetVariableSystem.Exists('ipg_parl_view')))))]"
				}
				ipg_view_power = {
					visible = "[And(Not(Or(GetVariableSystem.HasValue('ipg_layout_mode', 'bicameral'), And(Not(GetVariableSystem.Exists('ipg_layout_mode')), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_layout').GetValue, '(CFixedPoint)5')))), Or(GetVariableSystem.HasValue('ipg_parl_view', 'power'), And(IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties')), Not(GetVariableSystem.HasValue('ipg_parl_view', 'alignment')))))]"
				}
				ipg_view_alignment = {
					visible = "[And(Not(Or(GetVariableSystem.HasValue('ipg_layout_mode', 'bicameral'), And(Not(GetVariableSystem.Exists('ipg_layout_mode')), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_layout').GetValue, '(CFixedPoint)5')))), GetVariableSystem.HasValue('ipg_parl_view', 'alignment'))]"
				}

				# --- Bottom-left compact Seat Formula selector button (default: Auto PR) ---
				widget = {
					parentanchor = bottom|left
					position = { 12 -10 }
					size = { 134 26 }
					alwaystransparent = no
					using = tooltip_above
					tooltipwidget = { ipg_tooltip_formula_status = {} }

					button = {
						size = { 134 26 }
						visible = "[Not(GetVariableSystem.Exists('ipg_formula_menu_open'))]"
						using = default_button
						onclick = "[GetVariableSystem.Toggle('ipg_formula_menu_open')]"
						onclick = "[GetVariableSystem.Clear('ipg_layout_menu_open')]"
					}
					button = {
						size = { 134 26 }
						visible = "[GetVariableSystem.Exists('ipg_formula_menu_open')]"
						using = default_button_primary
						onclick = "[GetVariableSystem.Toggle('ipg_formula_menu_open')]"
						onclick = "[GetVariableSystem.Clear('ipg_layout_menu_open')]"
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						margin = { 8 0 }
						spacing = 4
						alwaystransparent = yes

						icon = {
							size = { 16 16 }
							texture = "gfx/interface/icons/law_icons/census_voting.dds"
							alwaystransparent = yes
						}

						textbox = {
							visible = "[Not(Country.MakeScope.Var('ipg_formula_override').IsSet)]"
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							text = "ipg_formula_auto"
							align = center|nobaseline
							elide = right
							using = fontsize_small
							alwaystransparent = yes
						}
						textbox = {
							visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_formula_override').GetValue, '(CFixedPoint)1')]"
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							text = "ipg_formula_1"
							align = center|nobaseline
							elide = right
							using = fontsize_small
							alwaystransparent = yes
						}
						textbox = {
							visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_formula_override').GetValue, '(CFixedPoint)2')]"
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							text = "ipg_formula_2"
							align = center|nobaseline
							elide = right
							using = fontsize_small
							alwaystransparent = yes
						}
						textbox = {
							visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_formula_override').GetValue, '(CFixedPoint)3')]"
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							text = "ipg_formula_3"
							align = center|nobaseline
							elide = right
							using = fontsize_small
							alwaystransparent = yes
						}
						textbox = {
							visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_formula_override').GetValue, '(CFixedPoint)4')]"
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							text = "ipg_formula_4"
							align = center|nobaseline
							elide = right
							using = fontsize_small
							alwaystransparent = yes
						}
						textbox = {
							visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_formula_override').GetValue, '(CFixedPoint)5')]"
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							text = "ipg_formula_5"
							align = center|nobaseline
							elide = right
							using = fontsize_small
							alwaystransparent = yes
						}

						icon = {
							size = { 12 12 }
							texture = "gfx/interface/politics_view/summary_arrow_down.dds"
							alpha = 0.85
							alwaystransparent = yes
						}
					}
				}

				# --- Floating Seat Formula picker popup (anchored cleanly above bottom-left button) ---
				widget = {
					visible = "[GetVariableSystem.Exists('ipg_formula_menu_open')]"
					parentanchor = bottom|left
					position = { 12 -39 }
					size = { 174 184 }
					alwaystransparent = no

					background = {
						using = dropdown_background
					}

					flowcontainer = {
						parentanchor = center
						direction = vertical
						spacing = 2

						# Formula 0: Auto PR
						widget = {
							size = { 158 26 }
							tooltip_type = widget
							tooltip_parentanchor = vcenter|right
							tooltip_widgetanchor = vcenter|left
							tooltip_verticalbehavior = slide
							tooltip_horizontalbehavior = mirror
							tooltipwidget = { ipg_tooltip_formula_opt_auto = {} }

							button = {
								size = { 158 26 }
								visible = "[Not(Country.MakeScope.Var('ipg_formula_override').IsSet)]"
								using = default_button_primary
								onclick = "[GetScriptedGui('ipg_set_formula_auto_sg').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetVariableSystem.Clear('ipg_formula_menu_open')]"
							}
							button = {
								size = { 158 26 }
								visible = "[Country.MakeScope.Var('ipg_formula_override').IsSet]"
								using = default_button
								onclick = "[GetScriptedGui('ipg_set_formula_auto_sg').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetVariableSystem.Clear('ipg_formula_menu_open')]"
							}
							hbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								margin = { 10 0 }
								alwaystransparent = yes
								textbox = {
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding
									text = "ipg_formula_auto"
									align = left|nobaseline
									using = fontsize_small
									alwaystransparent = yes
								}
								icon = {
									visible = "[Not(Country.MakeScope.Var('ipg_formula_override').IsSet)]"
									size = { 14 14 }
									texture = "gfx/interface/icons/generic_icons/checkmark.dds"
									alwaystransparent = yes
								}
							}
						}

						# Formula 1: Hare / Hamilton
						widget = {
							size = { 158 26 }
							tooltip_type = widget
							tooltip_parentanchor = vcenter|right
							tooltip_widgetanchor = vcenter|left
							tooltip_verticalbehavior = slide
							tooltip_horizontalbehavior = mirror
							tooltipwidget = { ipg_tooltip_formula_opt_1 = {} }

							button = {
								size = { 158 26 }
								visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_formula_override').GetValue, '(CFixedPoint)1')]"
								using = default_button_primary
								onclick = "[GetScriptedGui('ipg_set_formula_1_sg').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetVariableSystem.Clear('ipg_formula_menu_open')]"
							}
							button = {
								size = { 158 26 }
								visible = "[Not(EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_formula_override').GetValue, '(CFixedPoint)1'))]"
								using = default_button
								onclick = "[GetScriptedGui('ipg_set_formula_1_sg').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetVariableSystem.Clear('ipg_formula_menu_open')]"
							}
							hbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								margin = { 10 0 }
								alwaystransparent = yes
								textbox = {
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding
									text = "ipg_formula_1"
									align = left|nobaseline
									using = fontsize_small
									alwaystransparent = yes
								}
								icon = {
									visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_formula_override').GetValue, '(CFixedPoint)1')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/generic_icons/checkmark.dds"
									alwaystransparent = yes
								}
							}
						}

						# Formula 2: D'Hondt
						widget = {
							size = { 158 26 }
							tooltip_type = widget
							tooltip_parentanchor = vcenter|right
							tooltip_widgetanchor = vcenter|left
							tooltip_verticalbehavior = slide
							tooltip_horizontalbehavior = mirror
							tooltipwidget = { ipg_tooltip_formula_opt_2 = {} }

							button = {
								size = { 158 26 }
								visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_formula_override').GetValue, '(CFixedPoint)2')]"
								using = default_button_primary
								onclick = "[GetScriptedGui('ipg_set_formula_2_sg').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetVariableSystem.Clear('ipg_formula_menu_open')]"
							}
							button = {
								size = { 158 26 }
								visible = "[Not(EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_formula_override').GetValue, '(CFixedPoint)2'))]"
								using = default_button
								onclick = "[GetScriptedGui('ipg_set_formula_2_sg').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetVariableSystem.Clear('ipg_formula_menu_open')]"
							}
							hbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								margin = { 10 0 }
								alwaystransparent = yes
								textbox = {
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding
									text = "ipg_formula_2"
									align = left|nobaseline
									using = fontsize_small
									alwaystransparent = yes
								}
								icon = {
									visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_formula_override').GetValue, '(CFixedPoint)2')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/generic_icons/checkmark.dds"
									alwaystransparent = yes
								}
							}
						}

						# Formula 3: Sainte-Lague
						widget = {
							size = { 158 26 }
							tooltip_type = widget
							tooltip_parentanchor = vcenter|right
							tooltip_widgetanchor = vcenter|left
							tooltip_verticalbehavior = slide
							tooltip_horizontalbehavior = mirror
							tooltipwidget = { ipg_tooltip_formula_opt_3 = {} }

							button = {
								size = { 158 26 }
								visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_formula_override').GetValue, '(CFixedPoint)3')]"
								using = default_button_primary
								onclick = "[GetScriptedGui('ipg_set_formula_3_sg').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetVariableSystem.Clear('ipg_formula_menu_open')]"
							}
							button = {
								size = { 158 26 }
								visible = "[Not(EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_formula_override').GetValue, '(CFixedPoint)3'))]"
								using = default_button
								onclick = "[GetScriptedGui('ipg_set_formula_3_sg').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetVariableSystem.Clear('ipg_formula_menu_open')]"
							}
							hbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								margin = { 10 0 }
								alwaystransparent = yes
								textbox = {
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding
									text = "ipg_formula_3"
									align = left|nobaseline
									using = fontsize_small
									alwaystransparent = yes
								}
								icon = {
									visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_formula_override').GetValue, '(CFixedPoint)3')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/generic_icons/checkmark.dds"
									alwaystransparent = yes
								}
							}
						}

						# Formula 4: 5% Threshold PR
						widget = {
							size = { 158 26 }
							tooltip_type = widget
							tooltip_parentanchor = vcenter|right
							tooltip_widgetanchor = vcenter|left
							tooltip_verticalbehavior = slide
							tooltip_horizontalbehavior = mirror
