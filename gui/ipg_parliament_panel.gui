	# =========================================================================
	# 7. Bottom-Left Seat Formula Status Tooltip + 6 Formula Option Tooltips
	# =========================================================================
	type ipg_tooltip_formula_status = FancyTooltipWidgetType {
		blockoverride "icon_texture" {
			texture = "gfx/interface/icons/law_icons/census_voting.dds"
		}
		blockoverride "icon_size" {
			size = { 44 44 }
		}
		blockoverride "color" {
			color = { 0.36 0.48 0.54 1 }
		}
		blockoverride "name" {
			text = "ipg_formula_menu_title"
		}
		blockoverride "type" {
			text = "[SelectLocalization(Country.MakeScope.Var('ipg_formula_override').IsSet, 'ipg_mode_manual_badge', 'ipg_mode_auto_badge')]"
		}
		blockoverride "text" {
			visible = no
		}
		blockoverride "tooltip_content_after" {
			flowcontainer = {
				direction = vertical
				spacing = 8

				# Active formula banner
				widget = {
					size = { 392 30 }

					background = {
						using = dark_area
						alpha = 0.55
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						margin = { 10 0 }
						spacing = 8

						textbox = {
							autoresize = yes
							text = "ipg_formula_current_label"
							default_format = "#title"
							align = left|nobaseline
							using = fontsize_small
							fonttintcolor = "[TooltipInfo.GetTintColor]"
						}

						widget = { size = { 0 1 } layoutpolicy_horizontal = expanding }

						textbox = {
							visible = "[Or(Not(Country.MakeScope.Var('ipg_active_formula').IsSet), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_active_formula').GetValue, '(CFixedPoint)1'))]"
							autoresize = yes
							text = "ipg_formula_1"
							default_format = "#v"
							align = right|nobaseline
							fonttintcolor = "[TooltipInfo.GetTintColor]"
						}
						textbox = {
							visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_active_formula').GetValue, '(CFixedPoint)2')]"
							autoresize = yes
							text = "ipg_formula_2"
							default_format = "#v"
							align = right|nobaseline
							fonttintcolor = "[TooltipInfo.GetTintColor]"
						}
						textbox = {
							visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_active_formula').GetValue, '(CFixedPoint)3')]"
							autoresize = yes
							text = "ipg_formula_3"
							default_format = "#v"
							align = right|nobaseline
							fonttintcolor = "[TooltipInfo.GetTintColor]"
						}
						textbox = {
							visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_active_formula').GetValue, '(CFixedPoint)4')]"
							autoresize = yes
							text = "ipg_formula_4"
							default_format = "#v"
							align = right|nobaseline
							fonttintcolor = "[TooltipInfo.GetTintColor]"
						}
						textbox = {
							visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_active_formula').GetValue, '(CFixedPoint)5')]"
							autoresize = yes
							text = "ipg_formula_5"
							default_format = "#v"
							align = right|nobaseline
							fonttintcolor = "[TooltipInfo.GetTintColor]"
						}
					}
				}

				# Match reason card
				flowcontainer = {
					direction = vertical
					spacing = 4
					margin = { 10 8 }

					background = {
						using = dark_area
						alpha = 0.35
					}

					textbox = {
						max_width = 372
						min_width = 372
						autoresize = yes
						text = "ipg_formula_reason_label"
						default_format = "#title"
						align = left|nobaseline
						using = fontsize_small
						fonttintcolor = "[TooltipInfo.GetTintColor]"
					}

					divider_clean = {
						size = { 372 2 }
					}

					textbox = {
						visible = "[Country.MakeScope.Var('ipg_formula_override').IsSet]"
						max_width = 372
						min_width = 372
						autoresize = yes
						multiline = yes
						text = "ipg_formula_reason_manual"
						align = left|nobaseline
						fonttintcolor = "[TooltipInfo.GetTintColor]"
					}
					textbox = {
						visible = "[And(Not(Country.MakeScope.Var('ipg_formula_override').IsSet), Or(Not(Country.MakeScope.Var('ipg_auto_formula_reason').IsSet), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_formula_reason').GetValue, '(CFixedPoint)1')))]"
						max_width = 372
						min_width = 372
						autoresize = yes
						multiline = yes
						text = "ipg_formula_reason_1"
						align = left|nobaseline
						fonttintcolor = "[TooltipInfo.GetTintColor]"
					}
					textbox = {
						visible = "[And(Not(Country.MakeScope.Var('ipg_formula_override').IsSet), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_formula_reason').GetValue, '(CFixedPoint)2'))]"
						max_width = 372
						min_width = 372
						autoresize = yes
						multiline = yes
						text = "ipg_formula_reason_2"
						align = left|nobaseline
						fonttintcolor = "[TooltipInfo.GetTintColor]"
					}
					textbox = {
						visible = "[And(Not(Country.MakeScope.Var('ipg_formula_override').IsSet), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_formula_reason').GetValue, '(CFixedPoint)3'))]"
						max_width = 372
						min_width = 372
						autoresize = yes
						multiline = yes
						text = "ipg_formula_reason_3"
						align = left|nobaseline
						fonttintcolor = "[TooltipInfo.GetTintColor]"
					}
					textbox = {
						visible = "[And(Not(Country.MakeScope.Var('ipg_formula_override').IsSet), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_formula_reason').GetValue, '(CFixedPoint)4'))]"
						max_width = 372
						min_width = 372
						autoresize = yes
						multiline = yes
						text = "ipg_formula_reason_4"
						align = left|nobaseline
						fonttintcolor = "[TooltipInfo.GetTintColor]"
					}
					textbox = {
						visible = "[And(Not(Country.MakeScope.Var('ipg_formula_override').IsSet), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_formula_reason').GetValue, '(CFixedPoint)5'))]"
						max_width = 372
						min_width = 372
						autoresize = yes
						multiline = yes
						text = "ipg_formula_reason_5"
						align = left|nobaseline
						fonttintcolor = "[TooltipInfo.GetTintColor]"
					}
				}

				textbox = {
					max_width = 392
					autoresize = yes
					text = "ipg_formula_click_hint"
					align = left|nobaseline
					using = fontsize_small
					alpha = 0.85
					fonttintcolor = "[TooltipInfo.GetTintColor]"
				}
			}
		}
	}

