			visible = "[And(Not(IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties'))), Or(GetVariableSystem.HasValue('ipg_layout_mode', 'westminster'), And(Not(GetVariableSystem.Exists('ipg_layout_mode')), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_layout').GetValue, '(CFixedPoint)2'))))]"

			overlappingitembox = {
