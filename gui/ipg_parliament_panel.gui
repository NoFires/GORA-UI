	# =========================================================================
	# 1. Power Structure Tooltip
	# =========================================================================
	type ipg_tooltip_power_dynamic = FancyTooltipWidgetType {
		blockoverride "icon_texture" {
			texture = "gfx/interface/main_hud/pol_btn.dds"
		}
		blockoverride "icon_size" {
			size = { 42 42 }
		}
		blockoverride "color" {
			color = { 0.56 0.36 0.50 1 }
		}
		blockoverride "name" {
			text = "ipg_tooltip_power_title"
		}
		blockoverride "type" {
			text = "ipg_total_seats_header"
		}
		blockoverride "text" {
			visible = no
		}
		blockoverride "tooltip_content_after" {
			flowcontainer = {
				direction = vertical
				spacing = 8

				# Hero coalition KPI + proportional multi-color stacked bar
				flowcontainer = {
					direction = vertical
					spacing = 5

					widget = {
						size = { 436 24 }

						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							margin = { 2 0 }

							flowcontainer = {
								spacing = 5
								icon = {
									size = { 20 20 }
									parentanchor = vcenter
									texture = "gfx/interface/icons/generic_icons/in_government_icon.dds"
								}
								textbox = {
									autoresize = yes
									parentanchor = vcenter
									text = "ipg_power_gov_kpi"
									align = left|nobaseline
									fonttintcolor = "[TooltipInfo.GetTintColor]"
								}
							}

							widget = { size = { 0 1 } layoutpolicy_horizontal = expanding }

							flowcontainer = {
								spacing = 5
								textbox = {
									autoresize = yes
									parentanchor = vcenter
									text = "ipg_power_opp_kpi"
									align = right|nobaseline
									fonttintcolor = "[TooltipInfo.GetTintColor]"
								}
								icon = {
									size = { 20 20 }
									parentanchor = vcenter
									texture = "gfx/interface/icons/generic_icons/in_opposition_icon.dds"
								}
							}
						}
					}

					# Multi-color parliament seat bar (vanilla v3_stacked_barchart layout)
					widget = {
						size = { 436 14 }

						background = {
							using = dark_area
							alpha = 0.75
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							margin = { 2 2 }

							# Governing coalition segments
							hbox = {
								visible = "[GreaterThan_CFixedPoint(Country.MakeScope.Var('ipg_power_gov_seats').GetValue, '(CFixedPoint)0')]"
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								layoutstretchfactor_horizontal = "[FixedPointToInt(Country.MakeScope.Var('ipg_power_gov_seats').GetValue)]"
								datamodel = "[Country.MakeScope.GetList('ipg_power_gov_igs')]"

								item = {
									hbox = {
										datacontext = "[Scope.GetInterestGroup]"
										visible = "[GreaterThan_CFixedPoint(InterestGroup.MakeScope.Var('power_seats').GetValue, '(CFixedPoint)0')]"
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding
										layoutstretchfactor_horizontal = "[FixedPointToInt(InterestGroup.MakeScope.Var('power_seats').GetValue)]"

										background = {
											texture = "gfx/interface/tooltip/stacked_barchart_small_item.dds"
											color = "[InterestGroup.GetColor]"
											spriteType = Corneredstretched
											spriteborder = { 2 2 }
										}
									}
								}
							}

							# Opposition segments
							hbox = {
								visible = "[GreaterThan_CFixedPoint(Country.MakeScope.Var('ipg_power_opp_seats').GetValue, '(CFixedPoint)0')]"
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								layoutstretchfactor_horizontal = "[FixedPointToInt(Country.MakeScope.Var('ipg_power_opp_seats').GetValue)]"
								datamodel = "[Country.MakeScope.GetList('ipg_power_opp_igs')]"

								item = {
									hbox = {
										datacontext = "[Scope.GetInterestGroup]"
										visible = "[GreaterThan_CFixedPoint(InterestGroup.MakeScope.Var('power_seats').GetValue, '(CFixedPoint)0')]"
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding
										layoutstretchfactor_horizontal = "[FixedPointToInt(InterestGroup.MakeScope.Var('power_seats').GetValue)]"

										background = {
											texture = "gfx/interface/tooltip/stacked_barchart_small_item.dds"
											color = "[InterestGroup.GetColor]"
											alpha = 0.72
											spriteType = Corneredstretched
											spriteborder = { 2 2 }
										}
									}
								}
							}
						}

						icon = {
							size = { 100% 100% }
							texture = "gfx/interface/progressbar/progressbar_frame.dds"
							spriteType = Corneredstretched
							spriteborder = { 6 6 }
							texture_density = 2
						}
					}

					# Active seat apportionment formula caption
					widget = {
						size = { 436 18 }
						alpha = 0.78

						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							margin = { 4 0 }
							spacing = 6

							textbox = {
								autoresize = yes
								text = "ipg_formula_current_label"
								default_format = "#title"
								align = left|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
							widget = { size = { 0 1 } layoutpolicy_horizontal = expanding }
							textbox = {
								visible = "[Or(Not(Country.MakeScope.Var('ipg_active_formula').IsSet), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_active_formula').GetValue, '(CFixedPoint)1'))]"
								autoresize = yes
								text = "ipg_formula_1"
								align = right|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
							textbox = {
								visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_active_formula').GetValue, '(CFixedPoint)2')]"
								autoresize = yes
								text = "ipg_formula_2"
								align = right|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
							textbox = {
								visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_active_formula').GetValue, '(CFixedPoint)3')]"
								autoresize = yes
								text = "ipg_formula_3"
								align = right|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
							textbox = {
								visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_active_formula').GetValue, '(CFixedPoint)4')]"
								autoresize = yes
								text = "ipg_formula_4"
								align = right|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
							textbox = {
								visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_active_formula').GetValue, '(CFixedPoint)5')]"
								autoresize = yes
								text = "ipg_formula_5"
								align = right|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
						}
					}
				}

				# Grouped table
				flowcontainer = {
					direction = vertical
					spacing = 2

					# Column headers
					widget = {
						size = { 436 24 }

						hbox = {
							margin = { 8 0 }
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding

							textbox = {
								size = { 180 22 }
								layoutpolicy_horizontal = fixed
								text = "[concept_interest_group]"
								align = left|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
							textbox = {
								size = { 56 22 }
								layoutpolicy_horizontal = fixed
								text = "ipg_seats_col"
								default_format = "#title"
								align = right|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
							textbox = {
								size = { 66 22 }
								layoutpolicy_horizontal = fixed
								text = "[concept_clout]"
								align = right|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
							textbox = {
								size = { 118 22 }
								layoutpolicy_horizontal = fixed
								text = "[concept_approval]"
								align = right|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
						}

						divider_clean = {
							parentanchor = bottom|hcenter
							size = { 436 2 }
						}
					}

					# Government group
					flowcontainer = {
						visible = "[Not(IsDataModelEmpty(Country.MakeScope.GetList('ipg_power_gov_igs')))]"
						direction = vertical
						spacing = 0

						ipg_tooltip_group_header = {
							blockoverride "group_icon" {
								texture = "gfx/interface/icons/generic_icons/in_government_icon.dds"
							}
							blockoverride "group_label" {
								text = "concept_in_government"
								default_format = "#P"
							}
							blockoverride "group_total" {
								text = "ipg_power_gov_sub"
							}
						}

						flowcontainer = {
							direction = vertical
							datamodel = "[Country.MakeScope.GetList('ipg_power_gov_igs')]"
							item = { ipg_tooltip_power_row = {} }
						}
					}

					# Opposition group
					flowcontainer = {
						visible = "[Not(IsDataModelEmpty(Country.MakeScope.GetList('ipg_power_opp_igs')))]"
						direction = vertical
						margin_top = 4
						spacing = 0

						ipg_tooltip_group_header = {
							blockoverride "group_icon" {
								texture = "gfx/interface/icons/generic_icons/in_opposition_icon.dds"
							}
							blockoverride "group_label" {
								text = "concept_in_opposition"
								default_format = "#N"
							}
							blockoverride "group_total" {
								text = "ipg_power_opp_sub"
							}
						}

						flowcontainer = {
							direction = vertical
							datamodel = "[Country.MakeScope.GetList('ipg_power_opp_igs')]"
							item = { ipg_tooltip_power_row = {} }
						}
					}
				}
			}
		}
	}

	# =========================================================================
	# 2. Political Alignment Tooltip
	# =========================================================================
	type ipg_tooltip_alignment_dynamic = FancyTooltipWidgetType {
		blockoverride "icon_texture" {
			texture = "gfx/interface/main_hud/pops_btn.dds"
		}
		blockoverride "icon_size" {
			size = { 42 42 }
		}
		blockoverride "color" {
			color = { 0.32 0.48 0.58 1 }
		}
		blockoverride "name" {
			text = "ipg_tooltip_alignment_title"
		}
		blockoverride "type" {
			text = "ipg_total_seats_header"
		}
		blockoverride "text" {
			visible = no
		}
		blockoverride "tooltip_content_after" {
			flowcontainer = {
				direction = vertical
				spacing = 8

				# 3-way KPI: In Government | Politically Unaligned | In Opposition
				flowcontainer = {
					direction = vertical
					spacing = 5

					widget = {
						size = { 436 24 }

						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							margin = { 2 0 }

							flowcontainer = {
								spacing = 4
								icon = {
									size = { 18 18 }
									parentanchor = vcenter
									texture = "gfx/interface/icons/generic_icons/in_government_icon.dds"
								}
								textbox = {
									autoresize = yes
									parentanchor = vcenter
									text = "ipg_alignment_gov_kpi"
									align = left|nobaseline
									using = fontsize_small
									fonttintcolor = "[TooltipInfo.GetTintColor]"
								}
							}

							widget = { size = { 0 1 } layoutpolicy_horizontal = expanding }

							flowcontainer = {
								visible = "[GreaterThan_CFixedPoint(Country.MakeScope.Var('ipg_alignment_unaligned_seats').GetValue, '(CFixedPoint)0')]"
								spacing = 4
								alpha = 0.8
								icon = {
									size = { 18 18 }
									parentanchor = vcenter
									texture = "gfx/interface/icons/ig_icons/politically_unaligned.dds"
								}
								textbox = {
									autoresize = yes
									parentanchor = vcenter
									text = "ipg_alignment_unaligned_kpi"
									align = hcenter|nobaseline
									using = fontsize_small
									fonttintcolor = "[TooltipInfo.GetTintColor]"
								}
							}

							widget = { size = { 0 1 } layoutpolicy_horizontal = expanding }

							flowcontainer = {
								spacing = 4
								textbox = {
									autoresize = yes
									parentanchor = vcenter
									text = "ipg_alignment_opp_kpi"
									align = right|nobaseline
									using = fontsize_small
									fonttintcolor = "[TooltipInfo.GetTintColor]"
								}
								icon = {
									size = { 18 18 }
									parentanchor = vcenter
									texture = "gfx/interface/icons/generic_icons/in_opposition_icon.dds"
								}
							}
						}
					}

					# Multi-color alignment bar (Gov | Opp | Unaligned grey)
					widget = {
						size = { 436 14 }

						background = {
							using = dark_area
							alpha = 0.75
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							margin = { 2 2 }

							hbox = {
								visible = "[GreaterThan_CFixedPoint(Country.MakeScope.Var('ipg_alignment_gov_seats').GetValue, '(CFixedPoint)0')]"
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								layoutstretchfactor_horizontal = "[FixedPointToInt(Country.MakeScope.Var('ipg_alignment_gov_seats').GetValue)]"
								datamodel = "[Country.MakeScope.GetList('ipg_alignment_gov_igs')]"

								item = {
									hbox = {
										datacontext = "[Scope.GetInterestGroup]"
										visible = "[GreaterThan_CFixedPoint(InterestGroup.MakeScope.Var('alignment_seats').GetValue, '(CFixedPoint)0')]"
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding
										layoutstretchfactor_horizontal = "[FixedPointToInt(InterestGroup.MakeScope.Var('alignment_seats').GetValue)]"

										background = {
											texture = "gfx/interface/tooltip/stacked_barchart_small_item.dds"
											color = "[InterestGroup.GetColor]"
											spriteType = Corneredstretched
											spriteborder = { 2 2 }
										}
									}
								}
							}

							hbox = {
								visible = "[GreaterThan_CFixedPoint(Country.MakeScope.Var('ipg_alignment_opp_seats').GetValue, '(CFixedPoint)0')]"
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								layoutstretchfactor_horizontal = "[FixedPointToInt(Country.MakeScope.Var('ipg_alignment_opp_seats').GetValue)]"
								datamodel = "[Country.MakeScope.GetList('ipg_alignment_opp_igs')]"

								item = {
									hbox = {
										datacontext = "[Scope.GetInterestGroup]"
										visible = "[GreaterThan_CFixedPoint(InterestGroup.MakeScope.Var('alignment_seats').GetValue, '(CFixedPoint)0')]"
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding
										layoutstretchfactor_horizontal = "[FixedPointToInt(InterestGroup.MakeScope.Var('alignment_seats').GetValue)]"

										background = {
											texture = "gfx/interface/tooltip/stacked_barchart_small_item.dds"
											color = "[InterestGroup.GetColor]"
											alpha = 0.72
											spriteType = Corneredstretched
											spriteborder = { 2 2 }
										}
									}
								}
							}

							# Politically unaligned grey segment
							hbox = {
								visible = "[GreaterThan_CFixedPoint(Country.MakeScope.Var('ipg_alignment_unaligned_seats').GetValue, '(CFixedPoint)0')]"
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								layoutstretchfactor_horizontal = "[FixedPointToInt(Country.MakeScope.Var('ipg_alignment_unaligned_seats').GetValue)]"

								background = {
									texture = "gfx/interface/tooltip/stacked_barchart_small_item.dds"
									color = { 0.48 0.48 0.50 0.68 }
									spriteType = Corneredstretched
									spriteborder = { 2 2 }
								}
							}
						}

						icon = {
							size = { 100% 100% }
							texture = "gfx/interface/progressbar/progressbar_frame.dds"
							spriteType = Corneredstretched
							spriteborder = { 6 6 }
							texture_density = 2
						}
					}

					# Active seat apportionment formula caption
					widget = {
						size = { 436 18 }
						alpha = 0.78

						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							margin = { 4 0 }
							spacing = 6

							textbox = {
								autoresize = yes
								text = "ipg_formula_current_label"
								default_format = "#title"
								align = left|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
							widget = { size = { 0 1 } layoutpolicy_horizontal = expanding }
							textbox = {
								visible = "[Or(Not(Country.MakeScope.Var('ipg_active_formula').IsSet), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_active_formula').GetValue, '(CFixedPoint)1'))]"
								autoresize = yes
								text = "ipg_formula_1"
								align = right|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
							textbox = {
								visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_active_formula').GetValue, '(CFixedPoint)2')]"
								autoresize = yes
								text = "ipg_formula_2"
								align = right|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
							textbox = {
								visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_active_formula').GetValue, '(CFixedPoint)3')]"
								autoresize = yes
								text = "ipg_formula_3"
								align = right|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
							textbox = {
								visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_active_formula').GetValue, '(CFixedPoint)4')]"
								autoresize = yes
								text = "ipg_formula_4"
								align = right|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
							textbox = {
								visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_active_formula').GetValue, '(CFixedPoint)5')]"
								autoresize = yes
								text = "ipg_formula_5"
								align = right|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
						}
					}
				}

				# Grouped table
				flowcontainer = {
					direction = vertical
					spacing = 2

					widget = {
						size = { 436 24 }

						hbox = {
							margin = { 8 0 }
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding

							textbox = {
								size = { 190 22 }
								layoutpolicy_horizontal = fixed
								text = "[concept_interest_group]"
								align = left|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
							textbox = {
								size = { 60 22 }
								layoutpolicy_horizontal = fixed
								text = "ipg_seats_col"
								default_format = "#title"
								align = right|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
							textbox = {
								size = { 70 22 }
								layoutpolicy_horizontal = fixed
								text = "ipg_share_col"
								default_format = "#title"
								align = right|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
							textbox = {
								size = { 100 22 }
								layoutpolicy_horizontal = fixed
								text = "[concept_population]"
								align = right|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
						}

						divider_clean = {
							parentanchor = bottom|hcenter
							size = { 436 2 }
						}
					}

					# Government group
					flowcontainer = {
						visible = "[Not(IsDataModelEmpty(Country.MakeScope.GetList('ipg_alignment_gov_igs')))]"
						direction = vertical
						spacing = 0

						ipg_tooltip_group_header = {
							blockoverride "group_icon" {
								texture = "gfx/interface/icons/generic_icons/in_government_icon.dds"
							}
							blockoverride "group_label" {
								text = "concept_in_government"
								default_format = "#P"
							}
							blockoverride "group_total" {
								text = "ipg_alignment_gov_sub"
							}
						}

						flowcontainer = {
							direction = vertical
							datamodel = "[Country.MakeScope.GetList('ipg_alignment_gov_igs')]"
							item = { ipg_tooltip_alignment_row = {} }
						}
					}

					# Opposition group
					flowcontainer = {
						visible = "[Not(IsDataModelEmpty(Country.MakeScope.GetList('ipg_alignment_opp_igs')))]"
						direction = vertical
						margin_top = 4
						spacing = 0

						ipg_tooltip_group_header = {
							blockoverride "group_icon" {
								texture = "gfx/interface/icons/generic_icons/in_opposition_icon.dds"
							}
							blockoverride "group_label" {
								text = "concept_in_opposition"
								default_format = "#N"
							}
							blockoverride "group_total" {
								text = "ipg_alignment_opp_sub"
							}
						}

						flowcontainer = {
							direction = vertical
							datamodel = "[Country.MakeScope.GetList('ipg_alignment_opp_igs')]"
							item = { ipg_tooltip_alignment_row = {} }
						}
					}

					# Politically Unaligned footer row
					flowcontainer = {
						visible = "[GreaterThan_CFixedPoint(Country.MakeScope.Var('ipg_alignment_unaligned_seats').GetValue, '(CFixedPoint)0')]"
						direction = vertical
						margin_top = 4
						spacing = 2

						divider_clean = {
							size = { 436 2 }
						}

						widget = {
							size = { 436 26 }
							alpha = 0.82

							hbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								margin = { 8 0 }

								widget = {
									size = { 190 26 }
									layoutpolicy_horizontal = fixed

									hbox = {
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding
										spacing = 5

										icon = {
											size = { 8 8 }
											texture = "gfx/interface/icons/ipg_white_circle.dds"
											tintcolor = { 0.55 0.55 0.58 1 }
										}
										icon = {
											size = { 20 20 }
											texture = "gfx/interface/icons/ig_icons/politically_unaligned.dds"
										}
										textbox = {
											layoutpolicy_horizontal = expanding
											layoutpolicy_vertical = expanding
											text = "ipg_unaligned"
											align = left|nobaseline
											elide = right
											fontsize_min = 12
											fonttintcolor = "[TooltipInfo.GetTintColor]"
										}
									}
								}

								textbox = {
									size = { 60 26 }
									layoutpolicy_horizontal = fixed
									text = "ipg_unaligned_seats_cell"
									align = right|nobaseline
									fonttintcolor = "[TooltipInfo.GetTintColor]"
								}

								textbox = {
									size = { 70 26 }
									layoutpolicy_horizontal = fixed
									text = "ipg_unaligned_share_cell"
									align = right|nobaseline
									fonttintcolor = "[TooltipInfo.GetTintColor]"
								}

								textbox = {
									size = { 100 26 }
									layoutpolicy_horizontal = fixed
									raw_text = "—"
									align = right|nobaseline
									alpha = 0.5
									fonttintcolor = "[TooltipInfo.GetTintColor]"
								}
							}
						}
					}
				}
			}
		}
	}

	# =========================================================================
	# 3. Party Structure (Electoral) Tooltip
	# =========================================================================
	type ipg_tooltip_electoral_dynamic = FancyTooltipWidgetType {
		blockoverride "icon_texture" {
			texture = "gfx/interface/icons/event_icons/event_election.dds"
		}
		blockoverride "icon_size" {
			size = { 44 44 }
		}
		blockoverride "color" {
			color = { 0.58 0.42 0.30 1 }
		}
		blockoverride "name" {
			text = "ipg_tooltip_electoral_title"
		}
		blockoverride "type" {
			text = "ipg_total_seats_header"
		}
		blockoverride "text" {
			visible = no
		}
		blockoverride "tooltip_content_after" {
			flowcontainer = {
				direction = vertical
				spacing = 8

				# Empty state before first election
				textbox = {
					visible = "[IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties'))]"
					max_width = 436
					autoresize = yes
					multiline = yes
					text = "ipg_no_election_yet"
					alpha = 0.85
					fonttintcolor = "[TooltipInfo.GetTintColor]"
				}

				# Populated electoral parliament breakdown
				flowcontainer = {
					visible = "[Not(IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties')))]"
					direction = vertical
					spacing = 8

					# Hero KPI with genuine Majority / Minority judgment + 50% threshold bar
					flowcontainer = {
						direction = vertical
						spacing = 5

						widget = {
							size = { 436 24 }

							hbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								margin = { 2 0 }

								flowcontainer = {
									spacing = 5
									icon = {
										size = { 20 20 }
										parentanchor = vcenter
										texture = "gfx/interface/icons/generic_icons/in_government_icon.dds"
									}
									textbox = {
										autoresize = yes
										parentanchor = vcenter
										text = "ipg_electoral_gov_kpi"
										align = left|nobaseline
										fonttintcolor = "[TooltipInfo.GetTintColor]"
									}
								}

								textbox = {
									layoutpolicy_horizontal = expanding
									autoresize = yes
									text = "[SelectLocalization(GreaterThanOrEqualTo_CFixedPoint(Country.MakeScope.Var('ipg_electoral_gov_seats').GetValue, Country.MakeScope.Var('ipg_majority_threshold').GetValue), 'ipg_majority_tag', 'ipg_minority_tag')]"
									align = hcenter|nobaseline
									using = fontsize_small
									fonttintcolor = "[TooltipInfo.GetTintColor]"
								}

								flowcontainer = {
									spacing = 5
									textbox = {
										autoresize = yes
										parentanchor = vcenter
										text = "ipg_electoral_opp_kpi"
										align = right|nobaseline
										fonttintcolor = "[TooltipInfo.GetTintColor]"
									}
									icon = {
										size = { 20 20 }
										parentanchor = vcenter
										texture = "gfx/interface/icons/generic_icons/in_opposition_icon.dds"
									}
								}
							}
						}

						# Multi-color party seat bar with 50% majority marker
						widget = {
							size = { 436 16 }

							background = {
								using = dark_area
								alpha = 0.75
							}

							hbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								margin = { 2 3 }

								hbox = {
									visible = "[GreaterThan_CFixedPoint(Country.MakeScope.Var('ipg_electoral_gov_seats').GetValue, '(CFixedPoint)0')]"
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding
									layoutstretchfactor_horizontal = "[FixedPointToInt(Country.MakeScope.Var('ipg_electoral_gov_seats').GetValue)]"
									datamodel = "[Country.MakeScope.GetList('ipg_electoral_gov_parties')]"

									item = {
										hbox = {
											datacontext = "[Scope.GetParty]"
											visible = "[GreaterThan_CFixedPoint(Party.MakeScope.Var('electoral_seats').GetValue, '(CFixedPoint)0')]"
											layoutpolicy_horizontal = expanding
											layoutpolicy_vertical = expanding
											layoutstretchfactor_horizontal = "[FixedPointToInt(Party.MakeScope.Var('electoral_seats').GetValue)]"

											background = {
												texture = "gfx/interface/tooltip/stacked_barchart_small_item.dds"
												color = "[Party.GetColor]"
												spriteType = Corneredstretched
												spriteborder = { 2 2 }
											}
										}
									}
								}

								hbox = {
									visible = "[GreaterThan_CFixedPoint(Country.MakeScope.Var('ipg_electoral_opp_seats').GetValue, '(CFixedPoint)0')]"
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding
									layoutstretchfactor_horizontal = "[FixedPointToInt(Country.MakeScope.Var('ipg_electoral_opp_seats').GetValue)]"
									datamodel = "[Country.MakeScope.GetList('ipg_electoral_opp_parties')]"

									item = {
										hbox = {
											datacontext = "[Scope.GetParty]"
											visible = "[GreaterThan_CFixedPoint(Party.MakeScope.Var('electoral_seats').GetValue, '(CFixedPoint)0')]"
											layoutpolicy_horizontal = expanding
											layoutpolicy_vertical = expanding
											layoutstretchfactor_horizontal = "[FixedPointToInt(Party.MakeScope.Var('electoral_seats').GetValue)]"

											background = {
												texture = "gfx/interface/tooltip/stacked_barchart_small_item.dds"
												color = "[Party.GetColor]"
												alpha = 0.72
												spriteType = Corneredstretched
												spriteborder = { 2 2 }
											}
										}
									}
								}
							}

							icon = {
								size = { 436 14 }
								parentanchor = center
								texture = "gfx/interface/progressbar/progressbar_frame.dds"
								spriteType = Corneredstretched
								spriteborder = { 6 6 }
								texture_density = 2
							}

							# 50% parliamentary majority threshold needle
							icon = {
								parentanchor = hcenter|vcenter
								size = { 2 18 }
								texture = "gfx/interface/tooltip/stacked_barchart_small_item.dds"
								color = { 0.98 0.94 0.82 0.95 }
							}
						}

						# Active seat apportionment formula caption
						widget = {
							size = { 436 18 }
							alpha = 0.78

							hbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								margin = { 4 0 }
								spacing = 6

								textbox = {
									autoresize = yes
									text = "ipg_formula_current_label"
									default_format = "#title"
									align = left|nobaseline
									using = fontsize_small
									fonttintcolor = "[TooltipInfo.GetTintColor]"
								}
								widget = { size = { 0 1 } layoutpolicy_horizontal = expanding }
								textbox = {
									visible = "[Or(Not(Country.MakeScope.Var('ipg_active_formula').IsSet), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_active_formula').GetValue, '(CFixedPoint)1'))]"
									autoresize = yes
									text = "ipg_formula_1"
									align = right|nobaseline
									using = fontsize_small
									fonttintcolor = "[TooltipInfo.GetTintColor]"
								}
								textbox = {
									visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_active_formula').GetValue, '(CFixedPoint)2')]"
									autoresize = yes
									text = "ipg_formula_2"
									align = right|nobaseline
									using = fontsize_small
									fonttintcolor = "[TooltipInfo.GetTintColor]"
								}
								textbox = {
									visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_active_formula').GetValue, '(CFixedPoint)3')]"
									autoresize = yes
									text = "ipg_formula_3"
									align = right|nobaseline
									using = fontsize_small
									fonttintcolor = "[TooltipInfo.GetTintColor]"
								}
								textbox = {
									visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_active_formula').GetValue, '(CFixedPoint)4')]"
									autoresize = yes
									text = "ipg_formula_4"
									align = right|nobaseline
									using = fontsize_small
									fonttintcolor = "[TooltipInfo.GetTintColor]"
								}
								textbox = {
									visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_active_formula').GetValue, '(CFixedPoint)5')]"
									autoresize = yes
									text = "ipg_formula_5"
									align = right|nobaseline
									using = fontsize_small
									fonttintcolor = "[TooltipInfo.GetTintColor]"
								}
							}
						}
					}

					# Grouped party table
					flowcontainer = {
						direction = vertical
						spacing = 2

						widget = {
							size = { 436 24 }

							hbox = {
								margin = { 8 0 }
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding

								textbox = {
									size = { 186 22 }
									layoutpolicy_horizontal = fixed
									text = "[concept_party]"
									align = left|nobaseline
									using = fontsize_small
									fonttintcolor = "[TooltipInfo.GetTintColor]"
								}
								textbox = {
									size = { 56 22 }
									layoutpolicy_horizontal = fixed
