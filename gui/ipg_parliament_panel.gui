								item = { ipg_tooltip_electoral_row = {} }
							}
						}
					}
				}
			}
		}
	}

	# =========================================================================
	# 4. Bicameral Dual-Chamber Tooltip
	# =========================================================================
	type ipg_tooltip_bicameral_dynamic = FancyTooltipWidgetType {
		blockoverride "icon_texture" {
			texture = "gfx/interface/icons/law_icons/parliamentary_republic.dds"
		}
		blockoverride "icon_size" {
			size = { 44 44 }
		}
		blockoverride "color" {
			color = { 0.52 0.34 0.40 1 }
		}
		blockoverride "name" {
			text = "ipg_layout_bicameral"
		}
		blockoverride "type" {
			text = "ipg_total_seats_header"
		}
		blockoverride "text" {
			visible = no
		}
		blockoverride "tooltip_content_after" {
			flowcontainer = {
				direction = vertical
				spacing = 6

				# --- Upper House (Power Structure) ---
				flowcontainer = {
					direction = vertical
					spacing = 3

					widget = {
						size = { 436 22 }

						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							margin = { 4 0 }

							textbox = {
								layoutpolicy_horizontal = expanding
								autoresize = yes
								text = "ipg_bicameral_upper"
								default_format = "#title"
								align = left|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
							textbox = {
								autoresize = yes
								text = "ipg_bicameral_power_compact"
								align = right|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
						}
					}

					# Upper house compact stacked bar
					widget = {
						size = { 436 10 }
						background = { using = dark_area alpha = 0.75 }
						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							margin = { 2 2 }
							datamodel = "[Country.MakeScope.GetList('ipg_power_igs')]"
							item = {
								hbox = {
									datacontext = "[Scope.GetInterestGroup]"
									visible = "[GreaterThan_CFixedPoint(InterestGroup.MakeScope.Var('power_seats').GetValue, '(CFixedPoint)0')]"
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding
									layoutstretchfactor_horizontal = "[FixedPointToInt(InterestGroup.MakeScope.Var('power_seats').GetValue)]"
									background = {
										texture = "gfx/interface/tooltip/stacked_barchart_small_item.dds"
										color = "[InterestGroup.GetColor]"
										spriteType = Corneredstretched
										spriteborder = { 2 2 }
									}
								}
							}
						}
						icon = {
							size = { 100% 100% }
							texture = "gfx/interface/progressbar/progressbar_frame.dds"
							spriteType = Corneredstretched
							spriteborder = { 6 6 }
							texture_density = 2
						}
					}

					flowcontainer = {
						direction = vertical
						datamodel = "[Country.MakeScope.GetList('ipg_power_igs')]"
						item = { ipg_tooltip_bicameral_ig_row = {} }
					}
				}

				divider_clean = {
					size = { 436 2 }
				}

				# --- Lower House (Electoral when available) ---
				flowcontainer = {
					visible = "[And(Not(IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties'))), Not(GetVariableSystem.HasValue('ipg_parl_view', 'alignment')))]"
					direction = vertical
					spacing = 3

					widget = {
						size = { 436 22 }

						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							margin = { 4 0 }

							textbox = {
								layoutpolicy_horizontal = expanding
								autoresize = yes
								text = "ipg_bicameral_lower_electoral"
								default_format = "#title"
								align = left|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
							textbox = {
								autoresize = yes
								text = "ipg_bicameral_electoral_compact"
								align = right|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
						}
					}

					widget = {
						size = { 436 12 }
						background = { using = dark_area alpha = 0.75 }
						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							margin = { 2 3 }
							datamodel = "[Country.MakeScope.GetList('ipg_electoral_parties')]"
							item = {
								hbox = {
									datacontext = "[Scope.GetParty]"
									visible = "[GreaterThan_CFixedPoint(Party.MakeScope.Var('electoral_seats').GetValue, '(CFixedPoint)0')]"
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding
									layoutstretchfactor_horizontal = "[FixedPointToInt(Party.MakeScope.Var('electoral_seats').GetValue)]"
									background = {
										texture = "gfx/interface/tooltip/stacked_barchart_small_item.dds"
										color = "[Party.GetColor]"
										spriteType = Corneredstretched
										spriteborder = { 2 2 }
									}
								}
							}
						}
						icon = {
							size = { 436 10 }
							parentanchor = center
							texture = "gfx/interface/progressbar/progressbar_frame.dds"
							spriteType = Corneredstretched
							spriteborder = { 6 6 }
							texture_density = 2
						}
						icon = {
							parentanchor = hcenter|vcenter
							size = { 2 14 }
							texture = "gfx/interface/tooltip/stacked_barchart_small_item.dds"
							color = { 0.98 0.94 0.82 0.95 }
						}
					}

					flowcontainer = {
						direction = vertical
						datamodel = "[Country.MakeScope.GetList('ipg_electoral_parties')]"
						item = { ipg_tooltip_bicameral_party_row = {} }
					}
				}

				# --- Lower House (Alignment fallback / selected) ---
				flowcontainer = {
					visible = "[Or(IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties')), GetVariableSystem.HasValue('ipg_parl_view', 'alignment'))]"
					direction = vertical
					spacing = 3

					widget = {
						size = { 436 22 }

						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							margin = { 4 0 }

							textbox = {
								layoutpolicy_horizontal = expanding
								autoresize = yes
								text = "ipg_bicameral_lower_alignment"
								default_format = "#title"
								align = left|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
							textbox = {
								autoresize = yes
								text = "ipg_bicameral_alignment_compact"
								align = right|nobaseline
								using = fontsize_small
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
						}
					}

					widget = {
						size = { 436 10 }
						background = { using = dark_area alpha = 0.75 }
						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							margin = { 2 2 }

							hbox = {
								visible = "[GreaterThan_CFixedPoint(Country.MakeScope.Var('ipg_alignment_gov_seats').GetValue, '(CFixedPoint)0')]"
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								layoutstretchfactor_horizontal = "[FixedPointToInt(Country.MakeScope.Var('ipg_alignment_gov_seats').GetValue)]"
								datamodel = "[Country.MakeScope.GetList('ipg_alignment_gov_igs')]"
								item = {
									hbox = {
										datacontext = "[Scope.GetInterestGroup]"
										visible = "[GreaterThan_CFixedPoint(InterestGroup.MakeScope.Var('alignment_seats').GetValue, '(CFixedPoint)0')]"
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding
										layoutstretchfactor_horizontal = "[FixedPointToInt(InterestGroup.MakeScope.Var('alignment_seats').GetValue)]"
										background = {
											texture = "gfx/interface/tooltip/stacked_barchart_small_item.dds"
											color = "[InterestGroup.GetColor]"
											spriteType = Corneredstretched
											spriteborder = { 2 2 }
										}
									}
								}
							}
							hbox = {
								visible = "[GreaterThan_CFixedPoint(Country.MakeScope.Var('ipg_alignment_opp_seats').GetValue, '(CFixedPoint)0')]"
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								layoutstretchfactor_horizontal = "[FixedPointToInt(Country.MakeScope.Var('ipg_alignment_opp_seats').GetValue)]"
								datamodel = "[Country.MakeScope.GetList('ipg_alignment_opp_igs')]"
								item = {
									hbox = {
										datacontext = "[Scope.GetInterestGroup]"
										visible = "[GreaterThan_CFixedPoint(InterestGroup.MakeScope.Var('alignment_seats').GetValue, '(CFixedPoint)0')]"
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding
										layoutstretchfactor_horizontal = "[FixedPointToInt(InterestGroup.MakeScope.Var('alignment_seats').GetValue)]"
										background = {
											texture = "gfx/interface/tooltip/stacked_barchart_small_item.dds"
											color = "[InterestGroup.GetColor]"
											alpha = 0.72
											spriteType = Corneredstretched
											spriteborder = { 2 2 }
										}
									}
								}
							}
							hbox = {
								visible = "[GreaterThan_CFixedPoint(Country.MakeScope.Var('ipg_alignment_unaligned_seats').GetValue, '(CFixedPoint)0')]"
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								layoutstretchfactor_horizontal = "[FixedPointToInt(Country.MakeScope.Var('ipg_alignment_unaligned_seats').GetValue)]"
								background = {
									texture = "gfx/interface/tooltip/stacked_barchart_small_item.dds"
									color = { 0.48 0.48 0.50 0.68 }
									spriteType = Corneredstretched
									spriteborder = { 2 2 }
								}
							}
						}
						icon = {
							size = { 100% 100% }
							texture = "gfx/interface/progressbar/progressbar_frame.dds"
							spriteType = Corneredstretched
							spriteborder = { 6 6 }
							texture_density = 2
						}
					}

					flowcontainer = {
						direction = vertical
						datamodel = "[Country.MakeScope.GetList('ipg_alignment_igs')]"
						item = {
							ipg_tooltip_bicameral_ig_row = {
								blockoverride "bi_seats_text" { text = "ipg_alignment_seats_cell" }
								blockoverride "bi_share_text" { text = "ipg_alignment_share_cell" }
							}
						}
					}
				}
			}
		}
	}

	# =========================================================================
	# 5. Bottom-Right Layout Selector Status Tooltip (Current Layout + Why)
	# =========================================================================
	type ipg_tooltip_layout_status = FancyTooltipWidgetType {
		blockoverride "icon_texture" {
			texture = "gfx/interface/icons/law_icons/parliamentary_republic.dds"
		}
		blockoverride "icon_size" {
			size = { 44 44 }
		}
		blockoverride "color" {
			color = { 0.44 0.40 0.56 1 }
		}
		blockoverride "name" {
			text = "ipg_layout_menu_title"
		}
		blockoverride "type" {
			text = "[SelectLocalization(GetVariableSystem.Exists('ipg_layout_mode'), 'ipg_mode_manual_badge', 'ipg_mode_auto_badge')]"
		}
		blockoverride "text" {
			visible = no
		}
		blockoverride "tooltip_content_after" {
			flowcontainer = {
				direction = vertical
				spacing = 8

				# Active chamber banner
				widget = {
					size = { 392 30 }

					background = {
						using = dark_area
						alpha = 0.55
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						margin = { 10 0 }
						spacing = 8

						textbox = {
							autoresize = yes
							text = "ipg_layout_current_label"
							default_format = "#title"
							align = left|nobaseline
							using = fontsize_small
							fonttintcolor = "[TooltipInfo.GetTintColor]"
						}

						widget = { size = { 0 1 } layoutpolicy_horizontal = expanding }

						# Active structure name (resolves both manual & auto)
						textbox = {
							visible = "[Or(GetVariableSystem.HasValue('ipg_layout_mode', 'hemicycle'), And(Not(GetVariableSystem.Exists('ipg_layout_mode')), Or(Not(Country.MakeScope.Var('ipg_auto_layout').IsSet), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_layout').GetValue, '(CFixedPoint)1'))))]"
							autoresize = yes
							text = "ipg_layout_hemicycle"
							default_format = "#v"
							align = right|nobaseline
							fonttintcolor = "[TooltipInfo.GetTintColor]"
						}
						textbox = {
							visible = "[Or(GetVariableSystem.HasValue('ipg_layout_mode', 'westminster'), And(Not(GetVariableSystem.Exists('ipg_layout_mode')), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_layout').GetValue, '(CFixedPoint)2')))]"
							autoresize = yes
							text = "ipg_layout_westminster"
							default_format = "#v"
							align = right|nobaseline
							fonttintcolor = "[TooltipInfo.GetTintColor]"
						}
						textbox = {
							visible = "[Or(GetVariableSystem.HasValue('ipg_layout_mode', 'horseshoe'), And(Not(GetVariableSystem.Exists('ipg_layout_mode')), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_layout').GetValue, '(CFixedPoint)3')))]"
							autoresize = yes
							text = "ipg_layout_horseshoe"
							default_format = "#v"
							align = right|nobaseline
							fonttintcolor = "[TooltipInfo.GetTintColor]"
						}
						textbox = {
							visible = "[Or(GetVariableSystem.HasValue('ipg_layout_mode', 'assembly'), And(Not(GetVariableSystem.Exists('ipg_layout_mode')), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_layout').GetValue, '(CFixedPoint)4')))]"
							autoresize = yes
							text = "ipg_layout_assembly"
							default_format = "#v"
							align = right|nobaseline
							fonttintcolor = "[TooltipInfo.GetTintColor]"
						}
						textbox = {
							visible = "[Or(GetVariableSystem.HasValue('ipg_layout_mode', 'bicameral'), And(Not(GetVariableSystem.Exists('ipg_layout_mode')), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_layout').GetValue, '(CFixedPoint)5')))]"
							autoresize = yes
							text = "ipg_layout_bicameral"
							default_format = "#v"
							align = right|nobaseline
							fonttintcolor = "[TooltipInfo.GetTintColor]"
						}
					}
				}

				# Reason explanation card
				flowcontainer = {
					direction = vertical
					spacing = 4
					margin = { 10 8 }

					background = {
						using = dark_area
						alpha = 0.35
					}

					textbox = {
						max_width = 372
						min_width = 372
						autoresize = yes
						text = "ipg_layout_reason_label"
						default_format = "#title"
						align = left|nobaseline
						using = fontsize_small
						fonttintcolor = "[TooltipInfo.GetTintColor]"
					}

					divider_clean = {
						size = { 372 2 }
					}

					# Manual override explanation
					textbox = {
						visible = "[GetVariableSystem.Exists('ipg_layout_mode')]"
						max_width = 372
						min_width = 372
						autoresize = yes
						multiline = yes
						text = "ipg_layout_reason_manual"
						align = left|nobaseline
						fonttintcolor = "[TooltipInfo.GetTintColor]"
					}

					# Auto reason 1..7
					textbox = {
						visible = "[And(Not(GetVariableSystem.Exists('ipg_layout_mode')), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_reason').GetValue, '(CFixedPoint)1'))]"
						max_width = 372
						min_width = 372
						autoresize = yes
						multiline = yes
						text = "ipg_layout_reason_1"
						align = left|nobaseline
						fonttintcolor = "[TooltipInfo.GetTintColor]"
					}
					textbox = {
						visible = "[And(Not(GetVariableSystem.Exists('ipg_layout_mode')), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_reason').GetValue, '(CFixedPoint)2'))]"
						max_width = 372
						min_width = 372
						autoresize = yes
						multiline = yes
						text = "ipg_layout_reason_2"
						align = left|nobaseline
						fonttintcolor = "[TooltipInfo.GetTintColor]"
					}
					textbox = {
						visible = "[And(Not(GetVariableSystem.Exists('ipg_layout_mode')), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_reason').GetValue, '(CFixedPoint)3'))]"
						max_width = 372
						min_width = 372
						autoresize = yes
						multiline = yes
						text = "ipg_layout_reason_3"
						align = left|nobaseline
						fonttintcolor = "[TooltipInfo.GetTintColor]"
					}
					textbox = {
						visible = "[And(Not(GetVariableSystem.Exists('ipg_layout_mode')), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_reason').GetValue, '(CFixedPoint)4'))]"
						max_width = 372
						min_width = 372
						autoresize = yes
						multiline = yes
						text = "ipg_layout_reason_4"
						align = left|nobaseline
						fonttintcolor = "[TooltipInfo.GetTintColor]"
					}
					textbox = {
						visible = "[And(Not(GetVariableSystem.Exists('ipg_layout_mode')), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_reason').GetValue, '(CFixedPoint)5'))]"
						max_width = 372
						min_width = 372
						autoresize = yes
						multiline = yes
						text = "ipg_layout_reason_5"
						align = left|nobaseline
						fonttintcolor = "[TooltipInfo.GetTintColor]"
					}
					textbox = {
						visible = "[And(Not(GetVariableSystem.Exists('ipg_layout_mode')), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_reason').GetValue, '(CFixedPoint)6'))]"
						max_width = 372
						min_width = 372
						autoresize = yes
						multiline = yes
						text = "ipg_layout_reason_6"
						align = left|nobaseline
						fonttintcolor = "[TooltipInfo.GetTintColor]"
					}
					textbox = {
						visible = "[And(Not(GetVariableSystem.Exists('ipg_layout_mode')), Or(Not(Country.MakeScope.Var('ipg_auto_reason').IsSet), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_reason').GetValue, '(CFixedPoint)7')))]"
						max_width = 372
						min_width = 372
						autoresize = yes
						multiline = yes
						text = "ipg_layout_reason_7"
						align = left|nobaseline
						fonttintcolor = "[TooltipInfo.GetTintColor]"
					}
				}

				# Click hint
				textbox = {
					max_width = 392
					autoresize = yes
					text = "ipg_layout_click_hint"
					align = left|nobaseline
					using = fontsize_small
					alpha = 0.85
					fonttintcolor = "[TooltipInfo.GetTintColor]"
				}
			}
		}
	}

	# =========================================================================
	# 6. Reusable Layout Option Tooltip Base & 6 Popup Option Tooltips
	# =========================================================================
	type ipg_tooltip_layout_option_base = FancyTooltipWidgetType {
		blockoverride "icon_size" {
			size = { 42 42 }
		}
		blockoverride "text" {
			visible = no
		}
		blockoverride "tooltip_content_after" {
			flowcontainer = {
				direction = vertical
				spacing = 8

				textbox = {
					max_width = 384
					min_width = 384
					autoresize = yes
					multiline = yes
					align = left|nobaseline
					fonttintcolor = "[TooltipInfo.GetTintColor]"
					block "opt_desc" {}
				}

				flowcontainer = {
					direction = vertical
					spacing = 4
					margin = { 10 8 }

					background = {
						using = dark_area
						alpha = 0.42
					}

					textbox = {
						max_width = 364
						min_width = 364
						autoresize = yes
						text = "ipg_layout_cond_label"
						default_format = "#title"
						align = left|nobaseline
						using = fontsize_small
						fonttintcolor = "[TooltipInfo.GetTintColor]"
					}

					divider_clean = {
