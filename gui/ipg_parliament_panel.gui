	type ipg_canvas_electoral = widget {
		size = { 600 230 }

		# Friendly empty-state message when no election has occurred yet
		textbox = {
			visible = "[IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties'))]"
			parentanchor = center
			size = { 460 60 }
			multiline = yes
			align = center|nobaseline
			text = "ipg_no_election_yet"
			using = fontsize_medium
			alpha = 0.75
		}

		# --- Hemicycle ---
		widget = {
			size = { 600 230 }
			visible = "[And(Not(IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties'))), Or(GetVariableSystem.HasValue('ipg_layout_mode', 'hemicycle'), And(Not(GetVariableSystem.Exists('ipg_layout_mode')), Or(Not(Country.MakeScope.Var('ipg_auto_layout').IsSet), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_layout').GetValue, '(CFixedPoint)1')))))]"

			overlappingitembox = {
				size = { 600 230 }
				visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_visual_seats_val').GetValue, '(CFixedPoint)100')]"
				datamodel = "[Country.MakeScope.GetList('ipg_electoral_parties')]"
				item = { ipg_hemicycle_100_electoral = {} }
			}
			overlappingitembox = {
				size = { 600 230 }
				visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_visual_seats_val').GetValue, '(CFixedPoint)200')]"
				datamodel = "[Country.MakeScope.GetList('ipg_electoral_parties')]"
				item = { ipg_hemicycle_200_electoral = {} }
			}
			overlappingitembox = {
				size = { 600 230 }
				visible = "[Or(Not(Country.MakeScope.Var('ipg_visual_seats_val').IsSet), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_visual_seats_val').GetValue, '(CFixedPoint)300'))]"
				datamodel = "[Country.MakeScope.GetList('ipg_electoral_parties')]"
				item = { ipg_hemicycle_300_electoral = {} }
			}
			ipg_ruler_seat = { position = { 288 190 } }
		}

