								item = { ipg_tooltip_electoral_row = {} }
							}
						}

						flowcontainer = {
							visible = "[Not(IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_opp_parties')))]"
							direction = vertical
							margin_top = 4
							spacing = 0

							ipg_tooltip_group_header = {
