				visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_visual_seats_val').GetValue, '(CFixedPoint)100')]"
				datamodel = "[Country.MakeScope.GetList('ipg_electoral_parties')]"
				item = { ipg_westminster_100_electoral = {} }
			}
			overlappingitembox = {
				size = { 600 230 }
				visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_visual_seats_val').GetValue, '(CFixedPoint)200')]"
				datamodel = "[Country.MakeScope.GetList('ipg_electoral_parties')]"
				item = { ipg_westminster_200_electoral = {} }
			}
			overlappingitembox = {
				size = { 600 230 }
				visible = "[Or(Not(Country.MakeScope.Var('ipg_visual_seats_val').IsSet), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_visual_seats_val').GetValue, '(CFixedPoint)300'))]"
				datamodel = "[Country.MakeScope.GetList('ipg_electoral_parties')]"
				item = { ipg_westminster_300_electoral = {} }
			}
			ipg_ruler_seat = { position = { 102 104 } }
		}

		# --- Horseshoe ---
		widget = {
			size = { 600 230 }
			visible = "[And(Not(IsDataModelEmpty(Country.MakeScope.GetList('ipg_electoral_parties'))), Or(GetVariableSystem.HasValue('ipg_layout_mode', 'horseshoe'), And(Not(GetVariableSystem.Exists('ipg_layout_mode')), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_layout').GetValue, '(CFixedPoint)3'))))]"

			overlappingitembox = {
