# =============================================================================
# Improved ParliamentGraph - Parliament Panel Widget
# -----------------------------------------------------------------------------
# Single entry point: `parliament_item` (spliced into
# `politics_panel_government_details`, preserving zero-friction BPM compat).
#
# Features:
#   - 3 analytical views: Party Structure (Electoral), Power Structure,
#     Political Alignment — with automatic fallback to Power Structure when no
#     election snapshot exists yet (never opens to a blank box).
#   - 5 chamber layouts: Auto (law-driven default) + Hemicycle, Westminster,
#     Horseshoe, Assembly Hall, and Bicameral (Upper Power + Lower Election/Pop).
#   - 3 physical dot tiers (100 / 200 / 300) automatically matched to the
#     continuous real seat count (50..650).
#   - Gold coalition halos on governing seats, Ruler focal seat, coalition seat
#     counter with majority indicator, election dates, and on-demand _show refresh.
#
# Client-side VariableSystem keys:
#   ipg_parl_collapsed  (presence -> collapsed header strip)
#   ipg_parl_view       ('electoral' | 'power' | 'alignment')
#   ipg_layout_mode     (unset = Auto | 'hemicycle' | 'westminster' | 'horseshoe' | 'assembly' | 'bicameral')
#   ipg_hide_info       (presence -> hide corner seat/election overlays)
# =============================================================================

types politics_panel_types
{
	# -------------------------------------------------------------------------
	# Reusable Ruler / Head of State focal seat
	# -------------------------------------------------------------------------
	type ipg_ruler_seat = widget {
		size = { 24 24 }
		visible = "[Country.HasRuler]"
		alwaystransparent = no
		using = tooltip_below
		tooltip = "ipg_ruler_tooltip"

		icon = {
			texture = "gfx/interface/icons/ipg_white_circle.dds"
			tintcolor = "[Country.GetRuler.GetInterestGroup.GetColor]"
			size = { 16 16 }
			parentanchor = center

			icon = {
				texture = "gfx/interface/icons/ipg_dot_overlay.dds"
				size = { 100% 100% }
				alwaystransparent = yes
			}
			icon = {
				texture = "gfx/interface/icons/ipg_gov_halo.dds"
				size = { 22 22 }
				parentanchor = center
				alwaystransparent = yes
			}
		}
	}

	# -------------------------------------------------------------------------
	# Reusable 4-layout x 3-tier canvas renderers (only 1 layout x 1 tier visible)
	# -------------------------------------------------------------------------
	type ipg_canvas_power = widget {
		size = { 600 230 }

		# --- Hemicycle (layout 1 or default) ---
		widget = {
			size = { 600 230 }
			visible = "[Or(GetVariableSystem.HasValue('ipg_layout_mode', 'hemicycle'), And(Not(GetVariableSystem.Exists('ipg_layout_mode')), Or(Not(Country.MakeScope.Var('ipg_auto_layout').IsSet), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_layout').GetValue, '(CFixedPoint)1'))))]"

			overlappingitembox = {
				size = { 600 230 }
				visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_visual_seats_val').GetValue, '(CFixedPoint)100')]"
				datamodel = "[Country.MakeScope.GetList('ipg_power_igs')]"
				item = { ipg_hemicycle_100_power = {} }
			}
			overlappingitembox = {
				size = { 600 230 }
				visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_visual_seats_val').GetValue, '(CFixedPoint)200')]"
				datamodel = "[Country.MakeScope.GetList('ipg_power_igs')]"
				item = { ipg_hemicycle_200_power = {} }
			}
			overlappingitembox = {
				size = { 600 230 }
				visible = "[Or(Not(Country.MakeScope.Var('ipg_visual_seats_val').IsSet), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_visual_seats_val').GetValue, '(CFixedPoint)300'))]"
				datamodel = "[Country.MakeScope.GetList('ipg_power_igs')]"
				item = { ipg_hemicycle_300_power = {} }
			}
			ipg_ruler_seat = { position = { 288 190 } }
		}

		# --- Westminster (layout 2) ---
		widget = {
			size = { 600 230 }
			visible = "[Or(GetVariableSystem.HasValue('ipg_layout_mode', 'westminster'), And(Not(GetVariableSystem.Exists('ipg_layout_mode')), EqualTo_CFixedPoint(Country.MakeScope.Var('ipg_auto_layout').GetValue, '(CFixedPoint)2')))]"

