	# Electoral Party table row (436 x 26)
	type ipg_tooltip_electoral_row = widget {
		datacontext = "[Scope.GetParty]"
		size = { 436 26 }

		background = {
			visible = "[IsOdd_int32(PdxGuiWidget.GetIndexInDataModel)]"
			using = dark_area
			alpha = 0.45
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			margin = { 8 0 }

			# Col 1 (186): color dot + Party icon + name
			widget = {
				size = { 186 26 }
				layoutpolicy_horizontal = fixed

				hbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					spacing = 5

					icon = {
						size = { 8 8 }
						texture = "gfx/interface/icons/ipg_white_circle.dds"
						tintcolor = "[Party.GetColor]"
					}
					icon = {
						size = { 20 20 }
						texture = "[Party.GetIcon]"
					}
					textbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						text = "[Party.GetNameNoFormatting]"
						align = left|nobaseline
						elide = right
						fontsize_min = 12
						fonttintcolor = "[TooltipInfo.GetTintColor]"
					}
				}
			}

			# Col 2 (56): seats
			textbox = {
				size = { 56 26 }
				layoutpolicy_horizontal = fixed
				text = "ipg_electoral_seats_cell"
				align = right|nobaseline
				fonttintcolor = "[TooltipInfo.GetTintColor]"
			}

			# Col 3 (72): vote share %
			textbox = {
				size = { 72 26 }
				layoutpolicy_horizontal = fixed
				text = "ipg_electoral_vote_cell"
				align = right|nobaseline
				alpha = 0.85
				fonttintcolor = "[TooltipInfo.GetTintColor]"
			}

			# Col 4 (106): member IG icon strip
			widget = {
				size = { 106 26 }
				layoutpolicy_horizontal = fixed

				overlappingitembox = {
					datamodel = "[Party.GetMembers]"
					size = { 102 20 }
					spacing = 2
					righttoleft = yes
					parentanchor = right|vcenter

					item = {
						icon = {
							size = { 20 20 }
							parentanchor = vcenter
							texture = "[InterestGroup.GetTexture]"
						}
					}
				}
			}
		}
	}

	# Condensed Bicameral IG row (436 x 22)
	type ipg_tooltip_bicameral_ig_row = widget {
