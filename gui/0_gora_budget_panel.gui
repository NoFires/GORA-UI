				### TABLE 1: STATE-OWNED INDUSTRY
				default_header = {
					blockoverride "text" {
						text = "STATE_ASSETS_HEADER"
					}
				}

				# Column headers row
				widget = {
					size = { @panel_width 30 }
					parentanchor = hcenter

					textbox = {
						position = { 245 0 }
						size = { 50 30 }
