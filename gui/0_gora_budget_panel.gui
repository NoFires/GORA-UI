						visible = "[Not(GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var('snap_age_1').GetValue, '(CFixedPoint)0' ))]"
						position = { 245 0 }
						size = { 280 40 }
						raw_text = "-"
