						align = left|nobaseline
						parentanchor = vcenter
					}
					textbox = {
						visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var('snap_age_1').GetValue, '(CFixedPoint)0' )]"
						position = { 355 0 }
						size = { 170 40 }
