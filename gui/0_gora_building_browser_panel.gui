						}

						# SPREADSHEET
						hbox = {
							layoutpolicy_vertical = expanding
							layoutpolicy_horizontal = expanding

							scrollarea = {
								layoutpolicy_vertical = expanding
								layoutpolicy_horizontal = expanding

								scrollbar_horizontal = {
									using = horizontal_scrollbar
								}

								scrollbar_vertical = {
									using = vertical_scrollbar
								}

								scrollwidget = {
									container = {
										parentanchor = hcenter
										fixedgridbox = {
											addrow = @spreadsheet_height
											addcolumn = @spreadsheet_width
											datamodel = "[BuildingBrowserPanel.GetSortedAndFilteredBuildings]"
											parentanchor = hcenter
											visible = "[Not(BuildingBrowserPanel.IsGroupedByBuildingType)]"

											item = {
												widget = {
													size = { @spreadsheet_width @spreadsheet_height }
												### GORA UI+ — sector filter (individual buildings)
												visible = "[Or( Not(GetVariableSystem.Exists('sector_filter_active')), Or( And(GetVariableSystem.HasValue('sector_filter_active', 'light'), EqualTo_string(Building.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_light_industry'))), Or( And(GetVariableSystem.HasValue('sector_filter_active', 'heavy'), EqualTo_string(Building.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_heavy_industry'))), And(GetVariableSystem.HasValue('sector_filter_active', 'military'), Or(EqualTo_string(Building.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_army')), Or(EqualTo_string(Building.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_conscription')), Or(EqualTo_string(Building.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_naval_administration')), Or(EqualTo_string(Building.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_naval_fortification')), Or(EqualTo_string(Building.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_naval_logistics_center')), Or(EqualTo_string(Building.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_military_industry')), EqualTo_string(Building.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_ship_construction'))))))))) ) ) )]"
												### GORA UI+ — end sector filter

													building_browser_building_item = {}

													divider_clean = {
														size = { 100% 1 }
														parentanchor = bottom
														alpha = 0.15
													}
												}
											}
										}

										flowcontainer = {
											datamodel = "[BuildingBrowserPanel.GetBuildingBrowserBuildingTypeItems]"
											parentanchor = hcenter
											visible = "[BuildingBrowserPanel.IsGroupedByBuildingType]"
											direction = vertical
											spacing = 3
											margin_top = 3

											item = {
											### GORA UI+ — sector filter (grouped buildings)
											building_browser_building_type_item = {
												visible = "[Or( Not(GetVariableSystem.Exists('sector_filter_active')), Or( And(GetVariableSystem.HasValue('sector_filter_active', 'light'), EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_light_industry'))), Or( And(GetVariableSystem.HasValue('sector_filter_active', 'heavy'), EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_heavy_industry'))), And(GetVariableSystem.HasValue('sector_filter_active', 'military'), Or(EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_army')), Or(EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_conscription')), Or(EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_naval_administration')), Or(EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_naval_fortification')), Or(EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_naval_logistics_center')), Or(EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_military_industry')), EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_ship_construction'))))))))) ) ) )]"
											}
											### GORA UI+ — end sector filter
											}
										}
									}
								}
							}
						}
					}

					# EMPTY STATE
					textbox = {
						text = "NO_BUILDINGS_MATCHES_THE_CURRENT_FILTER"
						visible = "[IsDataModelEmpty(BuildingBrowserPanel.GetSortedAndFilteredBuildings)]"

						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						using = fontsize_xxl
						using = empty_state_text_properties
						align = hcenter|nobaseline

						background = {
							using = dark_area
							margin_top = 2
							margin_left = 14
							margin_right = 100
						}
					}
				}
			}
		}
	}


	type compact_building_browser_panel = default_block_window_two_lines {
		name = "compact_building_browser_panel"
		datacontext = "[BuildingBrowserPanel.GetCountry]"

		blockoverride "animation_state_block" {
			state = {
				name = _show
				start_sound = {
					soundeffect = "event:/SFX/UI/SideBar/buildings"
				}

				on_start = "[BuildingBrowserPanel.Sort('database_order')]"
			}

			state = {
				name = _hide
				start_sound = {
					soundeffect = "event:/SFX/UI/SideBar/buildings_stop"
				}

				on_start = "[BuildingBrowserPanel.Sort('database_order')]"
			}
		}

		blockoverride "window_header_name" {
			text = "PRODUCTION_METHODS_HEADER"
		}

		blockoverride "window_header_name_line_two" {
			datacontext = "[AccessPlayer]"
			text = "CONSTRUCTION_IN_COUNTRY"
		}

		blockoverride "map_modes_button" {
			map_modes_single_button_minimized = {
				datacontext = "[BuildingBrowserPanel.GetMapModeList]"
				using = map_modes_button_position
			}
		}

		blockoverride "goto_button" {
			button_icon_goto = {
				size = { 30 30 }
				onclick = "[InformationPanelBar.OpenConstructionPanel( GetPlayer.Self )]"
				tooltip = "GO_TO_BUTTON_CONSTRUCTION_QUEUE"
				input_action = "go_to_details"
			}
		}

		blockoverride "fixed_top" {

			flowcontainer = {
				direction = vertical

				background = {
					using = dropdown_background
					margin = { 0 -2 }
				}

				### SEARCH (vanilla; keep when re-syncing)
				search_bar = {
					parentanchor = hcenter
					datacontext = "[BuildingBrowserPanel.GetSearchBar]"
				}

				section_header_button = {
					blockoverride "arrow_position" {
						position = { 10 0 }
						parentanchor = left|vcenter
					}

					blockoverride "left_text" {
						text = "FILTERS"
						fontsize_min = 12
						elide = right
					}

					blockoverride "right_text" {
						section_header_right_text = {
							text = "CURRENT_COMPACT_BUILDING_BROWSER_FILTER"
						}
					}

					blockoverride "onclick" {
						onclick = "[GetVariableSystem.Toggle( 'compact_building_browser_filters' )]"
					}
					
					blockoverride "onclick_showmore" {
						visible = "[GetVariableSystem.Exists( 'compact_building_browser_filters' )]" # Flipped to show by default
					}

					blockoverride "onclick_showless" {
						visible = "[Not(GetVariableSystem.Exists( 'compact_building_browser_filters' ))]" # Flipped to show by default
					}
				}

				flowcontainer = {
					visible = "[Not(GetVariableSystem.Exists( 'compact_building_browser_filters' ))]" # Flipped to show by default
					parentanchor = hcenter
					margin_bottom = 10
					margin_top = 5
					direction = vertical
					minimumsize = { @panel_width_plus_14 -1 }

					### BUILDING LOCATION FILTER
					building_browser_filter_line = {
						parentanchor = hcenter
						blockoverride "line_background" {}

						blockoverride "filter_line_label"
						{
							text = "LOCATION"
						}

						blockoverride "filter_line_active_visible"
						{
							visible = "[BuildingBrowserPanel.IsFiltered('is_domestic')]"
						}

						blockoverride "line_size"
						{
							size = { @panel_width 38 }
						}

						blockoverride "filter_line_buttons"
						{
							building_browser_filter_line_button = {
								blockoverride "line_button_tooltip"
								{
									tooltip = "ALL"
								}

								blockoverride "line_button_onclick"
								{
									onclick = "[BuildingBrowserPanel.SetFilterMode('is_domestic', 'off')]"
								}

								blockoverride "line_button_icon_texture"
								{
									texture = "gfx/interface/icons/building_icons/building_browser_filter_icons/filter_icons_all.dds"
								}

								blockoverride "line_button_selected"
								{
									visible = "[Not(BuildingBrowserPanel.IsFiltered('is_domestic'))]"
									alpha = @all_filter_selected_alpha
								}

							}

							building_browser_filter_line_button = {
								blockoverride "line_button_tooltip"
								{
									tooltip = "IS_DOMESTIC"
								}

								blockoverride "line_button_onclick"
								{
									onclick = "[BuildingBrowserPanel.SetFilterMode('is_domestic', 'yes')]"
								}

								blockoverride "line_button_icon_texture"
								{
									texture = "gfx/interface/icons/building_icons/building_browser_filter_icons/filter_icons_domestic.dds"
								}

								blockoverride "line_button_selected"
								{
									visible = "[BuildingBrowserPanel.IsFilterYes('is_domestic')]"
								}

							}

							building_browser_filter_line_button = {
								blockoverride "line_button_tooltip"
								{
									tooltip = "IS_ABROAD"
								}

								blockoverride "line_button_onclick"
								{
									onclick = "[BuildingBrowserPanel.SetFilterMode('is_domestic', 'no')]"
								}

								blockoverride "line_button_icon_texture"
								{
									texture = "gfx/interface/buttons/button_icons/foreign_invest.dds"
								}

								blockoverride "line_button_selected"
								{
									visible = "[BuildingBrowserPanel.IsFilterNo('is_domestic')]"
								}
							}
						}
					}

					### BUILDING GROUP FILTER
					building_browser_filter_line = {
						parentanchor = hcenter
						blockoverride "line_background" {}

						blockoverride "filter_line_label"
						{
							text = "BUILDING_GROUP"
						}

						blockoverride "filter_line_active_visible"
						{
							visible = "[Not(And(And(Not(BuildingBrowserPanel.IsFiltered('is_urban')), Not(BuildingBrowserPanel.IsFiltered('is_rural'))), Not(BuildingBrowserPanel.IsFiltered('is_development'))))]"
						}

						blockoverride "line_size"
						{
							size = { @panel_width 38 }
						}

						blockoverride "filter_line_buttons"
						{
							building_browser_filter_line_button = {
								blockoverride "line_button_tooltip"
								{
									tooltip = "ALL"
								}

								blockoverride "line_button_onclick"
								{
									onclick = "[BuildingBrowserPanel.SetFilterMode('is_urban', 'off')]"
									onclick = "[BuildingBrowserPanel.SetFilterMode('is_rural', 'off')]"
									onclick = "[BuildingBrowserPanel.SetFilterMode('is_development', 'off')]"
								}

								blockoverride "line_button_icon_texture"
								{
									texture = "gfx/interface/icons/building_icons/building_browser_filter_icons/filter_icons_all.dds"
								}

								blockoverride "line_button_selected"
								{
									visible = "[And(And(Not(BuildingBrowserPanel.IsFiltered('is_urban')), Not(BuildingBrowserPanel.IsFiltered('is_rural'))), Not(BuildingBrowserPanel.IsFiltered('is_development')))]"
									alpha = @all_filter_selected_alpha
								}
							}

							building_browser_filter_line_button = {
								blockoverride "line_button_tooltip"
								{
									tooltip = "IS_DEVELOPMENT"
								}

								blockoverride "line_button_onclick"
								{
									onclick = "[BuildingBrowserPanel.SetFilterMode('is_development', 'yes')]"
									onclick = "[BuildingBrowserPanel.SetFilterMode('is_urban', 'off')]"
									onclick = "[BuildingBrowserPanel.SetFilterMode('is_rural', 'off')]"
								}

								blockoverride "line_button_icon_texture"
								{
									texture = "gfx/interface/icons/building_icons/building_browser_filter_icons/filter_icons_development.dds"
								}

								blockoverride "line_button_selected"
								{
									visible = "[BuildingBrowserPanel.IsFilterYes('is_development')]"
								}
							}

							building_browser_filter_line_button = {
								blockoverride "line_button_tooltip"
								{
									tooltip = "IS_RURAL"
								}

								blockoverride "line_button_onclick"
								{
									onclick = "[BuildingBrowserPanel.SetFilterMode('is_rural', 'yes')]"
									onclick = "[BuildingBrowserPanel.SetFilterMode('is_urban', 'off')]"
									onclick = "[BuildingBrowserPanel.SetFilterMode('is_development', 'off')]"
								}

								blockoverride "line_button_icon_texture"
								{
									texture = "gfx/interface/icons/building_icons/building_browser_filter_icons/filter_icons_rural.dds"
								}

								blockoverride "line_button_selected"
								{
									visible = "[BuildingBrowserPanel.IsFilterYes('is_rural')]"
								}
							}

							building_browser_filter_line_button = {
								blockoverride "line_button_tooltip"
								{
									tooltip = "IS_URBAN"
								}

								blockoverride "line_button_onclick"
								{
									onclick = "[BuildingBrowserPanel.SetFilterMode('is_urban', 'yes')]"
									onclick = "[BuildingBrowserPanel.SetFilterMode('is_rural', 'off')]"
									onclick = "[BuildingBrowserPanel.SetFilterMode('is_development', 'off')]"
								}

								blockoverride "line_button_icon_texture"
								{
									texture = "gfx/interface/icons/building_icons/building_browser_filter_icons/filter_icons_urban.dds"
								}

								blockoverride "line_button_selected"
								{
									visible = "[BuildingBrowserPanel.IsFilterYes('is_urban')]"
								}
							}
						}
					}


					### GORA UI+ — sector filter (industry grouping, compact view)
					building_browser_filter_line = {
						parentanchor = hcenter
						blockoverride "line_background" {}

						blockoverride "filter_line_label"
						{
							text = "GORA_SECTOR_FILTER_LABEL"
						}

						blockoverride "filter_line_buttons"
						{
							building_browser_filter_line_button = {
								blockoverride "line_button_tooltip" { tooltip = "ALL" }
								blockoverride "line_button_onclick" { onclick = "[GetVariableSystem.Clear('sector_filter_active')]" }
								blockoverride "line_button_icon_texture" { texture = "gfx/interface/icons/building_icons/building_browser_filter_icons/filter_icons_all.dds" }
								blockoverride "line_button_selected" {
									visible = "[Not(GetVariableSystem.Exists('sector_filter_active'))]"
									alpha = @all_filter_selected_alpha
								}
							}

							building_browser_filter_line_button = {
								blockoverride "line_button_tooltip" { tooltip = "[Localize('bg_light_industry')]" }
								blockoverride "line_button_onclick" { onclick = "[GetVariableSystem.Set('sector_filter_active', 'light')]" }
								blockoverride "line_button_icon_texture" { texture = "gfx/interface/icons/gora_sector_light.dds" }
								blockoverride "line_button_selected" { visible = "[GetVariableSystem.HasValue('sector_filter_active', 'light')]" }
							}

							building_browser_filter_line_button = {
								blockoverride "line_button_tooltip" { tooltip = "[Localize('bg_heavy_industry')]" }
								blockoverride "line_button_onclick" { onclick = "[GetVariableSystem.Set('sector_filter_active', 'heavy')]" }
								blockoverride "line_button_icon_texture" { texture = "gfx/interface/icons/gora_sector_heavy.dds" }
								blockoverride "line_button_selected" { visible = "[GetVariableSystem.HasValue('sector_filter_active', 'heavy')]" }
							}

							building_browser_filter_line_button = {
								blockoverride "line_button_tooltip" { tooltip = "[Localize('bg_military_industry')]" }
								blockoverride "line_button_onclick" { onclick = "[GetVariableSystem.Set('sector_filter_active', 'military')]" }
								blockoverride "line_button_icon_texture" { texture = "gfx/interface/icons/gora_sector_military.dds" }
								blockoverride "line_button_selected" { visible = "[GetVariableSystem.HasValue('sector_filter_active', 'military')]" }
							}
						}
					}
					### GORA UI+ — end sector filter
					### BUILDING OWNERSHIP FILTER
					building_browser_filter_line = {
						parentanchor = hcenter
						blockoverride "line_background" {}

						blockoverride "filter_line_label"
						{
							text = "BUILDING_FILTER_OWNERSHIP"
						}

						blockoverride "filter_line_active_visible"
						{
							visible = "[Not(And(And(Not(BuildingBrowserPanel.IsFiltered('owned_national')), Not(BuildingBrowserPanel.IsFiltered('owned_private'))), Not(BuildingBrowserPanel.IsFiltered('owned_foreign'))))]"
						}

						blockoverride "line_size"
						{
							size = { @panel_width 38 }
						}

						blockoverride "filter_line_buttons"
						{
							building_browser_filter_line_button = {
								blockoverride "line_button_tooltip"
								{
									tooltip = "ALL"
								}

								blockoverride "line_button_onclick"
								{
									onclick = "[BuildingBrowserPanel.SetFilterMode('owned_national', 'off')]"
									onclick = "[BuildingBrowserPanel.SetFilterMode('owned_private', 'off')]"
									onclick = "[BuildingBrowserPanel.SetFilterMode('owned_foreign', 'off')]"
									onclick = "[BuildingBrowserPanel.SetFilterMode('owned_company', 'off')]"
								}

								blockoverride "line_button_icon_texture"
								{
									texture = "gfx/interface/icons/building_icons/building_browser_filter_icons/filter_icons_all.dds"
								}

								blockoverride "line_button_selected"
								{
									visible = "[And(And(Not(BuildingBrowserPanel.IsFiltered('owned_national')), Not(BuildingBrowserPanel.IsFiltered('owned_private'))), Not(BuildingBrowserPanel.IsFiltered('owned_foreign')))]"
									alpha = @all_filter_selected_alpha
								}

							}

							building_browser_filter_line_button = {
								blockoverride "line_button_tooltip"
								{
									tooltip = "BUILDING_FILTER_OWNERSHIP_GOVERNMENT_TT"
								}

								blockoverride "line_button_onclick"
								{
									onclick = "[BuildingBrowserPanel.SetFilterMode('owned_national', 'yes')]"
									onclick = "[BuildingBrowserPanel.SetFilterMode('owned_private', 'off')]"
									onclick = "[BuildingBrowserPanel.SetFilterMode('owned_foreign', 'off')]"
									onclick = "[BuildingBrowserPanel.SetFilterMode('owned_company', 'off')]"
								}

								blockoverride "line_button_icon_texture"
								{
									texture = "gfx/interface/icons/generic_icons/government_building_icon.dds"
								}

								blockoverride "line_button_selected"
								{
									visible = "[BuildingBrowserPanel.IsFilterYes('owned_national')]"
								}

							}

							building_browser_filter_line_button = {
								blockoverride "line_button_tooltip"
								{
									tooltip = "BUILDING_FILTER_OWNERSHIP_PRIVATE_TT"
								}

								blockoverride "line_button_onclick"
								{
									onclick = "[BuildingBrowserPanel.SetFilterMode('owned_private', 'yes')]"
									onclick = "[BuildingBrowserPanel.SetFilterMode('owned_national', 'off')]"
									onclick = "[BuildingBrowserPanel.SetFilterMode('owned_foreign', 'off')]"
									onclick = "[BuildingBrowserPanel.SetFilterMode('owned_company', 'off')]"
								}

								blockoverride "line_button_icon_texture"
								{
									texture = "gfx/interface/icons/generic_icons/privately_owned_building_icon.dds"
								}

								blockoverride "line_button_selected"
								{
									visible = "[BuildingBrowserPanel.IsFilterYes('owned_private')]"
								}

							}

							building_browser_filter_line_button = {
								blockoverride "line_button_tooltip"
								{
									tooltip = "BUILDING_FILTER_OWNERSHIP_FOREIGN_TT"
								}

								blockoverride "line_button_onclick"
								{
									onclick = "[BuildingBrowserPanel.SetFilterMode('owned_foreign', 'yes')]"
									onclick = "[BuildingBrowserPanel.SetFilterMode('owned_national', 'off')]"
									onclick = "[BuildingBrowserPanel.SetFilterMode('owned_private', 'off')]"
									onclick = "[BuildingBrowserPanel.SetFilterMode('owned_company', 'off')]"
								}

								blockoverride "line_button_icon_texture"
								{
									texture = "gfx/interface/icons/building_icons/building_browser_filter_icons/filter_icons_foreign_owners.dds"
								}

								blockoverride "line_button_selected"
								{
									visible = "[BuildingBrowserPanel.IsFilterYes('owned_foreign')]"
								}

							}

							building_browser_filter_line_button = {
								blockoverride "line_button_tooltip"
								{
									tooltip = "BUILDING_FILTER_OWNERSHIP_COMPANY_TT"
								}

								blockoverride "line_button_onclick"
								{
									onclick = "[BuildingBrowserPanel.SetFilterMode('owned_company', 'yes')]"
									onclick = "[BuildingBrowserPanel.SetFilterMode('owned_foreign', 'off')]"
									onclick = "[BuildingBrowserPanel.SetFilterMode('owned_national', 'off')]"
									onclick = "[BuildingBrowserPanel.SetFilterMode('owned_private', 'off')]"
								}

								blockoverride "line_button_icon_texture"
								{
									texture = "gfx/interface/icons/building_icons/building_browser_filter_icons/filter_icons_has_companies_owners.dds"
								}

								blockoverride "line_button_selected"
								{
									visible = "[BuildingBrowserPanel.IsFilterYes('owned_company')]"
								}
							}
						}
					}

					### POTENTIAL BUILDING TYPES FILTER
					building_browser_filter_line = {
						visible = no # todo - PRCAL-36023 - Remove this visible check
						parentanchor = hcenter
						blockoverride "line_background" {}

						blockoverride "filter_line_label"
						{
							text = "AVAILABILITY"
						}

						blockoverride "filter_line_active_visible"
						{
							#visible = "[BuildingBrowserPanel.IsFiltered('is_existing')]" # todo - PRCAL-36023
						}

						blockoverride "line_size"
						{
							size = { @panel_width 38 }
						}

						blockoverride "filter_line_buttons"
						{
							building_browser_filter_line_button = {
								blockoverride "line_button_tooltip"
								{
									tooltip = "AVAILABLITY_ALL"
								}

								blockoverride "line_button_onclick"
								{
									#onclick = "[BuildingBrowserPanel.SetFilterMode('is_existing', 'off')]" # todo - PRCAL-36023
								}

								blockoverride "line_button_icon_texture"
								{
									texture = "gfx/interface/icons/building_icons/building_browser_filter_icons/filter_icons_all.dds"
								}

								blockoverride "line_button_selected"
								{
									#visible = "[Not(BuildingBrowserPanel.IsFiltered('is_existing'))]" # todo - PRCAL-36023
									alpha = @all_filter_selected_alpha
								}

							}

							building_browser_filter_line_button = {
								blockoverride "line_button_tooltip"
								{
									tooltip = "ONLY_AVAILABLE_BUILDING_TYPES"
								}

								blockoverride "line_button_onclick"
								{
									#onclick = "[BuildingBrowserPanel.SetFilterMode('is_existing', 'yes')]" # todo - PRCAL-36023
								}

								blockoverride "line_button_icon_texture"
								{
									texture = "gfx/interface/icons/building_icons/building_browser_filter_icons/filter_icons_existing_building_available.dds"
								}

								blockoverride "line_button_icon_size"
								{
									size = { 25 25 }
								}

								blockoverride "line_button_selected"
								{
									#visible = "[BuildingBrowserPanel.IsFilterYes('is_existing')]" # todo - PRCAL-36023
									visible = no
								}
							}

							building_browser_filter_line_button = {
								blockoverride "line_button_tooltip"
								{
									tooltip = "ONLY_POTENTIAL_BUILDING_TYPES"
								}

								blockoverride "line_button_onclick"
								{
									#onclick = "[BuildingBrowserPanel.SetFilterMode('is_existing', 'no')]" # todo - PRCAL-36023
								}

								blockoverride "line_button_icon_texture"
								{
									texture = "gfx/interface/icons/building_icons/building_browser_filter_icons/filter_icons_new_building_available.dds"
								}

								blockoverride "line_button_icon_size"
								{
									size = { 25 25 }
								}

								blockoverride "line_button_selected"
								{
									#visible = "[BuildingBrowserPanel.IsFilterNo('is_existing')]" # todo - PRCAL-36023
									visible = no
								}
							}
						}
					}
				}
			}

			# SORT BUTTONS
			flowcontainer = {
				margin_bottom = 5

				sort_button = {
					size = { 135 30 }
					text = "NAME"
					tooltip = "SORT_BY_BUILDING_NAME"
					align = nobaseline
					onclick = "[BuildingBrowserPanel.Sort('building')]"
				}

				sort_button = {
					size = { 135 30 }
					text = "SIZE"
					tooltip = "SORT_BY_BUILDING_SIZE"
					align = nobaseline
					onclick = "[BuildingBrowserPanel.Sort('level')]"
				}

				sort_button = {
					size = { 135 30 }
					text = "BUILDING_DATABASE_ORDER"
					tooltip = "SORT_BY_BUILDING_TYPE"
					align = nobaseline
					onclick = "[BuildingBrowserPanel.Sort('database_order')]"
				}

				sort_button = {
					size = { 135 30 }
					text = "concept_productivity"
					tooltip = "SORT_BY_BUILDING_PRODUCTIVITY"
					align = nobaseline
					onclick = "[BuildingBrowserPanel.Sort('profitability')]"
				}
			}
		}

		blockoverride "scrollarea_content"
		{
			flowcontainer = {
				direction = vertical

			
				# Remove this, currently needed to make sure GetBuildingBrowserBuildingTypeItems is being populated
				flowcontainer = {
					datamodel = "[BuildingBrowserPanel.GetSortedAndFilteredBuildings]"

					item = {
						widget = {}
					}
				}

				flowcontainer = {
					direction = vertical
					spacing = 5

					datamodel = "[BuildingBrowserPanel.GetBuildingBrowserBuildingTypeItems]"

					item = {
						container = {
							### GORA UI+ — sector filter (compact view)
							visible = "[Or( Not(GetVariableSystem.Exists('sector_filter_active')), Or( And(GetVariableSystem.HasValue('sector_filter_active', 'light'), EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_light_industry'))), Or( And(GetVariableSystem.HasValue('sector_filter_active', 'heavy'), EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_heavy_industry'))), And(GetVariableSystem.HasValue('sector_filter_active', 'military'), Or(EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_army')), Or(EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_conscription')), Or(EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_naval_administration')), Or(EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_naval_fortification')), Or(EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_naval_logistics_center')), Or(EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_military_industry')), EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_ship_construction'))))))))) ) ) )]"
							### GORA UI+ — end sector filter
							bperf_compact_production_item = {
								#visible = "[BuildingBrowserBuildingTypeItem.BuildingBrowserBuildingTypeItem.ExistsIn(GetPlayer.Self)]" # todo - PRCAL-36023
							}

							
						}
					}
				}

				#POTENTIAL DEVELOPMENT
				building_panel_potential_buildings = {
					visible = "[BuildingBrowserPanel.IsFilterYes('is_development')]"

					blockoverride "potential_building_types" {
						datamodel = "[BuildingBrowserPanel.GetPotentialDevelopmentBuildingTypes]"
					}
					blockoverride "text" {
						text = "AVAILABLE_DEVELOPMENT_BUILDINGS"
					}
				} 

				#POTENTIAL RURAL
				building_panel_potential_buildings = {
					visible = "[BuildingBrowserPanel.IsFilterYes('is_rural')]"

					blockoverride "potential_building_types" {
						datamodel = "[BuildingBrowserPanel.GetPotentialRuralBuildingTypes]"
					}
					blockoverride "text" {
						text = "AVAILABLE_RURAL_BUILDINGS"
					}
				}

				#POTENTIAL URBAN
				building_panel_potential_buildings = {
					visible = "[BuildingBrowserPanel.IsFilterYes('is_urban')]"

					blockoverride "potential_building_types" {
						datamodel = "[BuildingBrowserPanel.GetPotentialUrbanBuildingTypes]"
					}
					blockoverride "text" {
						text = "AVAILABLE_URBAN_BUILDINGS"
					}
				}
			}
		}

		blockoverride "fixed_bottom" {
			flowcontainer = {
				direction = vertical
				spacing = 5

				divider_clean = {
					size = { @panel_width_plus_14 4 }
				}

				background = {
					using = dark_area
				}

				button = {
					parentanchor = hcenter
					using = default_button_primary_big 
					text = "BUILDING_BROWSER"
					align = hcenter|nobaseline
					size = { @panel_width 50 }
					using = fontsize_large
					onclick = "[InformationPanelBar.OpenBuildingBrowserPanel( GetPlayer.Self )]"
				}
			}
		}
	}

}

# Compact-only row variant; shared native row definitions remain untouched.
types bperf_compact_buildings
{
	type bperf_compact_production_item = flowcontainer {
		direction = vertical
		spacing = 10

		block "visible" {
			visible = "[Not(IsDataModelEmpty(BuildingBrowserBuildingTypeItem.GetBuildings))]"
		}

		block "datacontext" {
			datacontext = "[BuildingBrowserBuildingTypeItem.GetBuildingType]"
		}

		### TOP ITEM
		widget = {
			size = { @bperf_compact_panel_width_plus_14 95 }

			highlight_tutorial = {
	   			visible = "[BuildingType.IsBeingTutorialHighlighted]"
	    	}

			### DROPDOWN / EXPAND
			section_header_button = {
				block "section_header_interactable" {}

				blockoverride "background" {
					block "section_header_background" {
						using = expand_button_bg
					}
				}

				blockoverride "layout" {
					position = { 110 0 }
					size = { 440 38 }
				}

				blockoverride "left_text" {
					raw_text = "#v [BuildingType.GetNameNoFormatting]#!"
				}
				blockoverride "right_text" {
					section_header_right_text = {
						visible = "[And( And(Not(BuildingType.IsGovernmentFunded), Not(BuildingType.IsSubsistenceBuilding)), GreaterThan_int32( BuildingType.GetNumLevelsInCountryRaw(GetPlayer.Self), '(int32)0' ))]"
						name = "bperf_compact_productivity"
						max_update_rate = 32
						text = "[BuildingType.GetProductivitySpanDesc(GetPlayer.Self)]"
						tooltip = "PRODUCTIVITY_SPAN_TOOLTIP"
					}
				}

				blockoverride "onclick" {
					block "expand_onclick" {
						onclick = "[BuildingBrowserPanel.ToggleExpandBuildingType(BuildingBrowserBuildingTypeItem.GetBuildingType)]"
					}
				}

				blockoverride "onclick_showmore" {
					block "expand_showmore_visible" {
						visible = "[Not(BuildingBrowserPanel.IsBuildingTypeExpanded(BuildingBrowserBuildingTypeItem.GetBuildingType))]"
					}
				}

				blockoverride "onclick_showless" {
					block "expand_showless_visible" {
						visible = "[BuildingBrowserPanel.IsBuildingTypeExpanded(BuildingBrowserBuildingTypeItem.GetBuildingType)]"
					}
				}
			}

			### production methods grouped
			container = {
				position = { 110 0 }
				parentanchor = bottom

				fixedgridbox = {
					datamodel = "[BuildingBrowserBuildingTypeItem.GetBuildingType.AccessProductionMethodGroups]"
					datamodel_reuse_widgets = yes
					flipdirection = yes
					addcolumn = 52
					addrow = 50

					item = {
						widget = {
							size = { 50 50 }
							tooltip = "BUILDING_TYPE_BULK_CHANGE_TOOLTIP"
							using = tooltip_ne

							button = {
								visible = "[NotEqualTo_int32( GetDataModelSize( ProductionMethodGroup.AccessCountryProductionMethods( GetPlayer.Self ) ), '(int32)1' )]"
								distribute_visual_state = no
								inherit_visual_state = no
								using = expand_button_bg_dropdown
								size = { 100% 100% }
								onclick = "[BuildingBrowserBuildingTypeItem.ToggleSwitchProductionMethodMenu( ProductionMethodGroup.AccessSelf, PdxGuiWidget.AccessSelf)]"
								enabled = "[Not(IsDataModelEmpty(BuildingBrowserBuildingTypeItem.GetBuildingsInCountry))]"
							}

							### pm icon
							icon = {
								visible = "[BuildingBrowserBuildingTypeItem.HasAllSameProductionMethod( ProductionMethodGroup.Self )]"
								size = { 40 40 }
								parentanchor = center
								texture = "[BuildingBrowserBuildingTypeItem.GetAllSameProductionMethodTexture( ProductionMethodGroup.Self )]"
							}

							### mixed pm icon
							icon = {
								visible = "[Not( BuildingBrowserBuildingTypeItem.HasAllSameProductionMethod( ProductionMethodGroup.Self ) )]"
								size = { 35 35 }
								parentanchor = center
								texture = "[ProductionMethodGroup.GetMixedIcon]"
							}

							### new pm
							has_new_pm_icon = {
								position = { -2 2 }
								parentanchor = bottom|left
								blockoverride "visible" {
									visible = "[And(GetPlayer.HasNewProductionMethodInGroup( ProductionMethodGroup.Self ), Not(IsDataModelEmpty(BuildingBrowserBuildingTypeItem.GetBuildingsInCountry)))]"
								}
							}


							### nr available
							textbox = {
								name = "bperf_compact_pm_count"
								max_update_rate = 16
								raw_text = "#bold [ProductionMethodGroup.GetNumAvailableOptionsForBuildingType(BuildingBrowserBuildingTypeItem.GetBuildingType.AccessSelf)]#!"
								parentanchor = right
								position = { -5 0 }
								autoresize = yes
								align = right|nobaseline
								visible = "[GreaterThan_int32( ProductionMethodGroup.GetNumAvailableOptionsForBuildingType(BuildingBrowserBuildingTypeItem.GetBuildingType.AccessSelf), '(int32)1')]"
								tooltip = "PRODUCTION_METHOD_OPTIONS_BULK"
								using = tooltip_above
								using = fontsize_small

								background = {
									using = default_background
									margin = { 8 4 }
								}
							}
						}
					}
				}
			}

			### building icon
			button = {
				texture = "[BuildingType.GetIcon]"
				onrightclick = "[RightClickMenuManager.ShowForBuildingType(BuildingType.AccessSelf)]"
				effectname = "NoHighlight"
				distribute_visual_state = no
				inherit_visual_state = no

				size = { 100 100 }
				position = { 7 0 }
				parentanchor = vcenter

				tooltipwidget = {
					FancyTooltip_BuildingType = {}
				}
			}

			### ACTION BUTTONS
			flowcontainer = {
				parentanchor = bottom|right
				position = { -10 -5 }
				spacing = 5
				
				### nationalize
				building_type_nationalize_button = {
					size = { 40 40 }
				}

				### privatize
				building_type_privatize_toggle = {
					visible = no
					size = { 40 40 }
				}

				building_type_privatize_or_monopolize = {}

				### subsidize
				building_type_subsidize_toggle = {
					size = { 40 40 } 
				}

				### auto expand
				building_type_auto_expand_toggle = {
					size = { 40 40 } 
				}
				
				### expand
				button_icon_round_map_interaction = {
					size = { 40 40 }
					blockoverride "icon" {
						texture = "gfx/interface/buttons/button_icons/plus.dds"
					}

					onclick = "[BuildingType.ActivateExpansionLens]"
					using = select_button_sound
					block "expand_button_visible" {
						visible = "[And(Or( BuildingType.IsBuildable, BuildingType.IsExpandable ), Not(BuildingType.GeneratesCombatUnits))]"
					}
					tooltip = "EXPAND_TOOLTIP_BUILDING_TYPE"
					using = tooltip_se
				}
			}

			### PRODUCTIVITY SPAN ###
			textbox = {
				name = "bperf_compact_size"
				max_update_rate = 32
				raw_text = "#v [BuildingBrowserBuildingTypeItem.GetTotalFilteredSizeDesc]#!"
				autoresize = yes
				position = { 11 -3 }
				parentanchor = bottom
				align = hcenter|nobaseline
				using = fontsize_large
				minimumsize = { 26 26 }
			}
		}

		### EXPANDED LIST OF BUILDINGS
		flowcontainer = {
			name = "bperf_compact_expanded_host"
			direction = vertical
			visible = "[And(BuildingBrowserPanel.IsBuildingTypeExpanded(BuildingBrowserBuildingTypeItem.GetBuildingType), And(Or( Not(GetVariableSystem.Exists('sector_filter_active')), Or( And(GetVariableSystem.HasValue('sector_filter_active', 'light'), EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_light_industry'))), Or( And(GetVariableSystem.HasValue('sector_filter_active', 'heavy'), EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_heavy_industry'))), And(GetVariableSystem.HasValue('sector_filter_active', 'military'), Or(EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_army')), Or(EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_conscription')), Or(EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_naval_administration')), Or(EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_naval_fortification')), Or(EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_naval_logistics_center')), Or(EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_military_industry')), EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_ship_construction'))))))))) ) ) ), Not(IsDataModelEmpty(BuildingBrowserBuildingTypeItem.GetBuildings))))]"
			datamodel_reuse_widgets = no
			datamodel = "[DataModelRepeatedItem(Select_int32(And(BuildingBrowserPanel.IsBuildingTypeExpanded(BuildingBrowserBuildingTypeItem.GetBuildingType), And(Or( Not(GetVariableSystem.Exists('sector_filter_active')), Or( And(GetVariableSystem.HasValue('sector_filter_active', 'light'), EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_light_industry'))), Or( And(GetVariableSystem.HasValue('sector_filter_active', 'heavy'), EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_heavy_industry'))), And(GetVariableSystem.HasValue('sector_filter_active', 'military'), Or(EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_army')), Or(EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_conscription')), Or(EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_naval_administration')), Or(EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_naval_fortification')), Or(EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_naval_logistics_center')), Or(EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_military_industry')), EqualTo_string(BuildingBrowserBuildingTypeItem.GetBuildingType.GetBuildingGroup.GetNameNoFormatting, Localize('bg_ship_construction'))))))))) ) ) ), Not(IsDataModelEmpty(BuildingBrowserBuildingTypeItem.GetBuildings)))), '(int32)1', '(int32)0'))]"
			item = {
				expanded_list = {
					block "expanded_list_visible" {
						visible = "[BuildingBrowserPanel.IsBuildingTypeExpanded(BuildingBrowserBuildingTypeItem.GetBuildingType)]"
					}
					using = expanded_list_bg
		
					blockoverride "dark_area_alpha" {
						alpha = 0.5
					}
		
					datamodel = "[BuildingBrowserBuildingTypeItem.GetBuildings]"
		
					item = {
						condensed_building_information = {
							background = {
								using = entry_bg_simple
							}
		
							background = {
								using = entry_bg_simple
							}
		
							blockoverride "action_buttons" {}
		
							blockoverride "extra_items_in_production_methods_list" {
								military_building_combat_unit_summary = {
									parentanchor = right|vcenter
		
									blockoverride "icon_size" {
										size = { 50 50 }
									}
		
									blockoverride "overlappingitembox_size" {
										size = { 190 50 }
									}
		
									blockoverride "unit_number_margins" {
										margin = { 6 3 }
									}
								}
							}
		
							blockoverride "company_owned_button" {
								button_icon_round = {
									visible = "[Building.IsBuildingType('building_company_headquarter')]"
									size = { 30 30 }
									datacontext = "[Building.GetCompany]"
									onclick = "[InformationPanelBar.OpenCompanyPanel(Company.Self)]"
									tooltip = "GO_TO_BUTTON_COMPANY"
									using = tooltip_ne
		
									blockoverride "icon" {
										texture = "[Company.GetCompanyType.GetIcon]"
									}
		
									blockoverride "icon_size" {
										size = { 75% 75% }
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
