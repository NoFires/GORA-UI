# Market balance charts: compact rows, skipping goods with the opposite sign.
# Inherits `gora_market_chart` for unified Victorian treemap styling and soft edge fade.
types market_panel {
	type gora_balance_value_chart = gora_market_chart {
		blockoverride "labels" {
			widget = {
				size = { 144 112 }
				parentanchor = vcenter

				scrollarea = {
					size = { 144 112 }
					scrollbarpolicy_horizontal = always_off
					alwaystransparent = no

					scrollwidget = {
						flowcontainer = {
							direction = vertical
							spacing = 0
							ignoreinvisible = yes
							block "datamodel" {}

							item = {
								widget = {
									size = { 128 28 }
									block "gora_balance_row_visibility" {}
									block "tooltip" {}
									block "pie_item_goto_button" {}

									icon = {
										position = { 3 6 }
										size = { 3 16 }
										texture = "/gfx/interface/piechart/piechart_legend.dds"
										block "color" {}
									}
									textbox = {
										position = { 9 2 }
										size = { 57 24 }
										align = left|nobaseline
										fontsize = 14
										fontsize_min = 11
										elide = right
										block "rightside1_info" {}
									}
									textbox = {
										position = { 66 2 }
										size = { 59 24 }
										align = right|nobaseline
										fontsize = 13
										fontsize_min = 10
										elide = right
										block "rightside2_info" {}
									}
								}
							}
						}
					}
					scrollbar_vertical = {
						using = vertical_scrollbar
					}
				}

				# Soft top/bottom fade to cushion mid-scroll edge clipping
				icon = {
					parentanchor = top|left
					size = { 128 8 }
					texture = "gfx/interface/backgrounds/dark_area.dds"
					alpha = 0.35
					alwaystransparent = yes

					modify_texture = {
						texture = "gfx/interface/masks/fade_vertical_bottom.dds"
						spriteType = Corneredstretched
						blend_mode = alphamultiply
					}
				}
				icon = {
					parentanchor = bottom|left
					size = { 128 8 }
					texture = "gfx/interface/backgrounds/dark_area.dds"
					alpha = 0.35
					alwaystransparent = yes

					modify_texture = {
						texture = "gfx/interface/masks/fade_vertical_top.dds"
						spriteType = Corneredstretched
						blend_mode = alphamultiply
					}
				}
			}
		}
	}
}
