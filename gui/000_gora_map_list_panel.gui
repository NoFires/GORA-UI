	type construction_filters = flowcontainer {
		direction = vertical

		section_header_button = {
			blockoverride "left_text" {
				text = "FILTERS"
				fontsize_min = 12
				elide = right
			}

			blockoverride "right_text" {
				section_header_right_text = {
					text = "CURRENT_CONSTRUCTION_FILTER_DESC"
				}
			}

			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle( 'construction_interaction_filters' )]"
			}

			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists( 'construction_interaction_filters' ))]"
			}

			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists( 'construction_interaction_filters' )]"
			}
		}

		flowcontainer = {
			visible = "[GetVariableSystem.Exists( 'construction_interaction_filters' )]"
			minimumsize = { @panel_width_plus_14 -1 }
			parentanchor = hcenter
			spacing = 10
			margin_bottom = 10

			background = {
				using = dark_area
			}

			flowcontainer = {
				direction = vertical

				textbox = {
					multiline = yes
					size = { 95 60 }
					text = "LOCATION"
					align = right|nobaseline
					margin_right = 10
					margin_left = 10
				}

				### GORA UI+ — "Status" column header for the state-filter strip
				textbox = {
					multiline = yes
					size = { 95 60 }
					text = "mod_filter_status"
					align = right|nobaseline
					margin_right = 10
					margin_left = 10
				}
				### /GORA UI+

				textbox = {
					multiline = yes
					size = { 95 60 }
					text = "LIST_ITEM"
					align = right|nobaseline
					margin_right = 10
					margin_left = 10
				}

				textbox = {
					multiline = yes
					size = { 95 60 }
					text = "WORKFORCE"
					align = right|nobaseline
					margin_right = 10
					margin_left = 10
				}
			}

			vertical_divider = {}

			flowcontainer = {
				direction = vertical
				margin_top = 10
				spacing = 20
				margin_left = 10

				flowcontainer = {
					spacing = 5

					filter_button = {
						visible = "[Not(MapListBuildingPanel.HasFilter('all'))]"
						size = { 132 40 }

						tooltip = "LOCATION_FILTER_ALL"
						using = tooltip_above

						blockoverride "text" {
							text = "ALL"
						}

						blockoverride "onclick" {
							onclick = "[MapListBuildingPanel.SetFilter('all')]"
							### GORA UI+ — also clear all state filters when the user
							### picks "All" in the building filter row. These onclicks
							### live inside `blockoverride "onclick"` so multi-action
							### fires correctly (V3 block-slot pattern).
							onclick = "[GetVariableSystem.Clear('show_only_incorporated')]"
							onclick = "[GetVariableSystem.Clear('show_only_unincorporated')]"
							onclick = "[GetVariableSystem.Clear('show_only_vassals')]"
							onclick = "[GetVariableSystem.Clear('show_only_efficient')]"
						}
					}

					filter_background_selected = {
						visible = "[MapListBuildingPanel.HasFilter('all')]"
						size = { 132 40 }

						blockoverride "text" {
							text = "ALL"
						}
					}

					filter_button = {
						visible = "[Not(MapListBuildingPanel.HasFilter('domestic'))]"
						size = { 132 40 }

						tooltip = "LOCATION_FILTER_DOMESTIC"
						using = tooltip_above

						blockoverride "text" {
							text = "DOMESTIC"
						}

						blockoverride "onclick" {
							onclick = "[MapListBuildingPanel.SetFilter('domestic')]"
						}
					}

					filter_background_selected = {
						visible = "[MapListBuildingPanel.HasFilter('domestic')]"
						size = { 132 40 }

						blockoverride "text" {
							text = "DOMESTIC"
						}
					}

					filter_button = {
						visible = "[Not(MapListBuildingPanel.HasFilter('abroad'))]"
						size = { 132 40 }

						tooltip = "LOCATION_FILTER_ABROAD"
						using = tooltip_above

						blockoverride "text" {
							text = "ABROAD"
						}

						blockoverride "onclick" {
							onclick = "[MapListBuildingPanel.SetFilter('abroad')]"
						}
					}

					filter_background_selected = {
						visible = "[MapListBuildingPanel.HasFilter('abroad')]"
						size = { 132 40 }

						blockoverride "text" {
							text = "ABROAD"
						}
					}
				}

				### GORA UI+ — State filter strip (icon row, left-aligned + right-aligned toggle)
				### Layout: 410x35, left flowcontainer hosts mutually-exclusive status
				### filters (All / Incorporated / Unincorporated / Vassals); right
				### flowcontainer hosts independent toggle filters (Efficient).
				### KNOWN LIMITATION: see file header — the per-button "set this and
				### clear siblings" onclick chains are direct properties, so only
				### the first onclick fires on a chain.
				widget = {
					size = { 410 35 }

					# LEFT: mutually-exclusive status filters
					flowcontainer = {
						parentanchor = left|vcenter
						spacing = 6

						# 1. "All" (reset) — visible while any status filter is active
						widget = {
							size = { 35 35 }

							button_icon_round = {
								visible = "[Or( GetVariableSystem.HasValue('show_only_incorporated', 'true'), Or( GetVariableSystem.HasValue('show_only_unincorporated', 'true'), GetVariableSystem.HasValue('show_only_vassals', 'true') ) )]"
								size = { 100% 100% }
								tooltip = "mod_filter_all_status_desc"
								onclick = "[GetVariableSystem.Clear('show_only_incorporated')]"
								onclick = "[GetVariableSystem.Clear('show_only_unincorporated')]"
								onclick = "[GetVariableSystem.Clear('show_only_vassals')]"
								onclick = "[GetVariableSystem.Clear('show_only_efficient')]"
								blockoverride "icon" { texture = "gfx/interface/icons/building_icons/building_browser_filter_icons/filter_icons_all.dds" }
							}

							# Selected (no status filters active) — clicking clears the
							# Efficient toggle as a convenience reset.
							button_icon_round_action = {
								visible = "[And( Not(GetVariableSystem.HasValue('show_only_incorporated', 'true')), And( Not(GetVariableSystem.HasValue('show_only_unincorporated', 'true')), Not(GetVariableSystem.HasValue('show_only_vassals', 'true')) ) )]"
								size = { 100% 100% }
								tooltip = "mod_filter_all_status_desc"
								onclick = "[GetVariableSystem.Clear('show_only_efficient')]"
								blockoverride "icon" { texture = "gfx/interface/icons/building_icons/building_browser_filter_icons/filter_icons_all.dds" }
							}
						}

						widget = { size = { 5 1 } }
						vertical_divider = { parentanchor = vcenter size = { 1 24 } }
						widget = { size = { 5 1 } }

						# 2. Incorporated
						widget = {
							size = { 35 35 }
							button_icon_round = {
								visible = "[Not(GetVariableSystem.HasValue('show_only_incorporated', 'true'))]"
								size = { 100% 100% }
								tooltip = "mod_filter_incorporated_desc"
								onclick = "[GetVariableSystem.Set('show_only_incorporated', 'true')]"
								onclick = "[GetVariableSystem.Clear('show_only_unincorporated')]"
								onclick = "[GetVariableSystem.Clear('show_only_vassals')]"
								blockoverride "icon" { texture = "gfx/interface/icons/state_status_icons/incorporated_state.dds" }
							}
							button_icon_round_action = {
								visible = "[GetVariableSystem.HasValue('show_only_incorporated', 'true')]"
								size = { 100% 100% }
								tooltip = "mod_filter_incorporated_desc"
								onclick = "[GetVariableSystem.Clear('show_only_incorporated')]"
								blockoverride "icon" { texture = "gfx/interface/icons/state_status_icons/incorporated_state.dds" }
							}
						}

						# 3. Unincorporated
						widget = {
							size = { 35 35 }
							button_icon_round = {
								visible = "[Not(GetVariableSystem.HasValue('show_only_unincorporated', 'true'))]"
								size = { 100% 100% }
								tooltip = "mod_filter_unincorporated_desc"
								onclick = "[GetVariableSystem.Set('show_only_unincorporated', 'true')]"
								onclick = "[GetVariableSystem.Clear('show_only_incorporated')]"
								onclick = "[GetVariableSystem.Clear('show_only_vassals')]"
								blockoverride "icon" { texture = "gfx/interface/icons/state_status_icons/unincorporated_state.dds" }
							}
							button_icon_round_action = {
								visible = "[GetVariableSystem.HasValue('show_only_unincorporated', 'true')]"
								size = { 100% 100% }
								tooltip = "mod_filter_unincorporated_desc"
								onclick = "[GetVariableSystem.Clear('show_only_unincorporated')]"
								blockoverride "icon" { texture = "gfx/interface/icons/state_status_icons/unincorporated_state.dds" }
							}
						}

						# 4. Subjects / vassals
						widget = {
							size = { 35 35 }
							button_icon_round = {
								visible = "[Not(GetVariableSystem.HasValue('show_only_vassals', 'true'))]"
								size = { 100% 100% }
								tooltip = "mod_filter_vassals_desc"
								onclick = "[GetVariableSystem.Set('show_only_vassals', 'true')]"
								onclick = "[GetVariableSystem.Clear('show_only_incorporated')]"
								onclick = "[GetVariableSystem.Clear('show_only_unincorporated')]"
								blockoverride "icon" { texture = "gfx/interface/icons/lens_toolbar_icons/protectorate.dds" }
							}
							button_icon_round_action = {
								visible = "[GetVariableSystem.HasValue('show_only_vassals', 'true')]"
								size = { 100% 100% }
								tooltip = "mod_filter_vassals_desc"
								onclick = "[GetVariableSystem.Clear('show_only_vassals')]"
								blockoverride "icon" { texture = "gfx/interface/icons/lens_toolbar_icons/protectorate.dds" }
							}
						}
					}

					# RIGHT: independent toggle filters
					flowcontainer = {
						parentanchor = right|vcenter
						spacing = 6

						# 5. Efficient regions — independent toggle, does NOT clear left-side filters
						widget = {
							size = { 35 35 }
							button_icon_round = {
								visible = "[Not(GetVariableSystem.HasValue('show_only_efficient', 'true'))]"
								size = { 100% 100% }
								tooltip = "mod_filter_efficient_desc"
								onclick = "[GetVariableSystem.Set('show_only_efficient', 'true')]"
								blockoverride "icon" { texture = "gfx/interface/icons/state_status_icons/has_construction.dds" }
							}
							button_icon_round_action = {
								visible = "[GetVariableSystem.HasValue('show_only_efficient', 'true')]"
								size = { 100% 100% }
								tooltip = "mod_filter_efficient_desc"
								onclick = "[GetVariableSystem.Clear('show_only_efficient')]"
								blockoverride "icon" { texture = "gfx/interface/icons/state_status_icons/has_construction.dds" }
							}
						}
					}
				}
				### /GORA UI+

				flowcontainer = {

					filter_button = {
						size = { 410 40 }

						blockoverride "text" {
							text = "CONSTRUCTION_CONDENSED_OR_FULL"
						}

						blockoverride "onclick" {
							onclick = "[GetVariableSystem.Toggle('construction_list_toggle_full_or_condensed')]"
						}
					}
				}

				flowcontainer = {
					spacing = 5


					filter_button = {
						size = { 132 40 }

						blockoverride "text" {
							text = "peasants_no_icon"
						}

						visible = "[And(Not(GetVariableSystem.HasValue('hide_peasants', 'false')), GetVariableSystem.Exists('hide_peasants'))]"

						blockoverride "onclick" {
							onclick = "[GetVariableSystem.Set('hide_peasants', 'false')]"
							onclick = "[GetVariableSystem.Set('show_unemployed', 'false')]"
							onclick = "[GetVariableSystem.Set('show_jobseekers', 'false')]"
						}
					}

					filter_background_selected = {
						visible = "[Not(GetVariableSystem.HasValue('hide_peasants', 'true'))]"
						size = { 132 40 }

						blockoverride "text" {
							text = "peasants_no_icon"
						}
					}

					filter_button = {
						size = { 132 40 }

						blockoverride "text" {
							text = "concept_jobseekers"
						}

						visible = "[Or(GetVariableSystem.HasValue('show_jobseekers', 'false'), Not(GetVariableSystem.Exists('show_jobseekers')))]"

						blockoverride "onclick" {
							onclick = "[GetVariableSystem.Set('hide_peasants', 'true')]"
							onclick = "[GetVariableSystem.Set('show_unemployed', 'false')]"
							onclick = "[GetVariableSystem.Set('show_jobseekers', 'true')]"
						}
					}

					filter_background_selected = {
						visible = "[GetVariableSystem.HasValue('show_jobseekers', 'true')]"
						size = { 132 40 }

						blockoverride "text" {
							text = "concept_jobseekers"
						}
					}

					filter_button = {
						size = { 132 40 }

						blockoverride "text" {
							text = "concept_unemployed"
						}

						visible = "[Or(GetVariableSystem.HasValue('show_unemployed', 'false'), Not(GetVariableSystem.Exists('show_unemployed')))]"

						blockoverride "onclick" {
							onclick = "[GetVariableSystem.Set('hide_peasants', 'true')]"
							onclick = "[GetVariableSystem.Set('show_unemployed', 'true')]"
							onclick = "[GetVariableSystem.Set('show_jobseekers', 'false')]"
						}
					}

					filter_background_selected = {
						visible = "[GetVariableSystem.HasValue('show_unemployed', 'true')]"
						size = { 132 40 }

						blockoverride "text" {
							text = "concept_unemployed"
						}
					}
				}
			}
		}

		widget = {
			visible = "[GetVariableSystem.Exists( 'construction_interaction_filters' )]"
			size = { 5 5 }
		}
	}


	### GORA UI+ — construction_interaction_item_full (CMF scrollarea + GORA trait cap)
	### Adopted CMF's `00_MPM_map_list_panel.gui:13` version verbatim (which wraps the
	### PMs widget in a horizontal scrollarea) and applied ONE GORA tweak:
	### the state-trait datamodel is wrapped with `DataModelFirst(..., 3)` so the
	### trait icon row stays within the construction queue row layout even when other
	### mods add 5+ state traits. Both features coexist in this single type — since
	### the file name `000_gora_*` sorts before `00_MPM_*`, this type registers first
	### and CMF's identical body gets the silent already-registered warning (CMF's
	### scrollarea is preserved here, not lost). Search this type body for
	### `DataModelFirst.*AccessTraits` to find the GORA tweak.

}

