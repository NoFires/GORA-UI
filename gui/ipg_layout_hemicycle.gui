	# -- Classic Hemicycle (100) - Power Structure IG --
	type ipg_hemicycle_100_power = widget {
		size = { 600 230 }
		datacontext = "[Scope.GetInterestGroup]"
		visible = "[And(InterestGroup.MakeScope.Var('power_seat_max').IsSet, InterestGroup.MakeScope.Var('power_seat_min').IsSet)]"
		icon = {
			texture = "gfx/interface/icons/ipg_white_circle.dds"
			tintcolor = "[InterestGroup.GetColor]"
			size = { 11 11 }
			position = { 229 189 }
			visible = "[And(GreaterThanOrEqualTo_CFixedPoint(InterestGroup.MakeScope.Var('power_seat_max').GetValue, '(CFixedPoint)0'), LessThanOrEqualTo_CFixedPoint(InterestGroup.MakeScope.Var('power_seat_min').GetValue, '(CFixedPoint)0'))]"
