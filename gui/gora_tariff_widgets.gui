			tooltip = "[SelectLocalization( GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('gora_tariffs_export_on_cooldown'), '(CFixedPoint)0' ), 'gora_tariffs_export_cooldown_tt', 'gora_tariffs_export_max_subventions_tt' )]"
