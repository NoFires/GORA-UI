	# Advisor compatibility hook. Advisor owns all automation logic; GORA+
	# contributes only the market-panel presentation slot. The short-lived
	# Advisor presence variable keeps this hidden when Advisor is not active.
	type gora_advisor_auto_export_hook_button = button_icon_round_toggle_action {
		visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('advisor_auto_export_available').GetValue, '(CFixedPoint)0')]"

		block "size" {
			size = { 32 32 }
		}

		block "tooltip" {
			tooltip = "[SelectLocalization( GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var('gora_auto_export_enabled').GetValue, '(CFixedPoint)0' ), 'advisor_auto_export_enabled_tt', 'advisor_auto_export_disabled_tt' )]"
		}

		block "enabled" {
			enabled = "[GetScriptedGui('advisor_auto_export_toggle_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}

		blockoverride "on_click" {
			onclick = "[GetScriptedGui('advisor_auto_export_toggle_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}

		blockoverride "view_1" {
			visible = "[Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('gora_auto_export_enabled').GetValue, '(CFixedPoint)0'))]"
		}

		blockoverride "view_2" {
			visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('gora_auto_export_enabled').GetValue, '(CFixedPoint)0')]"
		}

		blockoverride "icon_1" {
			texture = "gfx/interface/icons/trade_icons/exports.dds"
		}

		blockoverride "icon_2" {
			texture = "gfx/interface/icons/trade_icons/low_subvention.dds"
		}
	}

}
