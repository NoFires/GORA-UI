				onclick = "[GetScriptedGui('gora_tariffs_export_max_tariffs').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
		}
		gora_tariff_button_export = {
			tooltip = "[SelectLocalization( GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('gora_tariffs_export_on_cooldown'), '(CFixedPoint)0' ), 'gora_tariffs_export_cooldown_tt', 'gora_tariffs_export_high_tariffs_tt' )]"
			blockoverride "button_texture" { texture = "gfx/interface/icons/trade_icons/high_tariffs.dds" }
			blockoverride "click" {
