
types company_marker_types
{
	type v3_plotline_company_profit = v3_plotline {

		blockoverride "extra_plotlines" {

			widget = {
				size = { 100% 100% }
				scissor = yes
				visible = "[Not(IsEmpty(Company.GetProfitTrend))]"
				progressbar = {
					size = { 100% 100% }
					direction = vertical
					skip_initial_animation = yes
					progresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
					noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
					alwaystransparent = yes
					min = "[Min_CFixedPoint('(CFixedPoint)0', GetMinPadded(Company.GetProfitTrend))]"
					max = "[GetMaxPadded(Company.GetProfitTrend)]"
					value = "[Company.GetProfit]"
					marker = {
						icon = {
							texture = "gfx/interface/progressbar/progressbar_white_glow_line_vertical.dds"
							size = { 100% 3 }
							color = { 1 0.8 0.25 1 }
						}
					}
				}
			}

			widget = {
				size = { 100% 100% }
				position = { 0 6 }
				scissor = yes
				visible = "[Not(IsEmpty(Company.GetProfitTrend))]"
				progressbar = {
					size = { 100% 100% }
					direction = vertical
					skip_initial_animation = yes
					progresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
					noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
					alwaystransparent = yes
					min = "[Min_CFixedPoint('(CFixedPoint)0', GetMinPadded(Company.GetProfitTrend))]"
					max = "[GetMaxPadded(Company.GetProfitTrend)]"
					value = "[Company.GetProfit]"
					marker = {
						textbox = {
							widgetanchor = left|top
							parentanchor = left
							margin_left = -10
							size = { 60 14 }
							align = right|nobaseline
							using = fontsize_small
							raw_text = "#bold #yellow [Company.GetProfit|D]#!#!"
						}
					}
				}
			}

			widget = {
				size = { 100% 100% }
				position = { 0 22 }
				scissor = yes
				visible = "[GreaterThan_CFixedPoint(Subtract_CFixedPoint(GetMax(Company.GetProfitTrend), Company.GetProfit), '(CFixedPoint)0')]"
				progressbar = {
					size = { 100% 100% }
					direction = vertical
					skip_initial_animation = yes
					progresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
					noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
					alwaystransparent = yes
					min = "[Min_CFixedPoint('(CFixedPoint)0', GetMinPadded(Company.GetProfitTrend))]"
					max = "[GetMaxPadded(Company.GetProfitTrend)]"
					value = "[Company.GetProfit]"
					marker = {
						textbox = {
							widgetanchor = left|top
							parentanchor = left
							margin_left = -10
							size = { 60 14 }
							align = right|nobaseline
							using = fontsize_small
							raw_text = "#bold #red -[Subtract_CFixedPoint(GetMax(Company.GetProfitTrend), Company.GetProfit)|D]#!#!"
						}
					}
				}
			}
		}
	}
}


