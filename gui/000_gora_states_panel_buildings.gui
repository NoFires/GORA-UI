# GORA UI+ — state_panel_buildings_fixed_bottom + state_panel_buildings_content (partial type override)
# ─────────────────────────────────────────────────────────────────────────────
# This file merges FOUR sources into a single partial-type override:
#   (a) Vanilla 1.13.9 baseline (gui/states_panel_buildings.gui)
#   (b) CMF additions (com_owner_building_header_list / _list hooks and the
#       local-goods scripted_gui harvester + 3-column display grid)
#   (c) Expanded grid items (expanded_building_grid_*_building_item types defined
#       in gui/gora_expanded_building_grid.gui)
#   (d) Collapsable Buildings List logic (adds minimize buttons to section headers
#       and toggles grid/list visibility based on variable states).
#
# Source: CMF author's compat patch "Community Mod Framework Expanded Building Grid"
# (Steam workshop id 3410439297, gui/000_com_gui_state_buildings.gui) — that file
# already merged CMF + Expanded Grid the right way. We port it verbatim, then
# apply GORA-specific tweaks and the Collapsable Buildings logic on top.
#
# Types redeclared:
#   - state_panel_buildings_fixed_bottom (vanilla `state_panel_types`)
#   - state_panel_buildings_content (vanilla `state_panel_types`)
#   - button_minimize_section (from Collapsable Buildings List)
#   - com_owner_building_header_list (CMF helper, redefined here so it survives
#     if CMF's file load-loses to us; identical body to CMF's definition)
#   - com_owner_building_list (same)
# Vanilla types not touched (buildings_list, buildings_list_item) are inherited
# from vanilla unchanged — we do NOT re-emit the `types state_buildings { ... }`
# namespace.
#
# GORA deltas preserved from the compat patch baseline:
#   (1) Infrastructure / Tax Capacity quick-build strip — sits INSIDE the labor
#       container (centered, position { 15 4 }). Tooltips reference building_railway
#       and building_government_administration. This is the placement the user
#       expected (the empty center area of the labor container).
#   (2) Urban header rows use expanded_building_grid_header_building_item /
#       _trade_building_item for urban_center and trade_center; manor_house and
#       financial_district stay on vanilla header_building_item.
#   (3) All four building grids render expanded_building_grid_building_item items
#       with addrow=255 (vanilla 210) to fit the richer cell layout.
#
# GORA-specific tweaks applied on top of the compat patch:
#   - Development section: building_naval_base → building_naval_administration
#     (1.13 ship overhaul added bg_naval_administration; we surface that newer
#     building. Affects 2 references: the grid-view header (visible=no anyway)
#     and the list-view buildings_list_item entry.)
#   - Corresponding text key TOTAL_NAVAL_BASE → TOTAL_NAVAL_ADMINISTRATION
#     (header is hidden so the text is cosmetic, but kept consistent).
#
# CMF extension hooks ALWAYS active here (regardless of which 3rd-party mods
# the user has installed):
#   - com_owner_building_header_list = {} (header section, hidden when the global
#     list com_custom_owner_buildings is empty)
#   - com_owner_building_list = {} (list section, same gate)
#   - 3-column dynamicgridbox displaying StatesPanel.AccessLocalGoods directly
# Both hooks no-op cleanly when CMF is not loaded.
#
# Re-sync recipe when Paradox bumps states_panel_buildings.gui or CMF bumps
# their compat patch: take the new compat patch, replace this file's type
# bodies, re-apply the naval_administration rename and the collapsible logic.
# ─────────────────────────────────────────────────────────────────────────────

# Parser-level @constants — file-scoped in V3. Only @panel_width is referenced
# in the extracted bodies (@green_checkmark / @red_cross are text-icons, not
# parser constants).
@panel_width = 540

types gora_state_buildings_with_cmf {

	type state_panel_buildings_fixed_bottom = flowcontainer {
		direction = vertical
		margin = { 10 5 }
		minimumsize = { @panel_width -1 }
		spacing = 4

		background = {
			using = entry_bg_simple
		}

		container = {
			tooltip = "STATE_AVAILABLE_LABOR_TOOLTIP"
			minimumsize = { 520 -1 }

			flowcontainer = {
				direction = vertical

				flowcontainer = {
					spacing = 7
					tooltip = "[State.GetJobseekersDesc]"

					textbox = {
						text = "JOBSEEKERS"
						autoresize = yes
						align = nobaseline
						elide = right
						maximumsize = { 130 -1 }
					}

					textbox = {
						raw_text = "#variable [State.GetNumJobseekers|D]#!"
						autoresize = yes
						align = nobaseline
					}
				}

				flowcontainer = {
					spacing = 7
					parentanchor = right|vcenter
					margin_right = 10

					textbox = {
						raw_text = "[concept_pop_qualifications]: "
						autoresize = yes
						align = nobaseline
						elide = right
						maximumsize = { 130 -1 }
					}

					textbox = {
						visible = "[Not(State.HasInsufficientQualificationsForAvailablePositions)]"
						raw_text = "@green_checkmark!"
						autoresize = yes
						align = nobaseline
						maximumsize = { 130 -1 }
						tooltip = "[State.GetPotentialQualificationsDesc]"
					}

					textbox = {
						visible = "[State.HasInsufficientQualificationsForAvailablePositions]"
						raw_text = "@red_cross!"
						autoresize = yes
						align = nobaseline
						maximumsize = { 130 -1 }
						tooltip = "[State.GetPotentialQualificationsDesc]"
					}
				}
			}

			flowcontainer = {
				direction = vertical
				parentanchor = right|vcenter

				flowcontainer = {
					spacing = 7
					parentanchor = right
					textbox = {
						raw_text = "[GetPopType('peasants').GetName]:"
						autoresize = yes
						align = nobaseline
						elide = right
					}

					textbox = {
						text = "[State.GetNumSubsistenceWorkingAdults|Dv]"
						autoresize = yes
						align = nobaseline
					}
				}

				flowcontainer = {
					spacing = 7
					parentanchor = right
					textbox = {
						raw_text = "[concept_unemployed]:"
						autoresize = yes
						align = nobaseline
						elide = right
					}

					textbox = {
						text = "[State.GetNumUnemployedWorkingAdults|Dv]"
						autoresize = yes
						align = nobaseline
					}
				}
			}

			### GORA UI+ — Infrastructure / Tax Capacity quick-build strip
			### Placed in the CENTER of the labor container (between the left
			### Jobseekers/Qualifications column and the right Peasants/Unemployed
			### column). CMF and the vanilla `state_panel_buildings_fixed_bottom`
			### leave this area empty — verified safe to use, no extension hooks
			### or placeholders conflict. Big readable labels (concept_infrastructure
			### / concept_tax_capacity) over 32x32 action buttons; clicking the
			### buttons queues building_railway / building_government_administration.
			flowcontainer = {
				parentanchor = hcenter|vcenter
				direction = horizontal
				spacing = 40
				ignoreinvisible = yes

				### Infrastructure column
				flowcontainer = {
					parentanchor = vcenter
					direction = vertical
					spacing = 3

					textbox = {
						parentanchor = hcenter
						raw_text = "[concept_infrastructure]"
						autoresize = yes
						align = nobaseline
						fontsize_min = 12
						elide = right
					}

					flowcontainer = {
						parentanchor = hcenter
						direction = horizontal
						spacing = 5

						button_icon_round_action = {
							size = { 32 32 }
							parentanchor = vcenter
							tooltip = "[StatesPanel.AccessBuilding('building_railway').GetQueueConstructionTooltip]"
							enabled = "[IsValid( StatesPanel.AccessBuilding('building_railway').QueueConstruction )]"
							onclick = "[Execute( StatesPanel.AccessBuilding('building_railway').QueueConstruction )]"

							blockoverride "icon" {
								texture = "gfx/interface/icons/state_status_icons/state_infrastructure.dds"
							}
						}

						textbox = {
							parentanchor = vcenter
							align = left|nobaseline
							autoresize = yes
							minimumsize = { 50 -1 }
							raw_text = "#tooltip:[State.GetTooltipTag],STATE_INFRASTRUCTURE_DESC [Subtract_CFixedPoint(State.GetInfrastructure, State.GetInfrastructureUsage)|0+=*]#!#!"
							fontsize = 20
						}
					}
				}

				### Tax Capacity column
				flowcontainer = {
					parentanchor = vcenter
					direction = vertical
					spacing = 3

					textbox = {
						parentanchor = hcenter
						raw_text = "[concept_tax_capacity]"
						autoresize = yes
						align = nobaseline
						fontsize_min = 12
						elide = right
					}

					flowcontainer = {
						parentanchor = hcenter
						direction = horizontal
						spacing = 5

						button_icon_round_action = {
							size = { 32 32 }
							parentanchor = vcenter
							tooltip = "[StatesPanel.AccessBuilding('building_government_administration').GetQueueConstructionTooltip]"
							enabled = "[IsValid( StatesPanel.AccessBuilding('building_government_administration').QueueConstruction )]"
							onclick = "[Execute( StatesPanel.AccessBuilding('building_government_administration').QueueConstruction )]"

							blockoverride "icon" {
								texture = "gfx/interface/icons/state_status_icons/state_tax_capacity.dds"
							}
						}

						textbox = {
							parentanchor = vcenter
							align = left|nobaseline
							autoresize = yes
							minimumsize = { 50 -1 }
							raw_text = "#tooltip:[State.GetTooltipTag],STATE_TAX_CAPACITY_DESC [Subtract_CFixedPoint(State.CalcTaxCapacity, State.CalcTaxCapacityUsage)|0+=*]#!#!"
							fontsize = 20
						}
					}
				}
			}
		}

		### Vanilla / CMF divider between labor container and local-goods grid
		### (restored — was inadvertently dropped during an earlier refactor).
		divider_clean = {
			maximumsize = { 520 -1 }
		}

		dynamicgridbox = {
			datamodel = "[StatesPanel.AccessLocalGoods]"
			maximumsize = { 520 -1 }
			minimumsize = { 520 25 }
			datamodel_wrap = 3
			flipdirection = yes

			item = {
				widget = {
					# Match vanilla's Local Goods guard on the physical grid item so
					# state transitions cannot leave a non-local or blank cell behind.
					visible = "[Goods.IsLocal]"
					size = { 170 25 }
					textbox = {
						size = { 170 25 }
						raw_text = "STATE_BUILDING_TAB_LOCAL_GOODS_INFO"
						align = center|nobaseline

						tooltipwidget = {
							FancyTooltip_Goods = {}
						}
					}
				}
			}
		}

	}

	# Overwritten because:
	# Added custom owner buildings
	# Added collapsable sections logic
	type state_panel_buildings_content = flowcontainer {
		ignoreinvisible = yes
		direction = vertical
		using = default_list_position
		spacing = 10

		default_header_2texts = {
			visible = no
			blockoverride "text1" {
				text = "BUILDINGS"
			}
		}

		default_header = {
			blockoverride "text" {
				text = "URBAN_PART_OF_STATE"
			}

			# minimize toggle
			button_minimize_section = {
				# expanded state logic
				blockoverride "view_expanded" {
					visible = "[Not(GetVariableSystem.Exists('minimize_urban_buildings'))]"
				}
				blockoverride "click_collapse" {
					onclick = "[GetVariableSystem.Set('minimize_urban_buildings', 'yes')]"
				}
				
				# collapsed state logic
				blockoverride "view_collapsed" {
					visible = "[GetVariableSystem.Exists('minimize_urban_buildings')]"
				}
				blockoverride "click_expand" {
					onclick = "[GetVariableSystem.Clear('minimize_urban_buildings')]"
				}
			}

			# grid/list toggle
			button_icon_round_toggle = {
				size = { 29 29 }
				parentanchor = right|vcenter
				position = { -10 0 }

				blockoverride "on_click" {
					onclick = "[GetVariableSystem.Toggle('buildings_list')]"
				}
				blockoverride "view_1" {
					visible = "[Not(GetVariableSystem.Exists('buildings_list'))]"
				}
				blockoverride "view_2" {
					visible = "[GetVariableSystem.Exists('buildings_list')]"
				}
				blockoverride "icon_1" {
					texture = "gfx/interface/buttons/button_icons/grid.dds"
				}
				blockoverride "icon_2" {
					texture = "gfx/interface/buttons/button_icons/list.dds"
				}
				blockoverride "tooltip_1" {
					tooltip = "TOOLTIP_VIEW_LIST"
				}
				blockoverride "tooltip_2" {
					tooltip = "TOOLTIP_VIEW_GRID"
				}
			}
		}

		### URBAN BUILDINGS
		flowcontainer = {
			parentanchor = hcenter
			direction = vertical
			visible = "[And(Not(GetVariableSystem.Exists('buildings_list')), Not(GetVariableSystem.Exists('minimize_urban_buildings')))]"
			using = default_content_fade
			spacing = 10

			flowcontainer = {
				parentanchor = hcenter
				direction = vertical

				divider_clean = {}

				expanded_building_grid_header_building_item = {
					datacontext = "[StatesPanel.AccessBuilding('building_urban_center')]"

					tooltipwidget = {
						FancyTooltip_Building = {}
					}

					blockoverride "text" {
						text = "TOTAL_URBAN_CENTERS"
					}
				}

				divider_clean = {
					visible = "[GreaterThan_int32(StatesPanel.AccessBuilding('building_trade_center').GetExpansionLevel, '(int32)0')]"
				}

				expanded_building_grid_header_trade_building_item = {
					visible = "[GreaterThan_int32(Building.GetExpansionLevel, '(int32)0')]"
					datacontext = "[StatesPanel.AccessBuilding('building_trade_center')]"

					tooltipwidget = {
						FancyTooltip_Building = {}
					}

					blockoverride "text" {
						text = "TOTAL_TRADE_CENTER"
					}
				}

				divider_clean = {
					visible = "[GreaterThan_int32(StatesPanel.AccessBuilding('building_manor_house').GetExpansionLevel, '(int32)0')]"
				}

				header_building_item = {
					visible = "[GreaterThan_int32(Building.GetExpansionLevel, '(int32)0')]"
					datacontext = "[StatesPanel.AccessBuilding('building_manor_house')]"

					tooltipwidget = {
						FancyTooltip_Building = {}
					}

					blockoverride "text" {
						text = "TOTAL_MANOR_HOUSE"
					}
				}

				divider_clean = {
					visible = "[GreaterThan_int32(StatesPanel.AccessBuilding('building_financial_district').GetExpansionLevel, '(int32)0')]"
				}

				header_building_item = {
					visible = "[GreaterThan_int32(Building.GetExpansionLevel, '(int32)0')]"
					datacontext = "[StatesPanel.AccessBuilding('building_financial_district')]"

					tooltipwidget = {
						FancyTooltip_Building = {}
					}

					blockoverride "text" {
						text = "TOTAL_FINANCIAL_DISTRICT"
					}
				}

				com_owner_building_header_list = {}

				divider_clean = {}
			}

			### URBAN BUILDINGS GRID VERSION
			container = {
				datamodel = "[State.AccessCappedRuralBuildings]"

				dynamicgridbox = {
					name = "urban_building_list"
					datamodel = "[State.AccessUrbanBuildings]"
					datamodel_wrap = 4
					flipdirection = yes

					item = {
						expanded_building_grid_building_item = {}
					}
				}

				widget = {
					size = { 135 180 }
					visible = "[GetPlayer.HasForeignInvestmentRights(State.GetOwner)]"
					enabled = "[GreaterThan_int32( StatesPanel.AccessState.GetNumConstructableUrbanBuildings,'(int32)0')]"
					position = "[StatesPanel.CalcBuildUrbanBuildingsButtonPosition]"

					button_icon_plus_square = {
						enabled = "[Not(IsDataModelEmpty(StatesPanel.GetState.GetPotentialUrbanBuildings))]"
						size = { 135 170 }
						tooltip = "BUILD_URBAN_BUILDING"
						onclick = "[StatesPanel.ToggleBuildUrbanBuildingsMenu(PdxGuiWidget.AccessSelf)]"


						blockoverride "icon_size" {
							size = { 80 80 }
						}
					}

					textbox = {
						using = fontsize_mega
						raw_text = "#BOLD [StatesPanel.AccessState.GetNumConstructableUrbanBuildings|+]#!"
						parentanchor = right
						align = hcenter|nobaseline
						autoresize = yes
						position = { -12 4 }

						background = {
							using = blurry_dark_background
						}
					}
				}
			}
		}

		### URBAN BUILDINGS LIST VERSION
		flowcontainer = {
			visible = "[And(GetVariableSystem.Exists('buildings_list'), Not(GetVariableSystem.Exists('minimize_urban_buildings')))]"
			parentanchor = hcenter
			direction = vertical
			using = default_content_fade

			buildings_list_item = {
				datacontext = "[StatesPanel.AccessBuilding('building_urban_center')]"
			}

			buildings_list_item = {
				visible = "[GreaterThan_int32(Building.GetExpansionLevel, '(int32)0')]"
				datacontext = "[StatesPanel.AccessBuilding('building_trade_center')]"
			}

			buildings_list_item = {
				visible = "[GreaterThan_int32(Building.GetExpansionLevel, '(int32)0')]"
				datacontext = "[StatesPanel.AccessBuilding('building_manor_house')]"
			}

			buildings_list_item = {
				visible = "[GreaterThan_int32(Building.GetExpansionLevel, '(int32)0')]"
				datacontext = "[StatesPanel.AccessBuilding('building_financial_district')]"
			}

			com_owner_building_list = {}

			buildings_list = {
				blockoverride "datamodel" {
					datamodel = "[State.AccessUrbanBuildings]"
				}
			}

			button_icon_plus_square = {
				visible = "[State.GetCountry.IsLocalPlayer]"
				enabled = "[GreaterThan_int32( StatesPanel.AccessState.GetNumConstructableUrbanBuildings,'(int32)0')]"
				size = { @panel_width 45 }
				tooltip = "BUILD_URBAN_BUILDING"
				onclick = "[StatesPanel.ToggleBuildUrbanBuildingsMenu(PdxGuiWidget.AccessSelf)]"
				blockoverride "icon_size" {
					size = { 45 100% }
				}

				textbox = {
					using = fontsize_large
					raw_text = "#BOLD [StatesPanel.AccessState.GetNumConstructableUrbanBuildings|+]#!"
					parentanchor = right
					align = hcenter|nobaseline
					autoresize = yes
					position = { -10 2 }

					background = {
						using = blurry_dark_background
					}
				}
			}
		}

		### RESOURCE BUILDINGS
		default_header = {
			visible = "[Not(IsDataModelEmpty( State.AccessCappedRuralBuildings ))]"
			blockoverride "text" {
				text = "RESOURCE"
			}
			
			# minimize toggle
			button_minimize_section = {
				blockoverride "view_expanded" {
					visible = "[Not(GetVariableSystem.Exists('minimize_resource_buildings'))]"
				}
				blockoverride "click_collapse" {
					onclick = "[GetVariableSystem.Set('minimize_resource_buildings', 'yes')]"
				}
				blockoverride "view_collapsed" {
					visible = "[GetVariableSystem.Exists('minimize_resource_buildings')]"
				}
				blockoverride "click_expand" {
					onclick = "[GetVariableSystem.Clear('minimize_resource_buildings')]"
				}
			}
		}

		flowcontainer = {
			parentanchor = hcenter
			minimumsize = { @panel_width -1 }
			direction = vertical
			visible = "[And(Not(GetVariableSystem.Exists('buildings_list')), Not(GetVariableSystem.Exists('minimize_resource_buildings')))]"
			using = default_content_fade

			fixedgridbox = {
				datamodel = "[State.AccessCappedRuralBuildings]"
				addcolumn = 135
				addrow = 255
				datamodel_wrap = 4
				flipdirection = yes

				item = {
					expanded_building_grid_building_item = {
					}
				}
			}
		}

		### RESOURCE LIST VERSION
		flowcontainer = {
			visible = "[And(And(GetVariableSystem.Exists('buildings_list'), Not(IsDataModelEmpty(State.AccessCappedRuralBuildings))), Not(GetVariableSystem.Exists('minimize_resource_buildings')))]"
			using = default_content_fade
			parentanchor = hcenter
			direction = vertical

			buildings_list = {
				blockoverride "datamodel" {
					datamodel = "[State.AccessCappedRuralBuildings]"
				}
			}
		}

		### AGRICULTURE
		default_header = {
			blockoverride "text" {
				text = "AGRICULTURE"
			}
			
			# minimize toggle
			button_minimize_section = {
				blockoverride "view_expanded" {
					visible = "[Not(GetVariableSystem.Exists('minimize_agriculture_buildings'))]"
				}
				blockoverride "click_collapse" {
					onclick = "[GetVariableSystem.Set('minimize_agriculture_buildings', 'yes')]"
				}
				blockoverride "view_collapsed" {
					visible = "[GetVariableSystem.Exists('minimize_agriculture_buildings')]"
				}
				blockoverride "click_expand" {
					onclick = "[GetVariableSystem.Clear('minimize_agriculture_buildings')]"
				}
			}
		}

		flowcontainer = {
			visible = "[And(Not(GetVariableSystem.Exists('buildings_list')), Not(GetVariableSystem.Exists('minimize_agriculture_buildings')))]"
			using = default_content_fade
			minimumsize = { @panel_width -1 }
			using = default_list_position
			direction = vertical
			spacing = 10

			flowcontainer = {
				parentanchor = hcenter
				direction = vertical

				divider_clean = {}

				### UNUSED ARABLE LAND
				expanded_building_grid_header_building_item = {

					tooltipwidget = {
						FancyTooltip_Building = {}
					}

					#tooltip = "LAND_TEXT_TOOLTIP"
					datacontext = "[StatesPanel.AccessSubsistenceBuilding]"

					blockoverride "text" {
						text = "UNUSED_ARABLE"
					}
					
					blockoverride "building_levels_textbox" {
						flowcontainer = {
							parentanchor = vcenter
							textbox = {
								parentanchor = vcenter
								align = nobaseline
								autoresize = yes
								using = fontsize_xl
								default_format = "#tooltippable"
								using = tooltip_ne
								tooltip = "LAND_TEXT_TOOLTIP"
								text = "[Building.GetState.GetNumBaseFreeArableLand]"
							}

							widget = { size = { 5 5 } }

							textbox = {
								parentanchor = vcenter
								visible = "[GreaterThan_int32(Building.GetState.GetNumArableLandReservedForSubsistence,'(int32)0')]"
								align = nobaseline
								autoresize = yes
								text = "UNDEVELOPED_ARABLE_LAND"
							}
						}
					}
				}

				divider_clean = {}
			}

			fixedgridbox = {
				datamodel = "[State.AccessUncappedRuralBuildings]"
				addcolumn = 135
				addrow = 255
				datamodel_wrap = 4
				flipdirection = yes

				item = {
					expanded_building_grid_building_item = {
					}
				}
			}
		}

		### AGRICULTURE LIST VERSION
		flowcontainer = {
			direction = vertical
			using = default_list_position
			visible = "[And(GetVariableSystem.Exists('buildings_list'), Not(GetVariableSystem.Exists('minimize_agriculture_buildings')))]"
			using = default_content_fade

			buildings_list = {
				blockoverride "datamodel" {
					datamodel = "[State.AccessUncappedRuralBuildings]"
				}
			}

			buildings_list_item = {
				datacontext = "[StatesPanel.AccessSubsistenceBuilding]"
			}
		}

		### DEVELOPMENT
		default_header = {
			blockoverride "text" {
				text = "INFRA_PART_OF_STATE"
			}
			
			# minimize toggle
			button_minimize_section = {
				blockoverride "view_expanded" {
					visible = "[Not(GetVariableSystem.Exists('minimize_development_buildings'))]"
				}
				blockoverride "click_collapse" {
					onclick = "[GetVariableSystem.Set('minimize_development_buildings', 'yes')]"
				}
				blockoverride "view_collapsed" {
					visible = "[GetVariableSystem.Exists('minimize_development_buildings')]"
				}
				blockoverride "click_expand" {
					onclick = "[GetVariableSystem.Clear('minimize_development_buildings')]"
				}
			}
		}

		state_panel_button_unclickable = {
			visible = "[And(Not(GetVariableSystem.Exists('buildings_list')), Not(GetVariableSystem.Exists('minimize_development_buildings')))]"
			using = default_list_position
			using = default_content_fade

			container = {
				minimumsize = { @panel_width -1 }
				resizeparent = yes

				flowcontainer = {
					direction = vertical
					spacing = 10

					flowcontainer = {
						parentanchor = hcenter
						direction = vertical

						divider_clean = {
							visible = no
						}

						header_building_item = {
							visible = no
							datacontext = "[StatesPanel.AccessBuilding('building_barrack')]"

							tooltipwidget = {
								FancyTooltip_Building = {}
							}

							blockoverride "text" {
								text = "TOTAL_BARRACKS"
							}
						}

						divider_clean = {}

						header_building_item = {
							datacontext = "[StatesPanel.AccessBuilding('building_conscription_center')]"

							tooltipwidget = {
								FancyTooltip_Building = {}
							}

							blockoverride "text" {
								text = "TOTAL_CONSCRIPTION_CENTER"
							}
						}

						divider_clean = {}

						header_building_item = {
							visible = no
							datacontext = "[StatesPanel.AccessBuilding('building_naval_administration')]"

							tooltipwidget = {
								FancyTooltip_Building = {}
							}

							blockoverride "text" {
								text = "TOTAL_NAVAL_ADMINISTRATION"
							}
						}

						divider_clean = {
							visible = no
						}
					}

					fixedgridbox = {
						datamodel = "[State.AccessDevelopmentBuildings]"
						addcolumn = 135
						addrow = 255
						datamodel_wrap = 4
						flipdirection = yes

						item = {
							expanded_building_grid_building_item = {}
						}
					}
				}
			}
		}

		### DEVELOPMENT LIST VERSION
		flowcontainer = {
			visible = "[And(GetVariableSystem.Exists('buildings_list'), Not(GetVariableSystem.Exists('minimize_development_buildings')))]"
			using = default_content_fade
			margin_top = 5
			margin_bottom = 10
			direction = vertical
			parentanchor = hcenter
			
			buildings_list_item = {
				datacontext = "[StatesPanel.AccessBuilding('building_barrack')]"
			}

			buildings_list_item = {
				datacontext = "[StatesPanel.AccessBuilding('building_conscription_center')]"
			}

			buildings_list_item = {
				datacontext = "[StatesPanel.AccessBuilding('building_naval_administration')]"
			}

			buildings_list = {
				blockoverride "datamodel" {
					datamodel = "[State.AccessDevelopmentBuildings]"
				}
			}
		}
	}

	type button_minimize_section = widget {
		size = { 25 25 }
		parentanchor = left|vcenter
		position = { 10 0 }

		# click to collapse the corresponding section
		button_icon_round = {
			size = { 100% 100% }
			
			block "view_expanded" {}
			
			block "click_collapse" {}
			
			# shift+click to collapse all sections
			click_modifiers = {
				onshift = "[GetVariableSystem.Set('minimize_urban_buildings', 'yes')]"
				onshift = "[GetVariableSystem.Set('minimize_resource_buildings', 'yes')]"
				onshift = "[GetVariableSystem.Set('minimize_agriculture_buildings', 'yes')]"
				onshift = "[GetVariableSystem.Set('minimize_development_buildings', 'yes')]"
			}

			blockoverride "icon" {
				texture = "gfx/interface/buttons/expand_arrow_expanded.dds"
			}
			tooltip = "STATE_PANEL_BUILDINGS_COLLAPSE"
		}

		# click to expand the corresponding section
		button_icon_round = {
			size = { 100% 100% }
			
			block "view_collapsed" {}
			
			block "click_expand" {}
			
			# shift+click to expand all sections
			click_modifiers = {
				onshift = "[GetVariableSystem.Clear('minimize_urban_buildings')]"
				onshift = "[GetVariableSystem.Clear('minimize_resource_buildings')]"
				onshift = "[GetVariableSystem.Clear('minimize_agriculture_buildings')]"
				onshift = "[GetVariableSystem.Clear('minimize_development_buildings')]"
			}

			blockoverride "icon" {
				texture = "gfx/interface/buttons/expand_arrow.dds"
			}
			tooltip = "STATE_PANEL_BUILDINGS_EXPAND"
		}
	}

	type com_owner_building_header_list = container {
		visible = "[DataModelHasItems(GetGlobalList('com_custom_owner_buildings'))]"
		datamodel = "[GetGlobalList('com_custom_owner_buildings')]"

		item = {
			container = {
				datacontext = "[StatesPanel.AccessBuilding(Scope.GetBuildingType.GetKey)]"
				divider_clean = {
					visible = "[GreaterThan_int32(Building.GetExpansionLevel, '(int32)0')]"
				}

				header_building_item = {
					visible = "[GreaterThan_int32(Building.GetExpansionLevel, '(int32)0')]"

					tooltipwidget = {
						FancyTooltip_Building = {}
					}

					blockoverride "text" {
						text = com_gui_total_building
					}
				}
			}
		}
	}

	type com_owner_building_list = container {
		visible = "[DataModelHasItems(GetGlobalList('com_custom_owner_buildings'))]"
		datamodel = "[GetGlobalList('com_custom_owner_buildings')]"

		item = {
			container = {
				datacontext = "[StatesPanel.AccessBuilding(Scope.GetBuildingType.GetKey)]"
				buildings_list_item = {
					visible = "[GreaterThan_int32(Building.GetExpansionLevel, '(int32)0')]"
				}
			}
		}
	}
}
