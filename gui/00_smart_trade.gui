							parentanchor = hcenter
							alwaystransparent = yes

							block "highlight_glow" {}

							button = {
								size = { 40 40 }
								parentanchor = hcenter
								alwaystransparent = yes

								block "texture" {
									texture = "gfx/interface/icons/generic_icons/generic_concept_icon.dds"
								}
							}
						}
					}

					blockoverride "additional_widgets" {
						### SMART TRADE: best weekly gain for this good (estimate).
						### The figures inside are hover-transparent, so each
						### fixed-size widget carries the tooltip. Nested so a
						### hidden branch's tests never run: the stored figure
						### first, the live search only when there is none.
						container = {
							parentanchor = top|left
							position = { 5 2 }

							container = {
								### The figure stored when the card was created
								### (whole units; see LAZY_STEP1 in the generator).
								widget = {
									visible = "[And(GetVariableSystem.Exists(Concatenate4('st_g_', ArticleDraft.GetSecondOrTarget.GetIDString, '_', Goods.GetKey)), Not(GetVariableSystem.HasValue(Concatenate4('st_g_', ArticleDraft.GetSecondOrTarget.GetIDString, '_', Goods.GetKey), 'n')))]"
									size = { 60 16 }
									tooltipwidget = { smart_trade_card_tooltip = {} }
									textbox = {
										autoresize = yes
										align = nobaseline
										using = fontsize_small
										alwaystransparent = yes
										raw_text = "@money!#P +[GetVariableSystem.Get(Concatenate4('st_g_', ArticleDraft.GetSecondOrTarget.GetIDString, '_', Goods.GetKey))]#!"
									}
								}
								### No stored figure (no hook ran): computed live,
								### one border test per card picking land or sea.
								container = {
									visible = "[Not(GetVariableSystem.Exists(Concatenate4('st_g_', ArticleDraft.GetSecondOrTarget.GetIDString, '_', Goods.GetKey)))]"
									container = {
										visible = "[GetScriptedGui('st_markets_adjacent_sgui').IsValid(GuiScope.SetRoot(ArticleDraft.GetFirstOrSource.MakeScope).AddScope('st_other', ArticleDraft.GetSecondOrTarget.MakeScope).End)]"
										widget = {
											visible = "[And(And(ArticleDraft.HasType('goods_transfer'), ArticleDraft.GetFirstOrSource.IsLocalPlayer), GreaterThan_CFixedPoint(Multiply_CFixedPoint('(CFixedPoint)10', Subtract_CFixedPoint(Multiply_CFixedPoint(Multiply_CFixedPoint(Goods.GetBasePrice, '(CFixedPoint)0.75'), Subtract_CFixedPoint(Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Subtract_CFixedPoint(Goods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, Add_CFixedPoint(Goods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders, '(CFixedPoint)10')), Max_CFixedPoint(Min_CFixedPoint(Goods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, Add_CFixedPoint(Goods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders, '(CFixedPoint)10')), '(CFixedPoint)0.01')), '(CFixedPoint)1'), '(CFixedPoint)-1'), Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Subtract_CFixedPoint(Add_CFixedPoint(Goods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders, '(CFixedPoint)10'), Goods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders), Max_CFixedPoint(Min_CFixedPoint(Add_CFixedPoint(Goods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders, '(CFixedPoint)10'), Goods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders), '(CFixedPoint)0.01')), '(CFixedPoint)1'), '(CFixedPoint)-1'))), '(CFixedPoint)0')), '(CFixedPoint)0'))]"
											size = { 60 16 }
											tooltipwidget = { smart_trade_card_tooltip = {} }
											smart_trade_best_gain_land = {}
										}
									}
									container = {
										visible = "[Not(GetScriptedGui('st_markets_adjacent_sgui').IsValid(GuiScope.SetRoot(ArticleDraft.GetFirstOrSource.MakeScope).AddScope('st_other', ArticleDraft.GetSecondOrTarget.MakeScope).End))]"
										widget = {
											visible = "[And(And(ArticleDraft.HasType('goods_transfer'), ArticleDraft.GetFirstOrSource.IsLocalPlayer), GreaterThan_CFixedPoint(Multiply_CFixedPoint('(CFixedPoint)10', Subtract_CFixedPoint(Multiply_CFixedPoint(Multiply_CFixedPoint(Goods.GetBasePrice, '(CFixedPoint)0.75'), Subtract_CFixedPoint(Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Subtract_CFixedPoint(Goods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, Add_CFixedPoint(Goods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders, '(CFixedPoint)10')), Max_CFixedPoint(Min_CFixedPoint(Goods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketBuyOrders, Add_CFixedPoint(Goods.WithMarketContext(ArticleDraft.GetSecondOrTarget.GetMarket.Self).GetMarketSellOrders, '(CFixedPoint)10')), '(CFixedPoint)0.01')), '(CFixedPoint)1'), '(CFixedPoint)-1'), Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Subtract_CFixedPoint(Add_CFixedPoint(Goods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders, '(CFixedPoint)10'), Goods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders), Max_CFixedPoint(Min_CFixedPoint(Add_CFixedPoint(Goods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketBuyOrders, '(CFixedPoint)10'), Goods.WithMarketContext(ArticleDraft.GetFirstOrSource.GetMarket.Self).GetMarketSellOrders), '(CFixedPoint)0.01')), '(CFixedPoint)1'), '(CFixedPoint)-1'))), Multiply_CFixedPoint(Divide_CFixedPoint(GetGoods('merchant_marine').WithMarketContext(GetPlayer.GetMarket.Self).GetMarketPrice, Goods.GetTradedQuantity), '(CFixedPoint)1.25'))), '(CFixedPoint)0'))]"
											size = { 60 16 }
											tooltipwidget = { smart_trade_card_tooltip = {} }
