							using = elide_fontsize_min
							max_width = 70
							raw_text = "[ArticleDraft.GetQuantityPercentage|0%]"
						}
					}
				}

				# Write the amount - Goods is not selected
				editbox = {
					visible = "[Not(ArticleDraft.HasInputValue('goods'))]"
					name = "treaty_amount_edit_no_good"
					enabled = no
					parentanchor = vcenter
					maxcharacters = 30
					size = { 150 30 }  # SMART TRADE: was 40
					alwaystransparent = no
					focuspolicy = click
					focus_on_visible = no
					align = nobaseline
					margin_left = 10
					raw_text = "0"

					background = {
						using = text_edit_bg
					}

					textbox = {
						parentanchor = right|vcenter
						position = { -10 0 }
						align = nobaseline
						autoresize = yes
						using = elide_fontsize_min
						max_width = 70
						raw_text = "0%"
					}
				}

				textbox = {
					parentanchor = vcenter
					align = nobaseline
					autoresize = yes
					using = elide_fontsize_min
					max_width = 100
					text = "SLASH_PER_WEEK"
				}
			}

			### SMART TRADE: its own row under the quantity
			flowcontainer = {
				parentanchor = hcenter
				spacing = 4
				margin_top = -2

				### SMART TRADE: live net at the current quantity, then the
				### Best and Max buttons. Shown for every good the player sends,
				### profitable or not (Damien: consistent UX; the player may
				### take a loss on purpose).
				textbox = {
					visible = "[And(And(And(ArticleDraft.HasType('goods_transfer'), ArticleDraft.HasInputValue('goods')), ArticleDraft.GetFirstOrSource.IsLocalPlayer), GetScriptedGui('st_markets_adjacent_sgui').IsValid(GuiScope.SetRoot(ArticleDraft.GetFirstOrSource.MakeScope).AddScope('st_other', ArticleDraft.GetSecondOrTarget.MakeScope).End))]"
					parentanchor = vcenter
					autoresize = yes
					align = nobaseline
					using = fontsize_small
					text = "ST_ROW_D_LAND"
					tooltipwidget = { smart_trade_draft_tooltip = {} }
				}
				textbox = {
					visible = "[And(And(And(ArticleDraft.HasType('goods_transfer'), ArticleDraft.HasInputValue('goods')), ArticleDraft.GetFirstOrSource.IsLocalPlayer), Not(GetScriptedGui('st_markets_adjacent_sgui').IsValid(GuiScope.SetRoot(ArticleDraft.GetFirstOrSource.MakeScope).AddScope('st_other', ArticleDraft.GetSecondOrTarget.MakeScope).End)))]"
					parentanchor = vcenter
					autoresize = yes
					align = nobaseline
					using = fontsize_small
					text = "ST_ROW_D_SEA"
					tooltipwidget = { smart_trade_draft_tooltip = {} }
				}
				### Goods the player sends: Best, Max, Accept
				smart_trade_best_button = {
					visible = "[And(And(ArticleDraft.HasType('goods_transfer'), ArticleDraft.HasInputValue('goods')), ArticleDraft.GetFirstOrSource.IsLocalPlayer)]"
					parentanchor = vcenter
					datacontext = "[ArticleDraft.GetSecondOrTarget.GetMarket]"
				}
				smart_trade_best_button = {
					visible = "[And(And(ArticleDraft.HasType('goods_transfer'), ArticleDraft.HasInputValue('goods')), ArticleDraft.GetFirstOrSource.IsLocalPlayer)]"
