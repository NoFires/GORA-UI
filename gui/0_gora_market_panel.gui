# GORA UI — market_panel + iliskili tipler (partial type override, VANILLA-TON)
# ─────────────────────────────────────────────────────────────────────────────
# Vanilla 1.13.9 baseline: gui/market_panel.gui
# Base type is the vanilla default_block_window (no custom window theme). The
# 0_gora_ filename keeps the vanilla file loaded; these types win first-load-wins.
# Restored vanilla element: the MARKET_COUNTRY_TRADE_CAPACITY readout on the
# trade tab (keep it when re-syncing).
#
# GORA features carried by this file:
#   (1) Export/import charts with quantity and monetary value in scrollable rows
#       priced at Goods.GetWorldMarketBasePrice.
#   (2) Second chart row: supply surplus/deficit, valued at local Goods.GetMarketPrice.
#   (3) Header statistics (balance / GDP / construction expenses) via
#       blockoverride "header_texts".
#   (4) Bulk-tariff button strip; widgets live in gui/gora_tariff_widgets.gui,
#       behavior in common/scripted_guis/gora_tariffs_scripted_guis.txt.
#   (5) trade_partners_charts hookup (gui/0_trade_partners_market_panel.gui).
#   (6) 2x2 extra goods filters (goods_filters) with matching visibility
#       predicates wired into goods_entry_button.
#   (7) Compact goods rows with a leaderboard rank label.
#
# Re-sync recipe: diff the redeclared types against vanilla and merge vanilla
# changes around the sections listed above.
# ─────────────────────────────────────────────────────────────────────────────

# Reference GORA+ content widths; keep goods headers and rows aligned.
@panel_width = 600
@panel_width_plus_14 = 624
# Match the working World Market outer width so the 624 px content fits.
@gora_market_window_width = 683

# Dispatch refreshes only after MarketPanel.GetMarket.IsValid has been checked.
# Selecting a state name avoids evaluating Execute with an invalid market root.
template gora_trade_partners_refresh_states {
	state = {
		name = gora_trade_partners_refresh_valid
		duration = 0
		on_start = "[GetScriptedGui('trade_partners_scripted_gui').Execute(GuiScope.SetRoot(MarketPanel.GetMarket.MakeScope).End)]"
	}
	state = {
		name = gora_trade_partners_refresh_skip
		duration = 0
	}
}

types market_panel
{

	type market_panel = default_block_window {
		name = "market_panel"
		# The inherited side-panel width is 613; child widths do not resize it.
		size = { @gora_market_window_width 0 }
		using = gora_trade_partners_refresh_states

		blockoverride "animation_state_block" {
			state = {
				name = _show
				on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(MarketPanel.GetMarket.IsValid, 'gora_trade_partners_refresh_valid', 'gora_trade_partners_refresh_skip'))]"
				start_sound = {
					soundeffect = "event:/SFX/UI/SideBar/markets"
				}
			}

			state = {
				name = _hide
				start_sound = {
					soundeffect = "event:/SFX/UI/SideBar/markets_stop"
				}
			}
		}
		
		datacontext = "[MarketPanel.GetMarket]"

		# Center the reference header through hbox layout, not widget margins.
		blockoverride "window_header" {
			hbox = {
				layoutpolicy_horizontal = expanding
				widget = { layoutpolicy_horizontal = expanding }
				widget = {
					size = { 560 102 }
					layoutpolicy_horizontal = fixed

					### BG
					widget = {
						size = { 570 106 }
						position = { 0 -4 }
						parentanchor = hcenter

						using = sidepanel_top_header
					}

					### TEXT
					block "header_texts" {
						flowcontainer = {
							parentanchor = center

							block "header_texts_before" {}

							textbox = {
								using = header_font_fancy
								using = header_font_fancy_size

								block "window_header_name" {
									raw_text = "Default Window Name"
								}

									align = hcenter|nobaseline

								autoresize = yes

								block "header_texts_maximum_size" {
									maximumsize = { 395 70 }
								}

								multiline = yes
								fontsize_min = 17

								default_format = "#header"
							}
						}
					}

					block "entire_back_button" {
						back_button_large = {
							position = { 8 30 }
							block "header_back_button" {
								onclick = "[InformationPanelBar.OpenPreviousPanel]"
								input_action = "back"
							}
						}
					}

					close_button_large = {
						position = { -8 30 }
						parentanchor = right
						block "header_close_button" {
							onclick = "[InformationPanelBar.ClosePanel]"
						}
						shortcut = "close_window"
					}

					widget = {
						block "pin_visibility" {
							visible = no
						}
						size = { 30 30 }
						position = { -48 59 }
						parentanchor = right

						button_icon_pin = {
							size = { 100% 100% }
							block "pin_properties" {}
							input_action = "toggle_pin"
						}
						button_icon_unpin = {
							size = { 100% 100% }
							block "unpin_properties" {}
							input_action = "toggle_pin"
						}
					}

					widget = {
						block "goto_visibility" {
							visible = no
						}
						size = { 30 30 }
						position = { -48 16 }
						parentanchor = right

						block "custom_goto_button" {
							button_icon_zoom = {
								size = { 100% 100% }
								block "goto_properties" {}
								input_action = "zoom_to"
							}
						}
					}

					widget = {
						block "edit_visibility" {
							visible = no
						}

						block "edit_tooltip" {
							tooltip = "EDIT"
						}

						size = { 30 30 }
						position = { 48 59 }

						button_icon_edit = {
							size = { 100% 100% }
							block "edit_properties" {}
						}
					}

					widget = {
						block "top_left_button_visibility" {
							visible = no
						}

						block "top_left_button_tooltip" {}

						size = { 30 30 }
						position = { 48 16 }

						button_icon_round = {
							size = { 100% 100% }

							block "top_left_button_properties" {}

							blockoverride "icon" {
								scale = 0.9

								block "top_left_button_texture" {
									texture = "gfx/interface/icons/generic_icons/home_hq.dds"
								}
							}
						}
					}
				}
				widget = { layoutpolicy_horizontal = expanding }
			}
		}

		blockoverride "header_texts" {
			flowcontainer = {
				parentanchor = center
				direction = vertical
				spacing = 2

				# Top row: market flag + name.
				flowcontainer = {
					parentanchor = hcenter

					flowcontainer = {
						parentanchor = vcenter
						margin_right = 15
						market_flag = {}
					}

					textbox = {
						using = header_font_fancy
						using = header_font_fancy_size
						raw_text = "[LabelingHelper.CapitalizeOnlyFirst(Market.GetNameNoFormatting)]"
						align = hcenter|nobaseline
						autoresize = yes
						maximumsize = { 332 70 }
						multiline = yes
						fontsize_min = 17
						default_format = "#header"

						tooltipwidget = {
							FancyTooltip_Market = {}
						}
					}
				}

				# Bottom row: balance / GDP / trade surplus.
				flowcontainer = {
					parentanchor = hcenter
					spacing = 4

					widget = {
						size = { 126 24 }
						tooltip = "[Market.GetBalanceDesc]"

						textbox = {
							text = "MARKET_BALANCE_MMP"
							parentanchor = center
							align = center|vcenter
							autoresize = yes
							fontsize_min = 9
						}
					}

					vertical_divider = {}

					widget = {
						size = { 122 24 }
						tooltip = "MARKET_GDP_HEADER_TOOLTIP"

						textbox = {
							text = "MARKET_GDP"
							parentanchor = center
							align = center|vcenter
							autoresize = yes
							fontsize_min = 9
						}
					}

					vertical_divider = {}

					widget = {
						size = { 68 24 }
						visible = "[GreaterThan_CFixedPoint(Market.GetTradeSurplus,'(CFixedPoint)-1')]"
						tooltip = "TRADE_SURPLUS_TOOLTIP"

						textbox = {
							raw_text = "@market_balance! [Market.GetTradeSurplus|=v%0]"
							parentanchor = center
							align = center|vcenter
							autoresize = yes
							fontsize_min = 9
						}
					}

					vertical_divider = {}

					widget = {
						size = { 56 24 }
						datacontext = "[GetMetaPlayer.GetPlayedOrObservedCountry]"
						visible = "[GreaterThan_int32(Market.GetCountryTradeCapacity(Country.Self), '(int32)0')]"
						tooltip = "[Market.GetCountryTradeCapacityDesc(Country.Self)]"

						icon = {
							size = { 16 16 }
							position = { 2 0 }
							parentanchor = vcenter
							texture = "gfx/interface/icons/trade_icons/trade_potential.dds"
						}

						textbox = {
							raw_text = "[Market.GetCountryTradeCapacityBalance(Country.Self)|+=]"
							position = { 20 0 }
							parentanchor = vcenter
							align = left|vcenter
							autoresize = yes
							fontsize_min = 9
						}
					}

					vertical_divider = {}

					widget = {
						size = { 74 24 }
						datacontext = "[GetMetaPlayer.GetPlayedOrObservedCountry]"
						using = tooltip_above

						tooltipwidget = {
							market_construction_goods_price_tooltip = {}
						}

						icon = {
							texture = "gfx/interface/icons/state_status_icons/has_construction.dds"
							size = { 15 15 }
							position = { 1 0 }
							parentanchor = vcenter
						}

						textbox = {
							text = "MARKET_CONSTRUCTION_EXPENSES_HEADER"
							alpha = "[TransparentIfZero(Country.GetConstructionGoodsExpenses)]"
							position = { 17 0 }
							parentanchor = vcenter
							align = left|vcenter
							autoresize = yes
							fontsize_min = 8
						}
					}
				}
			}
		}

		blockoverride "map_modes_button" {
			map_modes_single_button_minimized = {
				# Width is panel_width + 75 — re-tune if @panel_width changes.
				position = { 675 100 }
				datacontext = "[MarketPanel.GetMapModeList]"
				using = map_modes_button_position
			}
		}
		
		blockoverride "fixed_top"
		{
			tab_buttons = {
				blockoverride "first_button" {
					text = "MARKET_PANEL_DETAILS_TAB_LABEL"
				}
				blockoverride "first_button_tooltip" {
					tooltip = "MARKET_PANEL_DETAILS_TAB_LABEL" 
				}
				blockoverride "first_button_click" {
					onclick = "[InformationPanel.SelectTab('default')]"
				}
				blockoverride "first_button_visibility" {
					visible = "[InformationPanel.IsTabSelected('default')]"
				}
				blockoverride "first_button_visibility_checked" {
					visible = "[Not( InformationPanel.IsTabSelected('default') )]"
				}
				blockoverride "first_button_selected" {
					text = "MARKET_PANEL_DETAILS_TAB_LABEL_BOLD"
				}
				blockoverride "first_button_name" {
					name = "tutorial_highlight_market_details"
				}

				blockoverride "second_button" {
					text = "MARKET_PANEL_WORLD_MARKET_TRADE"
				}
				blockoverride "second_button_tooltip" {
					tooltip = "MARKET_PANEL_WORLD_MARKET_TRADE" 
				}
				blockoverride "second_button_click" {
					onclick = "[InformationPanel.SelectTab('world_market_trade')]"
				}
				blockoverride "second_button_visibility" {
					visible = "[InformationPanel.IsTabSelected('world_market_trade')]"
				}
				blockoverride "second_button_visibility_checked" {
					visible = "[Not( InformationPanel.IsTabSelected('world_market_trade') )]"
				}
				blockoverride "second_button_selected" {
					text = "MARKET_PANEL_WORLD_MARKET_TRADE"
				}

				blockoverride "third_button" {
					text = "MARKET_PANEL_FOOD_SECURITY_TAB_LABEL"
				}
				blockoverride "third_button_tooltip" {
					tooltip = "MARKET_PANEL_FOOD_SECURITY_TAB_LABEL" 
				}
				blockoverride "third_button_click" {
					onclick = "[InformationPanel.SelectTab('food_security')]"
				}
				blockoverride "third_button_visibility" {
					visible = "[InformationPanel.IsTabSelected('food_security')]"
				}
				blockoverride "third_button_visibility_checked" {
					visible = "[Not( InformationPanel.IsTabSelected('food_security') )]"
				}
				blockoverride "third_button_selected" {
					text = "MARKET_PANEL_FOOD_SECURITY_TAB_LABEL"
				}

				blockoverride "fourth_button" {
					text = "MARKET_PANEL_STATES_TAB_LABEL"
				}
				blockoverride "fourth_button_click" {
					onclick = "[InformationPanel.SelectTab('states')]"
				}
				blockoverride "fourth_button_visibility" {
					visible = "[InformationPanel.IsTabSelected('states')]"
				}
				blockoverride "fourth_button_visibility_checked" {
					visible = "[Not( InformationPanel.IsTabSelected('states') )]"
				}
				blockoverride "fourth_button_selected" {
					text = "MARKET_PANEL_STATES_TAB_LABEL_BOLD"
				}
			}
			
			flowcontainer = {
				visible = "[Or(InformationPanel.IsTabSelected('default'), InformationPanel.IsTabSelected('world_market_trade'))]"
				direction = vertical

				flowcontainer = {
					direction = vertical
					parentanchor = hcenter
					visible = "[InformationPanel.IsTabSelected('world_market_trade')]"

					### Vanilla trade-capacity readout (keep when re-syncing). The fixed-height
					### wrapper reserves real space in the flow so the collapsible section
					### header below cannot overlap it.
					widget = {
						size = { @panel_width 30 }

						textbox = {
							parentanchor = left|vcenter
							margin_left = 12
							datacontext = "[GetMetaPlayer.GetPlayedOrObservedCountry]"
							visible = "[GreaterThan_int32(Market.GetCountryTradeCapacity(Country.Self), '(int32)0')]"
							text = "MARKET_COUNTRY_TRADE_CAPACITY"
							tooltip = "[Market.GetCountryTradeCapacityDesc(Country.Self)]"
							autoresize = yes
							align = nobaseline
						}
					}

					section_header_button = {
						blockoverride "left_text" {
							text = "CHARTS"
							fontsize_min = 12
							elide = right
						}

						blockoverride "onclick" {
							onclick = "[GetVariableSystem.Toggle( 'market_world_market_charts' )]"
						}
						
						blockoverride "onclick_showmore" {
							visible = "[GetVariableSystem.Exists( 'market_world_market_charts' )]" # Flipped to show by Default
						}

						blockoverride "onclick_showless" {
							visible = "[Not(GetVariableSystem.Exists( 'market_world_market_charts' ))]" # Flipped to show by Default
						}
					}


					flowcontainer = {
						visible = "[Not(GetVariableSystem.Exists( 'market_world_market_charts' ))]" # Flipped to show by Default
						
						spacing = 10
						margin_bottom = 10
						margin_top = 10
						parentanchor = hcenter

						gora_trade_value_chart = {
							blockoverride "datamodel" {
								datamodel = "[Market.AccessMarketGoodsSortedOnExports( MarketPanel.GetFilters )]"
							}

							blockoverride "show_more_button_visibility" {
								visible = "[GreaterThan_int32(GetDataModelSize(Market.AccessMarketGoods( MarketPanel.GetFilters )), '(int32)3')]"
							}

							blockoverride "heading" {
								text = "EXPORTS"
							}

							blockoverride "tooltip" {
								tooltip = "WORLD_MARKET_GOODS_EXPORT_TOOLTIP"

								tooltipwidget = {
									RegularTooltip_MarketWorldMarketExportsTo = {}
								}
							}

							blockoverride "pieslice" {
								value = "[Market.GetExportedAmount(Goods.Self)]"
							}

							blockoverride "color" {
								color = "[Goods.GetColor]"
							}
							
							blockoverride "pie_item_goto_button" {
								button = {
									using = clean_button
									size = { 100% 100% }
									onclick = "[InformationPanelBar.OpenGoodsPanel(Market.Self, Goods.Self)]"
								}
							}

							blockoverride "leftside_info" {
								text = "[Goods.GetName]"
							}

							blockoverride "rightside1_info" {
								text = "[Goods.GetTextIcon] [Market.GetExportedAmount(Goods.Self)|vD]"
							}

							blockoverride "rightside2_info" {
								raw_text = "#positive_value @money!+[Multiply_CFixedPoint(Market.GetExportedAmount(Goods.Self), Goods.GetWorldMarketBasePrice)|1K]#!"
							}
						}

						gora_trade_value_chart = {
							blockoverride "datamodel" {
								datamodel = "[Market.AccessMarketGoodsSortedOnImports( MarketPanel.GetFilters )]"
							}

							blockoverride "show_more_button_visibility" {
								visible = "[GreaterThan_int32(GetDataModelSize(Market.AccessMarketGoods( MarketPanel.GetFilters )), '(int32)3')]"
							}

							blockoverride "heading" {
								text = "IMPORTS"
							}

							blockoverride "tooltip" {
								tooltip = "WORLD_MARKET_GOODS_IMPORT_TOOLTIP"

								tooltipwidget = {
									RegularTooltip_MarketWorldMarketImportsFrom = {}
								}
							}

							blockoverride "pieslice" {
								value = "[Market.GetImportedAmount(Goods.Self)]"
							}

							blockoverride "color" {
								color = "[Goods.GetColor]"
							}
							
							blockoverride "pie_item_goto_button" {
								button = {
									using = clean_button
									size = { 100% 100% }
									onclick = "[InformationPanelBar.OpenGoodsPanel(Market.Self, Goods.Self)]"
								}
							}

							blockoverride "leftside_info" {
								text = "[Goods.GetName]"
							}

							blockoverride "rightside1_info" {
								text = "[Goods.GetTextIcon] [Market.GetImportedAmount(Goods.Self)|vD]"
							}

							blockoverride "rightside2_info" {
								raw_text = "#negative_value @money!-[Multiply_CFixedPoint(Market.GetImportedAmount(Goods.Self), Goods.GetWorldMarketBasePrice)|1K]#!"
							}
						}
					}
					# Second row: local supply/demand balance. Trade partner charts follow.
					flowcontainer = {
						visible = "[Not(GetVariableSystem.Exists( 'market_world_market_charts' ))]"
						direction = horizontal
						spacing = 10
						margin_bottom = 10
						parentanchor = hcenter
						gora_balance_value_chart = {
							blockoverride "datamodel" {
								datamodel = "[Market.AccessMarketGoods( MarketPanel.GetFilters )]"
							}
							blockoverride "heading" {
								text = "MARKET_SUPPLY_SURPLUS"
								tooltip = "GORA_SUPPLY_SURPLUS_TOOLTIP"
							}
							blockoverride "gora_balance_row_visibility" {
								visible = "[GreaterThan_CFixedPoint(Goods.GetMarketBuyAndSellOrdersBalance, '(CFixedPoint)0')]"
							}
							blockoverride "pieslice" {
								value = "[Select_CFixedPoint(GreaterThan_CFixedPoint(Goods.GetMarketBuyAndSellOrdersBalance, '(CFixedPoint)0'), Goods.GetMarketBuyAndSellOrdersBalance, '(CFixedPoint)0')]"
							}
							blockoverride "color" {
								color = "[Goods.GetColor]"
							}
							blockoverride "tooltip" {
								tooltipwidget = { FancyTooltip_Goods = {} }
							}
							blockoverride "pie_item_goto_button" {
								button = {
									using = clean_button
									size = { 100% 100% }
									onclick = "[InformationPanelBar.OpenGoodsPanel(Market.Self, Goods.Self)]"
									onrightclick = "[RightClickMenuManager.ShowForGoods(Goods.AccessSelf)]"
								}
							}
							blockoverride "rightside1_info" {
								raw_text = "[Goods.GetTextIcon] #v [Goods.GetMarketBuyAndSellOrdersBalance|o=D]#!"
							}
							blockoverride "rightside2_info" {
								raw_text = "#positive_value @money![Multiply_CFixedPoint(Goods.GetMarketBuyAndSellOrdersBalance, Goods.GetMarketPrice)|1K]#!"
							}
						}
						gora_balance_value_chart = {
							blockoverride "datamodel" {
								datamodel = "[Market.GetTopGoodsByLowestBalance(GetDataModelSize(Market.GetGoodsSortedByBalance))]"
							}
							blockoverride "heading" {
								text = "MARKET_SUPPLY_DEFICIT"
								tooltip = "GORA_SUPPLY_DEFICIT_TOOLTIP"
							}
							blockoverride "gora_balance_row_visibility" {
								visible = "[LessThan_CFixedPoint(Goods.GetMarketBuyAndSellOrdersBalance, '(CFixedPoint)0')]"
							}
							blockoverride "pieslice" {
								value = "[Select_CFixedPoint(LessThan_CFixedPoint(Goods.GetMarketBuyAndSellOrdersBalance, '(CFixedPoint)0'), Abs_CFixedPoint(Goods.GetMarketBuyAndSellOrdersBalance), '(CFixedPoint)0')]"
							}
							blockoverride "color" {
								color = "[Goods.GetColor]"
							}
							blockoverride "tooltip" {
								tooltipwidget = { FancyTooltip_Goods = {} }
							}
							blockoverride "pie_item_goto_button" {
								button = {
									using = clean_button
									size = { 100% 100% }
									onclick = "[InformationPanelBar.OpenGoodsPanel(Market.Self, Goods.Self)]"
									onrightclick = "[RightClickMenuManager.ShowForGoods(Goods.AccessSelf)]"
								}
							}
							blockoverride "rightside1_info" {
								raw_text = "[Goods.GetTextIcon] #v [Goods.GetMarketBuyAndSellOrdersBalance|u=D]#!"
							}
							blockoverride "rightside2_info" {
								raw_text = "#negative_value @money![Multiply_CFixedPoint(Goods.GetMarketBuyAndSellOrdersBalance, Goods.GetMarketPrice)|1K]#!"
							}
						}
					}
					# Trade Partners charts (type defined in gui/00_trade_partners_charts.gui).
					# The wrapper carries the collapse/empty gating; the charts type itself
					# does not, so keep this flowcontainer when re-syncing.
					flowcontainer = {
						visible = "[Not(GetVariableSystem.Exists( 'market_world_market_charts' ))]"
						spacing = 10
						margin_bottom = 10
						parentanchor = hcenter
						using = gora_trade_partners_refresh_states
						state = {
							name = recalc_trade
							next = recalc_trade
							duration = 5
							trigger_on_create = yes
							on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(MarketPanel.GetMarket.IsValid, 'gora_trade_partners_refresh_valid', 'gora_trade_partners_refresh_skip'))]"
						}
						trade_partners_charts = {}
					}
				}

				section_header_button = {
					datacontext = "[GetMetaPlayer.GetPlayedOrObservedCountry]"
					visible = "[InformationPanel.IsTabSelected('default')]"
					
					blockoverride "left_text" {
						text = "MONTHLY_PRICE_REPORT"
						fontsize_min = 12
						elide = right
					}

					blockoverride "onclick" {
						onclick = "[GetVariableSystem.Toggle( 'monthly_price_report_dropdown' )]"
						enabled = "[GreaterThan_CFixedPoint(Market.GetMarketSharePercentageFor( Country.Self ), '(CFixedPoint)0')]"
					}
					
					blockoverride "onclick_showmore" {
						visible = "[Not(GetVariableSystem.Exists( 'monthly_price_report_dropdown' ))]"
					}

					blockoverride "onclick_showless" {
						visible = "[GetVariableSystem.Exists( 'monthly_price_report_dropdown' )]"
					}
				}

				flowcontainer = {
					visible = "[And(GetVariableSystem.Exists( 'monthly_price_report_dropdown' ), InformationPanel.IsTabSelected('default'))]"
					margin_top = 10
					margin_bottom = 10
					parentanchor = hcenter

					flowcontainer = {
						direction = vertical
						datacontext = "[GetMetaPlayer.GetPlayedOrObservedCountry]"

						minimumsize = { @panel_width -1 }
						margin_top = 10
						margin_bottom = 10

						background = {
							using = entry_bg
						}

						textbox = {
							text = "MONTHLY_PRICE_REPORT"
							autoresize = yes
							default_format = "#title"
							align = nobaseline
							margin_left = 10
							maximumsize = { @panel_width -1 }
						}

						textbox = {
							text = "[Country.GetPriceReportDesc]"
							margin = { 10 10 }
							margin_bottom = 5
							autoresize = yes
							align = nobaseline
							maximumsize = { @panel_width -1 }
							multiline = yes
						}
					}
				}

				# ================= GDP Composition Chart (collapsible) =================
				# Expanded by default; click the section header to expand/collapse.
				section_header_button = {
					visible = "[InformationPanel.IsTabSelected('default')]"
					blockoverride "left_text" {
						text = "GDP_CHART_TITLE"
						fontsize_min = 12
						elide = right
					}

					blockoverride "onclick" {
						onclick = "[GetVariableSystem.Toggle( 'gdp_chart_collapsed' )]"
					}

					blockoverride "onclick_showmore" {
						visible = "[GetVariableSystem.Exists( 'gdp_chart_collapsed' )]"
					}

					blockoverride "onclick_showless" {
						visible = "[Not(GetVariableSystem.Exists( 'gdp_chart_collapsed' ))]"
					}
				}

				# chart body (expanded by default)
				flowcontainer = {
					visible = "[And(Not(GetVariableSystem.Exists( 'gdp_chart_collapsed' )),InformationPanel.IsTabSelected('default'))]"
					using = default_list_position
					direction = vertical
					spacing = 8
					parentanchor = hcenter

					minimumsize = { @panel_width -1 }
					maximumsize = { @panel_width -1 }

					# Wrap the localized hint inside the panel.
					textbox = {
						text = "GDP_CHART_SUBTITLE"
						parentanchor = hcenter
						autoresize = yes
						multiline = yes
						minimumsize = { @panel_width -1 }
						maximumsize = { @panel_width -1 }
						align = center|nobaseline
						fontsize_min = 14
					}

					gdp_goods_chart = {}

					divider_clean = {
						using = default_list_position
					}
				}
				# ================= GDP Composition Chart (collapsible) =================

				section_header_button = {					
					blockoverride "left_text" {
						text = "FILTERS"
						fontsize_min = 12
						elide = right
					}

					blockoverride "right_text" {
						section_header_right_text = {
							text = "CURRENT_GOODS_FILTERS"
						}
					}

					blockoverride "onclick" {
						onclick = "[GetVariableSystem.Toggle( 'market_filters' )]"
					}
					
					blockoverride "onclick_showmore" {
						visible = "[GetVariableSystem.Exists( 'market_filters' )]" # Flipped to show by Default
					}

					blockoverride "onclick_showless" {
						visible = "[Not(GetVariableSystem.Exists( 'market_filters' ))]" # Flipped to show by Default
					}
				}

				### SEARCH
				search_bar = {
					parentanchor = hcenter
					datacontext = "[MarketPanel.GetSearchBar]"
				}

				flowcontainer = {
