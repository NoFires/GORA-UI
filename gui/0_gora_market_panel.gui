			}

			goods_filter_button = {
				block "luxury_icon_selected" {
					visible = "[MarketPanel.IsSelected('luxury')]"
				}
				using = tooltip_ne
				tooltip = "LUXURY_GOODS_FILTER"
				block "luxury_onclick" {
					onclick = "[MarketPanel.Filter('luxury')]"
					onclick = "[GetVariableSystem.Clear('filter_state_expenses')]"
					using = market_filter_luxury_button_sound
				}
				blockoverride "icon" {
					texture = "gfx/interface/market_view/filter_luxury_goods_selected.dds"
				}
			}
		}

		### MILITARY FILTER
		widget = {
			size = { 75 75 }

			icon = {
				texture = "gfx/interface/backgrounds/round_frame_dec.dds"
				size = { 75 75 }
				block "military_icon_selected" {
					visible = "[MarketPanel.IsSelected('military')]"
				}
				using = default_fade_in_out
			}

			goods_filter_button = {
				block "military_icon" {
					visible = "[Not(MarketPanel.IsSelected('military'))]"
				}
				using = tooltip_ne
				tooltip = "MILITARY_GOODS_FILTER"
				block "military_onclick" {
					onclick = "[MarketPanel.Filter('military')]"
					onclick = "[GetVariableSystem.Clear('filter_state_expenses')]"
					using = market_filter_military_button_sound
				}
				blockoverride "icon" {
					texture = "gfx/interface/market_view/filter_military_goods.dds"
				}
			}

			goods_filter_button = {
				block "military_icon_selected" {
					visible = "[MarketPanel.IsSelected('military')]"
				}
				using = tooltip_ne
				tooltip = "MILITARY_GOODS_FILTER"
				block "military_onclick" {
					onclick = "[MarketPanel.Filter('military')]"
					onclick = "[GetVariableSystem.Clear('filter_state_expenses')]"
					using = market_filter_military_button_sound
				}
				blockoverride "icon" {
					texture = "gfx/interface/market_view/filter_military_goods_selected.dds"
				}
			}
		}

		### GORA UI+ — extra goods filters (2x2 grid, default tab only)
		# Four variable-system filters layered on top of vanilla's category
		# filters. All four are composable with vanilla categories — when
		# both are active the resulting goods list is their intersection.
		# Exports and imports are mutually exclusive with each other. The
		# vanilla category onclick blocks clear `filter_state_expenses`
		# when clicked, so users switching from this filter to a vanilla
		# one in a single click works; the reverse direction requires
		# clicking the active vanilla button first.
		flowcontainer = {
			direction = vertical
			spacing = 5
			margin_left = 15
			parentanchor = vcenter
			# InformationPanel is not available inside the reusable
			# goods_filters type. The market-panel caller supplies this block
			# while it still has the required InformationPanel context.
			block "gora_extra_filters_visibility" {
				visible = yes
			}

			flowcontainer = {
				spacing = 8

				# State construction goods: wood, fabric, iron, tools, steel,
				# glass, explosives, paper. Composable with the vanilla
				# category filters — clicking this does not deselect them.
				# Vanilla category buttons clear this filter on their way
				# through the augmented onclick block, so the typical flow
				# (use vanilla 4 OR use this one) stays clean. Activating
				# both at once intersects the two sets.
				widget = {
					size = { 35 35 }

					icon = {
						visible = "[GetVariableSystem.Exists('filter_state_expenses')]"
						using = rotate_glow_blue
						size = { 130% 130% }
						parentanchor = center
						alwaystransparent = yes
					}

					button_icon_round = {
						size = { 100% 100% }
						onclick = "[GetVariableSystem.Toggle('filter_state_expenses')]"
						tooltip = "MARKET_FILTER_STATE_EXPENSES"
						blockoverride "icon" { texture = "gfx/interface/icons/state_status_icons/has_construction.dds" }
						blockoverride "icon_size" { size = { 75% 75% } }
					}
				}

				# Exported goods. Mutually exclusive with imports.
				widget = {
					size = { 35 35 }
					icon = {
						visible = "[GetVariableSystem.Exists('filter_exports')]"
						using = rotate_glow_blue
						size = { 130% 130% }
						parentanchor = center
						alwaystransparent = yes
					}
					button_icon_round = {
						size = { 100% 100% }
						onclick = "[GetVariableSystem.Toggle('filter_exports')]"
						onclick = "[GetVariableSystem.Clear('filter_imports')]"
						tooltip = "MARKET_FILTER_EXPORTS"
						blockoverride "icon" { texture = "gfx/interface/icons/trade_icons/exports.dds" }
						blockoverride "icon_size" { size = { 75% 75% } }
					}
				}
			}

			flowcontainer = {
				spacing = 8

				# Imported goods. Mutually exclusive with exports.
				widget = {
					size = { 35 35 }
					icon = {
						visible = "[GetVariableSystem.Exists('filter_imports')]"
						using = rotate_glow_blue
						size = { 130% 130% }
						parentanchor = center
						alwaystransparent = yes
					}
					button_icon_round = {
						size = { 100% 100% }
						onclick = "[GetVariableSystem.Toggle('filter_imports')]"
						onclick = "[GetVariableSystem.Clear('filter_exports')]"
						tooltip = "MARKET_FILTER_IMPORTS"
						blockoverride "icon" { texture = "gfx/interface/icons/trade_icons/imports.dds" }
						blockoverride "icon_size" { size = { 75% 75% } }
					}
				}

				# Goods in deficit (buy/sell balance < 0).
				widget = {
					size = { 35 35 }
					icon = {
						visible = "[GetVariableSystem.Exists('filter_deficits')]"
						using = rotate_glow_blue
						size = { 130% 130% }
						parentanchor = center
						alwaystransparent = yes
					}
					button_icon_round = {
						size = { 100% 100% }
						onclick = "[GetVariableSystem.Toggle('filter_deficits')]"
						tooltip = "MARKET_FILTER_DEFICITS"
						blockoverride "icon" { texture = "gfx/interface/icons/generic_icons/goods_shortage.dds" }
						blockoverride "icon_size" { size = { 75% 75% } }
					}
				}
			}
		}
		### GORA UI+ — end extra filters
	}
	
	type goods_entry_button = flowcontainer {
		direction = vertical
		
		visible = "[And( And( Or(Not(GetVariableSystem.Exists('filter_exports')), GreaterThan_CFixedPoint(Goods.GetMarketExports, '(CFixedPoint)0')), Or(Not(GetVariableSystem.Exists('filter_imports')), GreaterThan_CFixedPoint(Goods.GetMarketImports, '(CFixedPoint)0')) ), And( Or(Not(GetVariableSystem.Exists('filter_deficits')), LessThan_int32(FixedPointToInt(Goods.GetMarketBuyAndSellOrdersBalance), '(int32)0')), Or(Not(GetVariableSystem.Exists('filter_state_expenses')), Or(EqualTo_string(Goods.GetNameNoFormatting, Localize('wood')), Or(EqualTo_string(Goods.GetNameNoFormatting, Localize('fabric')), Or(EqualTo_string(Goods.GetNameNoFormatting, Localize('iron')), Or(EqualTo_string(Goods.GetNameNoFormatting, Localize('tools')), Or(EqualTo_string(Goods.GetNameNoFormatting, Localize('steel')), Or(EqualTo_string(Goods.GetNameNoFormatting, Localize('glass')), Or(EqualTo_string(Goods.GetNameNoFormatting, Localize('explosives')), EqualTo_string(Goods.GetNameNoFormatting, Localize('paper')))))))))) ) )]"
		
		button = {
			size = { @panel_width 35 }
			using = default_button
			onclick = "[InformationPanelBar.OpenGoodsPanel(Goods.GetMarket, Goods.Self)]"
			using = select_button_sound
			onrightclick = "[RightClickMenuManager.ShowForGoods(Goods.AccessSelf)]"

			block "tooltip" {
				tooltipwidget = {
					FancyTooltip_Goods = {}
				}
			}

			flowcontainer = {
				parentanchor = vcenter
				
				using = goods_list_item

				blockoverride "goods_list_item_icon_tooltip" {}

				textbox = {
					align = left|nobaseline
					text = "[Goods.GetNameNoFormatting]"
					fontsize_min = 14
					size = { 70 -1 }
					elide = right
					parentanchor = vcenter
				}

				block "last_column" {
					widget = {
						size = { 200 55 }

						# Rank is meaningless for prestige variants; hide them.
						# This column uses absolute positioning so hiding does
						# not shift the surrounding widgets.
						textbox = {
							visible = "[Not(Goods.IsPrestigeGoods)]"
							position = { -55 0 }
							raw_text = "BETTER_GOOD_LEADERBOARD"
							align = right|nobaseline
							size = { 90 40 }
							margin_right = 10
							parentanchor = vcenter
							margin_left = 5
							using = elide_fontsize_min
						}

						textbox = {
							position = { 30 0 }
							raw_text = "@money![Goods.GetMarketPrice|0v] [Goods.GetCompareIconAgainstBasePriceNoFormatting( Goods.GetMarketPrice )]"
							align = right|nobaseline
							size = { 90 40 }
							margin_right = 10
							parentanchor = vcenter
							margin_left = 5
							using = elide_fontsize_min
						}

						# Vanilla's 1.13.4 price-trend sparkline (vanilla L1206-1245)
						# is omitted — rank and percentage-delta columns already
						# convey trend, and the sparkline collides with them at
						# this theme's 200px row width.

						flowcontainer = {
							direction = vertical
							minimumsize = { 80 52 }
							spacing = 4
							margin_top = 8
							parentanchor = right

							textbox = {
								text = "MARKET_PANEL_GOODS_PRICE_GOLD"
								visible = "[GreaterThanOrEqualTo_CFixedPoint(Goods.GetPercentageDeltaAgainstBasePrice(Goods.GetMarketPrice), '(CFixedPoint)0.01')]"
								
								align = right|nobaseline
								autoresize = yes
								margin_right = 10
								parentanchor = right
							}

							textbox = {
								text = "MARKET_PANEL_GOODS_PRICE"
								visible = "[And( Not(LessThanOrEqualTo_CFixedPoint(Goods.GetPercentageDeltaAgainstBasePrice(Goods.GetMarketPrice), '(CFixedPoint)-0.01')), Not(GreaterThanOrEqualTo_CFixedPoint(Goods.GetPercentageDeltaAgainstBasePrice(Goods.GetMarketPrice), '(CFixedPoint)0.01')))]"
								
								align = hcenter|nobaseline
								autoresize = yes
								parentanchor = hcenter
							}

							textbox = {
								text = "MARKET_PANEL_GOODS_PRICE_BLUE"
								visible = "[LessThanOrEqualTo_CFixedPoint(Goods.GetPercentageDeltaAgainstBasePrice(Goods.GetMarketPrice), '(CFixedPoint)-0.01')]"
								
								align = left|nobaseline
								autoresize = yes
								margin_left = 10
							}

							double_direction_progressbar_gold = {
								size = { 60 6 }
								parentanchor = hcenter

								blockoverride "negative_min_max_values" {
									min = -0.75
									max = 0
								}

								blockoverride "positive_min_max_values" {
									min = 0
									max = 0.75
								}
								
								blockoverride "value_left" {
									value = "[FixedPointToFloat(Goods.GetPercentageDeltaAgainstBasePrice(Goods.GetMarketPrice))]"
								}
								blockoverride "value_right" {
									value = "[FixedPointToFloat(Goods.GetPercentageDeltaAgainstBasePrice(Goods.GetMarketPrice))]"
								}
							}
						}
					}
				}

				vertical_divider = {
									parentanchor = vcenter
									size = {1 35}
								}

				flowcontainer = {
					tooltip = "MARKET_GOODS_BALANCE_TOOLTIP"
					direction = vertical
					minimumsize = { 90 52 }
					margin_top = 8
					spacing = 4

					textbox = {
						text = "MARKET_PANEL_BALANCE_GOLD"
						visible = "[GreaterThan_int32(FixedPointToInt(Goods.GetMarketBuyAndSellOrdersBalance), '(int32)0')]"
						
						align = right|nobaseline
						autoresize = yes
						margin_right = 15
						parentanchor = right
					}

					textbox = {
						text = "MARKET_PANEL_BALANCE"
						visible = "[EqualTo_int32(FixedPointToInt(Goods.GetMarketBuyAndSellOrdersBalance), '(int32)0')]"
						
						align = hcenter|nobaseline
						autoresize = yes
						parentanchor = hcenter
					}

					textbox = {
						text = "MARKET_PANEL_BALANCE_BLUE"
						visible = "[LessThan_int32(FixedPointToInt(Goods.GetMarketBuyAndSellOrdersBalance), '(int32)0')]"
						
						align = left|nobaseline
						autoresize = yes
						margin_left = 15
					}

					double_direction_progressbar_gold = {
						size = { 60 6 }
						parentanchor = hcenter

						blockoverride "negative_min_max_values" {
							min = "[Negate_float(FixedPointToFloat(Goods.GetMarket.GetMaxImbalanceScaledByBasePrice))]"
							max = 0
						}

						blockoverride "positive_min_max_values" {
							min = 0
							max = "[FixedPointToFloat(Goods.GetMarket.GetMaxImbalanceScaledByBasePrice)]"
						}
						
						blockoverride "value_left" {
							value = "[FixedPointToInt(Multiply_CFixedPoint(Goods.GetMarketBuyAndSellOrdersBalance, Goods.GetBasePrice))]"
						}
						blockoverride "value_right" {
							value = "[FixedPointToInt(Multiply_CFixedPoint(Goods.GetMarketBuyAndSellOrdersBalance, Goods.GetBasePrice))]"
						}
					}
				}
				
				vertical_divider = {
									parentanchor = vcenter
									size = {1 35}
								}

				flowcontainer = {
					direction = vertical
					minimumsize = { 90 52 }
					margin_top = 8
					spacing = 4

					widget = {
						size = { 1 4 }
						visible = "[IsZero_CFixedPoint(Goods.GetMarketImports)]"
					}

					textbox = {
						text = "[Goods.GetMarketSellOrdersWithTooltip]"
						visible = "[GreaterThan_CFixedPoint(Goods.GetMarketSellOrders, '(CFixedPoint)0')]"
						align = right|nobaseline
						autoresize = yes
						parentanchor = hcenter
					}

					textbox = {
						visible = "[Not(GreaterThan_CFixedPoint(Goods.GetMarketSellOrders, '(CFixedPoint)0'))]"
						raw_text = "-"
						align = right|nobaseline
						alpha = 0.5
						autoresize = yes
						parentanchor = hcenter
					}

					widget = {
						tooltip = "MARKET_GOODS_IMPORT_DEPENDENCE"
						
						tooltipwidget = {
							RegularTooltip_MarketWorldMarketImportsFrom = {}
						}

						visible = "[NotZero_CFixedPoint(Goods.GetMarketImports)]"
						
						parentanchor = hcenter
						size = { 60 6 }

						gold_progressbar_horizontal = {
							size = { 60 6 }
							
							blockoverride "values" {
								min = 0
								max = "[Goods.GetMarketSellOrders]"
								value = "[Goods.GetMarketImports]"
							}
						}
					}
				}

				vertical_divider = {
									parentanchor = vcenter
									size = {1 35}
								}
				
				flowcontainer = {
					direction = vertical
					minimumsize = { 90 52 }
					margin_top = 8
					spacing = 4

					widget = {
						size = { 1 4 }
						visible = "[IsZero_CFixedPoint(Goods.GetMarketExports)]"
					}

					textbox = {
						text = "[Goods.GetMarketBuyOrdersWithTooltip]"
						visible = "[GreaterThan_CFixedPoint(Goods.GetMarketBuyOrders, '(CFixedPoint)0')]"
						align = right|nobaseline
						autoresize = yes
						parentanchor = hcenter
					}

					textbox = {
						visible = "[Not(GreaterThan_CFixedPoint(Goods.GetMarketBuyOrders, '(CFixedPoint)0'))]"
						raw_text = "-"
						align = right|nobaseline
						alpha = 0.5
						autoresize = yes
						parentanchor = hcenter
					}

					widget = {
						tooltip = "MARKET_GOODS_EXPORT_DEPENDENCE"
						tooltipwidget = {
							RegularTooltip_MarketWorldMarketExportsTo = {}
						}

						visible = "[NotZero_CFixedPoint(Goods.GetMarketExports)]"
						
						parentanchor = hcenter
						size = { 60 6 }

						gold_progressbar_horizontal = {
							size = { 60 6 }
							
							blockoverride "values" {
								min = 0
								max = "[Goods.GetMarketBuyOrders]"
								value = "[Goods.GetMarketExports]"
							}
						}
					}
				}
			}
		}

		flowcontainer = {
			visible = "[Not(GetVariableSystem.Exists( 'hide_prestige_goods' ))]"
			direction = vertical

			flowcontainer = {
				visible = "[Not(IsDataModelEmpty(Goods.GetMarketPrestigeGoods))]"

				better_goods_prestige_goods_breakdown_list_item = {
					size = { 575 35 }

					blockoverride "leaderboard_place"{
						raw_text = "BETTER_PRESTIGE_GOOD_LEADERBOARD"
					}

					blockoverride "prestige_goods_item_text_1" {
						margin_right = 10
						raw_text = "BETTER_BASE_GOODS_MARKET_SELL_ORDERS"
					}

					blockoverride "prestige_goods_item_text_2" {
						raw_text = "BETTER_BASE_GOODS_MARKET_BUY_ORDERS"
					}
				}
				margin_left = 10
			}

			flowcontainer = {
				visible = "[Not(IsDataModelEmpty(Goods.GetMarketPrestigeGoods))]"
				direction = vertical
				margin_left = 10
				margin_bottom = 10
				datamodel = "[Goods.GetMarketPrestigeGoods]"


				item = {
					container = {
						better_goods_prestige_goods_breakdown_list_item = {
							visible = "[Goods.CanEditName]"
							size = { 575 35 }

							blockoverride "prestige_goods_item_name_size" {
								minimumsize = { 114 -1 }
								maximumsize = { 114 -1 }
							}
						}

						better_goods_prestige_goods_breakdown_list_item = {
							visible = "[Not(Goods.CanEditName)]"
							size = { 575 35 }
						}
					}
				}
			}
		}
	}



	type state_goods_entry_button = button {
		size = { @panel_width 50 }
		using = default_button
		onclick = "[InformationPanelBar.OpenGoodsStatePanel(Goods.GetState, Goods.Self)]"
		using = select_button_sound
		onrightclick = "[RightClickMenuManager.ShowForGoods(Goods.AccessSelf)]"

		block "tooltip" {}

		flowcontainer = {
			parentanchor = left|vcenter
			widgetanchor = left|vcenter
			
			using = goods_list_item
			
			textbox = {
				text = "[Goods.GetStateProductionWithTooltip]"
				visible = "[GreaterThan_CFixedPoint(Goods.GetStateProduction, '(CFixedPoint)0')]"
				
				align = right|nobaseline
				size = { 95 40 }
				margin_right = 10
				parentanchor = vcenter
			}

			textbox = {
				visible = "[Not(GreaterThan_CFixedPoint(Goods.GetStateProduction, '(CFixedPoint)0'))]"
				raw_text = "-"
				
				align = right|nobaseline
				alpha = 0.5
				size = { 95 40 }
				margin_right = 10
				parentanchor = vcenter
			}

			vertical_divider = {
									parentanchor = vcenter
									size = {1 35}
								}
			
			textbox = {
				text = "[Goods.GetStateConsumptionWithTooltip]"
				visible = "[GreaterThan_CFixedPoint(Goods.GetStateConsumption, '(CFixedPoint)0')]"
				
				align = right|nobaseline
				size = { 90 40 }
				margin_right = 10
				parentanchor = vcenter
			}

			textbox = {
				visible = "[Not(GreaterThan_CFixedPoint(Goods.GetStateConsumption, '(CFixedPoint)0'))]"
				raw_text = "-"
				
				align = right|nobaseline
				alpha = 0.5
				size = { 90 40 }
				margin_right = 10
				parentanchor = vcenter
			}

			vertical_divider = {
									parentanchor = vcenter
									size = {1 35}
								}
			
			flowcontainer = {
				tooltip = "STATE_GOODS_BALANCE_TOOLTIP"
				
				direction = vertical
				minimumsize = { 90 52 }
				margin_top = 8
				spacing = 4

				textbox = {
					text = "GOODS_LOCAL_PRICE_PANEL_BALANCE_GOLD"
					visible = "[GreaterThan_int32(FixedPointToInt(Goods.GetStateProductionConsumptionDiff), '(int32)0')]"
				
					align = right|nobaseline
					autoresize = yes
					margin_right = 15
					parentanchor = right
				}

				textbox = {
					text = "GOODS_LOCAL_PRICE_PANEL_BALANCE"
					visible = "[EqualTo_int32(FixedPointToInt(Goods.GetStateProductionConsumptionDiff), '(int32)0')]"
				
					align = hcenter|nobaseline
					autoresize = yes
					parentanchor = hcenter
				}

				textbox = {
					text = "GOODS_LOCAL_PRICE_PANEL_BALANCE_BLUE"
					visible = "[LessThan_int32(FixedPointToInt(Goods.GetStateProductionConsumptionDiff), '(int32)0')]"
				
					align = left|nobaseline
					autoresize = yes
					margin_left = 15
					parentanchor = left
				}

				double_direction_progressbar_gold = {
					size = { 60 6 }
					parentanchor = hcenter

					blockoverride "negative_min_max_values" {
						min = "[Negate_float(FixedPointToFloat(Goods.GetMarket.GetMaxImbalanceScaledByBasePrice))]"
						max = 0
					}

					blockoverride "positive_min_max_values" {
						min = 0
						max = "[FixedPointToFloat(Goods.GetMarket.GetMaxImbalanceScaledByBasePrice)]"
					}
					
					blockoverride "value_left" {
						value = "[FixedPointToInt(Multiply_CFixedPoint(Goods.GetStateProductionConsumptionDiff, Goods.GetBasePrice))]"
					}
					blockoverride "value_right" {
						value = "[FixedPointToInt(Multiply_CFixedPoint(Goods.GetStateProductionConsumptionDiff, Goods.GetBasePrice))]"
					}
				}
			}

			vertical_divider = {
									parentanchor = vcenter
									size = {1 35}
								}
			
			block "last_column" {
				widget = {
					using = market_price_tooltip_with_graph
					size = { 90 55 }

					textbox = {
						raw_text = "@money![Goods.GetStatePrice|0v] [Goods.GetCompareIconAgainstBasePriceNoFormatting( Goods.GetStatePrice )]"
				
						parentanchor = vcenter
						align = right|nobaseline
						size = { 80 40 }
						fontsize_min = 12
						elide = right
					}
				}

				vertical_divider = {
									parentanchor = vcenter
									size = {1 35}
								}

				widget = {
					tooltip = "GOODS_SHORTAGE_TOOLTIP"
					size = { 120 55 }
					
					textbox = {
						text = "FOOD_SECURITY_GOODS_ITEM_HAS_SHORTAGE_IN_STATE"
						visible = "[Goods.HasShortageInState]"
				
						align = right|nobaseline
						size = { 110 40 }
						margin_right = 10
						parentanchor = vcenter
						margin_left = 5
						fontsize_min = 12
						elide = right
					}

					textbox = {
						text = "FOOD_SECURITY_GOODS_ITEM_NO_SHORTAGE"
						visible = "[Not(Goods.HasShortageInState)]"
				
						align = right|nobaseline
						size = { 110 40 }
						margin_right = 10
						parentanchor = vcenter
						margin_left = 5
						fontsize_min = 12
						elide = right
						using = empty_state_text_properties
					}
				}
			}
		}
	}

	type market_world_market_goods_list_item = widget {
		

		block "market_world_market_goods_list_item_visibility" {
			visible = "[Or(NotZero_CFixedPoint(Market.GetImportedAmount(Goods.Self)), NotZero_CFixedPoint(Market.GetExportedAmount(Goods.Self)))]"
		}

		tooltipwidget = {
			FancyTooltip_Goods = {}
		}

		background = {
			using = entry_bg_simple
		}

		flowcontainer = {
			direction = vertical
			spacing = 5
			resizeparent = yes
			margin_bottom = 7

			button = {
				onclick = "[InformationPanelBar.OpenGoodsPanel(Goods.GetMarket, Goods.Self)]"
				onrightclick = "[RightClickMenuManager.ShowForGoods(Goods.AccessSelf)]"
				using = default_button
				using = select_button_sound
				
				container = {
					resizeparent = yes

					icon = {
						texture = "gfx/interface/market_view/trade_good_list_bg.dds"
						size = { @panel_width 30 }
						color = "[Goods.GetCategoryColor]"
					}

					flowcontainer = {
						minimumsize = { @panel_width -1 }
						margin_left = -4
						margin_top = 2

						background = {
							using = dark_area
						}
						
						widget = {
							size = { 20 30 }

							icon = {
								texture = "gfx/interface/market_view/trade_good_icon_bg.dds"
								color = "[Goods.GetCategoryColor]"
								size = { 36 36 }
								parentanchor = center
								position = { 0 -1 }
								
								icon = {
									texture = "[Goods.GetTexture]"
									size = { 25 25 }
									parentanchor = center
								}

								icon = {
									visible = "[Goods.HasGoodsShortage]"
									tooltip = "GOODS_SHORTAGE_TOOLTIP"	
									size = { 20 20 }
									texture = "gfx/interface/icons/generic_icons/goods_shortage.dds"
									parentanchor = bottom|right
								}
							}
						}

						flowcontainer = {
							margin_top = 2

							textbox = {
								text = "[Goods.GetNameNoFormatting]"
								align = nobaseline
								autoresize = yes
								margin_left = 5
								minimumsize = { 120 -1 }
								# maximumsize = { 120 -1 }
								elide = right
								margin_right = 5
							}
							# Hide rank for prestige variants. Parent is a horizontal
							# flowcontainer here, so alpha is used instead of
							# visible to keep the 40px column reserved and prevent
							# the trailing widgets from shifting left.
							textbox = {
								alpha = "[TransparentIfFalse(Not(Goods.IsPrestigeGoods))]"
								text = "BETTER_GOOD_LEADERBOARD"
								align = nobaseline
								autoresize = yes
								margin_left = 5
								minimumsize = { 40 -1 }
								# maximumsize = { 40 -1 }
							}

							textbox = {
								raw_text = "[Goods.GetMarket.GetOwner.GetFlagTextIcon] @money![Goods.GetMarketPrice|v1] [Goods.GetCompareIconAgainstBasePriceNoFormatting(Goods.GetMarketPrice)]"
								align = nobaseline
								autoresize = yes
								minimumsize = { 130 -1 }
								# maximumsize = { 130 -1 }
							}

							flowcontainer = {
								icon = { 
									texture = "gfx/interface/icons/generic_icons/world_market.dds"
									size = { 23 23 }
								}

								textbox = {
									raw_text = "@money![Goods.GetWorldMarketBasePrice|1v] [Goods.GetCompareIconAgainstBasePriceNoFormatting(Goods.GetWorldMarketBasePrice)]"
									align = nobaseline
									autoresize = yes
									minimumsize = { 107 -1 }
									# maximumsize = { 107 -1 }
								}
							}

							textbox = {
								text = "TOTAL_TARIFFS_SUBVENTIONS_MONEY_MARKET_BALANCE_FOR_GOODS"
								align = nobaseline|right
								autoresize = yes
								minimumsize = { 110 -1 }
								#maximumsize = { 110 -1 }
							}
						}
					}
				}
			}

			flowcontainer = {
				direction = vertical
				minimumsize = { @panel_width -1 }
				spacing = 5

				flowcontainer = {
					visible = "[Or( NotZero_CFixedPoint(Market.GetImportedAmount(Goods.Self)), GetVariableSystem.Exists( 'tariffs_show_all' ))]"
					spacing = 5
					margin_left = 10

					icon = {
						texture = "gfx/interface/icons/trade_icons/imports.dds"
						size = { 23 23 }
						parentanchor = vcenter
					}

					textbox = {
						text = "[Market.GetImportedAmount(Goods.Self)|vD]"
						alpha = "[TransparentIfZero(Market.GetImportedAmount(Goods.Self))]"
						autoresize = yes
						align = nobaseline
						minimumsize = { 60 -1 }
						# maximumsize = { 60 -1 }
						fontsize_min = 12
						parentanchor = vcenter
					}
					

					overlappingitembox = {
						datamodel = "[Goods.GetExportersToMarket]"
						size = { 160 18 }
						parentanchor = vcenter
						spacing = 5

						item = {
							small_market_flag = {
								parentanchor = vcenter
							}
						}
					}

					widget = {
						size = { 6 6 }
					}

					set_level_bar_import_tariffs = {}
				}

				flowcontainer = {
					visible = "[Or( NotZero_CFixedPoint(Market.GetExportedAmount(Goods.Self)), GetVariableSystem.Exists( 'tariffs_show_all' ))]"
					spacing = 5
					margin_left = 10

					icon = {
						texture = "gfx/interface/icons/trade_icons/exports.dds"
						size = { 23 23 }
						parentanchor = vcenter
					}
					
					textbox = {
						text = "[Market.GetExportedAmount(Goods.Self)|vD]"
						alpha = "[TransparentIfZero(Market.GetExportedAmount(Goods.Self))]"
						autoresize = yes
						align = nobaseline
						minimumsize = { 60 -1 }
						maximumsize = { 60 -1 }
						fontsize_min = 12
						parentanchor = vcenter
					}

					overlappingitembox = {
						datamodel = "[Goods.GetImportersFromMarket]"
						size = { 160 18 }
						parentanchor = vcenter
						spacing = 5

						item = {
							small_market_flag = {
								parentanchor = vcenter
							}
						}
					}

					widget = {
						size = { 6 6 }
					}

					set_level_bar_export_tariffs = {}
				}
			}
		}
	}

	type market_construction_goods_price_tooltip = widget {
		container = {
			using = tooltip_properties
			datacontext = "[GetMetaPlayer.GetPlayedOrObservedCountry]"

			flowcontainer = {
				direction = vertical
				spacing = 2
				margin = { 13 10 }

				textbox = {
					text = "GORA_MARKET_CONSTRUCTION_GOODS_TOOLTIP_TITLE"
					autoresize = yes
					using = tooltip_font
					default_format = "#header"
				}

				textbox = {
					text = "GORA_MARKET_CONSTRUCTION_GOODS_TOOLTIP_DESC"
					multiline = yes
					autoresize = yes
					maximumsize = { 300 -1 }
					using = tooltip_font
					using = fontsize_small
				}

				textbox = {
					text = "GORA_MARKET_CONSTRUCTION_GOODS_TOOLTIP_TOTAL"
					autoresize = yes
					using = tooltip_font
					using = fontsize_small
				}

				flowcontainer = {
					direction = vertical
					spacing = 1
					datamodel = "[Market.AccessMarketGoods( MarketPanel.GetFilters )]"

					item = {
						flowcontainer = {
							visible = "[Or( EqualTo_string(Goods.GetNameNoFormatting, Localize('wood')), Or( EqualTo_string(Goods.GetNameNoFormatting, Localize('fabric')), Or( EqualTo_string(Goods.GetNameNoFormatting, Localize('iron')), Or( EqualTo_string(Goods.GetNameNoFormatting, Localize('tools')), Or( EqualTo_string(Goods.GetNameNoFormatting, Localize('steel')), Or( EqualTo_string(Goods.GetNameNoFormatting, Localize('glass')), Or( EqualTo_string(Goods.GetNameNoFormatting, Localize('explosives')), EqualTo_string(Goods.GetNameNoFormatting, Localize('electricity')) ) ) ) ) ) ) )]"
							spacing = 4

							icon = {
								texture = "[Goods.GetTexture]"
								size = { 18 18 }
								parentanchor = vcenter
							}

							textbox = {
								text = "[Goods.GetNameNoFormatting]"
								parentanchor = vcenter
								autoresize = yes
								minimumsize = { 74 -1 }
								maximumsize = { 74 -1 }
								elide = right
								using = tooltip_font
								using = fontsize_small
							}

							textbox = {
								raw_text = "@money![Goods.GetMarketPrice|0v]"
								parentanchor = vcenter
								align = right|nobaseline
								autoresize = yes
								minimumsize = { 42 -1 }
								using = tooltip_font
								using = fontsize_small
							}

							textbox = {
								text = "MARKET_PANEL_GOODS_PRICE_GOLD"
								visible = "[GreaterThanOrEqualTo_CFixedPoint(Goods.GetPercentageDeltaAgainstBasePrice(Goods.GetMarketPrice), '(CFixedPoint)0.01')]"
								parentanchor = vcenter
								align = right|nobaseline
								autoresize = yes
								minimumsize = { 34 -1 }
								using = tooltip_font
								using = fontsize_small
							}

							textbox = {
								text = "MARKET_PANEL_GOODS_PRICE"
								visible = "[And( Not(LessThanOrEqualTo_CFixedPoint(Goods.GetPercentageDeltaAgainstBasePrice(Goods.GetMarketPrice), '(CFixedPoint)-0.01')), Not(GreaterThanOrEqualTo_CFixedPoint(Goods.GetPercentageDeltaAgainstBasePrice(Goods.GetMarketPrice), '(CFixedPoint)0.01')))]"
								parentanchor = vcenter
								align = right|nobaseline
								autoresize = yes
								minimumsize = { 34 -1 }
								using = tooltip_font
								using = fontsize_small
							}

							textbox = {
								text = "MARKET_PANEL_GOODS_PRICE_BLUE"
								visible = "[LessThanOrEqualTo_CFixedPoint(Goods.GetPercentageDeltaAgainstBasePrice(Goods.GetMarketPrice), '(CFixedPoint)-0.01')]"
								parentanchor = vcenter
								align = right|nobaseline
								autoresize = yes
								minimumsize = { 34 -1 }
								using = tooltip_font
								using = fontsize_small
							}
						}
					}
				}

				textbox = {
					text = "GORA_MARKET_CONSTRUCTION_GOODS_TOOLTIP_NOTE"
					multiline = yes
					autoresize = yes
					maximumsize = { 300 -1 }
					margin_top = 2
					using = tooltip_font
					using = fontsize_small
				}

				textbox = {
					text = "GORA_MARKET_CONSTRUCTION_GOODS_TOOLTIP_SPENDING_TITLE"
					visible = "[Or(Not(StringIsEmpty(Country.GetGovernmentConstructionGoodsExpensesByGoodsDesc)), Not(StringIsEmpty(Country.GetPrivateConstructionGoodsExpensesByGoodsDesc)))]"
					autoresize = yes
					margin_top = 2
					using = tooltip_font
					default_format = "#header"
				}

				textbox = {
					text = "GORA_MARKET_CONSTRUCTION_GOODS_TOOLTIP_GOVERNMENT"
					visible = "[Not(StringIsEmpty(Country.GetGovernmentConstructionGoodsExpensesByGoodsDesc))]"
					multiline = yes
					autoresize = yes
					maximumsize = { 300 -1 }
					using = tooltip_font
					using = fontsize_small
				}

				textbox = {
					text = "GORA_MARKET_CONSTRUCTION_GOODS_TOOLTIP_PRIVATE"
					visible = "[Not(StringIsEmpty(Country.GetPrivateConstructionGoodsExpensesByGoodsDesc))]"
					multiline = yes
					autoresize = yes
					maximumsize = { 300 -1 }
					using = tooltip_font
					using = fontsize_small
				}
			}
		}
	}
}

template goods_list_item {
	widget = {
		block "goods_list_item_datacontext" {}
		parentanchor = vcenter
		
		block "widget_size" {
			size = { 45 35 }
		}

		block "goods_list_item_icon_tooltip" {
			tooltipwidget = {
				FancyTooltip_Goods = {}
			}
		}
		
		icon = {
			texture = "gfx/interface/market_view/trade_good_list_bg.dds"
			block "goods_list_item_background_position" {
				position = { 15 0 }
			}

			block "goods_list_item_background_size" {
				size = { 190 31 }
			}

			parentanchor = vcenter
			color = "[Goods.GetCategoryColor]"
		}

		icon = {
			texture = "gfx/interface/market_view/trade_good_icon_bg.dds"
			color = "[Goods.GetCategoryColor]"

			block "bg_size" {
				size = { 35 35 }
			}

			# Icon and shortage badge sized to keep vanilla's ~0.73 / ~0.45
			# ratios against the 35px frame used by this theme.
			icon = {
				texture = "[Goods.GetTexture]"
				size = { 26 26 }
				parentanchor = center
			}

			icon = {
				visible = "[Goods.HasGoodsShortage]"
				tooltip = "GOODS_SHORTAGE_TOOLTIP"

				size = { 16 16 }
				texture = "gfx/interface/icons/generic_icons/goods_shortage.dds"
				parentanchor = bottom
			}

			cannot_be_trade_icon = {}

			icon = {
				size = { 100% 100% }
				texture = "gfx/interface/icons/goods_icons/prestige_goods/trade_good_icon_prestige_frame.dds"
				visible = "[Goods.IsPrestigeGoods]"
			}

			icon = {
				size = { 100% 100% }
				texture = "gfx/interface/icons/goods_icons/prestige_goods/trade_good_icon_prestige_ribbon.dds"
				visible = "[Goods.IsPrestigeGoods]"
			}
		}
	}
}

prestige_good_change_name_popup_type = {
	name = prestige_good_change_name_popup
}

types prestige_good_change_name
{
}
