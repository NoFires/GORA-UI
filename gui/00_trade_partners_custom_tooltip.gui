# GORA UI+ — Trade Partners 0.1.4 Beautified Tooltips & FancyTooltip_Market
# ─────────────────────────────────────────────────────────────────────────────
# Vanilla 1.15.2 baseline for FancyTooltip_Market: gui/custom_tooltip.gui.
# Uses 100% verbatim vanilla & upstream Trade Partners localization keys
# (zero custom terminology), exact monetary (£) Trade Deficit/Surplus via
# trigger binary search, unified route orientation, and auto-resizing
# scrollable goods breakdown tables.
# ─────────────────────────────────────────────────────────────────────────────

@tooltip_max_width = 550 # copied from tooltip.gui

@tooltip_fixed_width = 500
@tooltip_fixed_column_width = 245
@tooltip_fixed_column_width_minus_40 = 205
@tooltip_fixed_column_width_minus_16 = 229

@tp_inner_width = 432
@tp_row_width = 418

types TooltipTypes {

	# =========================================================================
	# 0A. Export Partners Chart Heading Interactive FancyTooltip
	# =========================================================================
	type RegularTooltip_TradePartnersExportHeader = FancyTooltipWidgetType {
		blockoverride "name" {
			text = "[Market.GetNameNoFormatting]"
			alwaystransparent = no
			tooltipwidget = {
				FancyTooltip_Market = {}
			}
		}

		blockoverride "type" {
			alpha = 0.92
			raw_text = "#white [Localize('TRADE_PARTNERS_EXPORT_PARTNERS_GRAPH_TITLE')]#!"
		}

		blockoverride "color" {
			color = "[Market.GetOwner.GetMapColor]"
		}

		blockoverride "replace_icon" {
			small_flag = {
				parentanchor = center
				datacontext = "[Market.GetOwner]"
			}
		}

		blockoverride "icon_background_texture" {}
		blockoverride "icon_frame" {}

		blockoverride "tooltip_icon_position" {
			position = { 11 3 }
		}

		blockoverride "header_text_margin_left" {
			margin_left = 72
		}

		blockoverride "go_to_button_visibility" {
			visible = no
		}

		blockoverride "text" {
			visible = no
		}

		blockoverride "tooltip_content_after" {
			flowcontainer = {
				direction = vertical
				spacing = 8

				# Live Market Export Summary Card
				flowcontainer = {
					using = tooltip_segment_background
					direction = vertical
					margin = { 12 8 }
					spacing = 4

					widget = {
						size = { 380 22 }

						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacing = 6

							textbox = {
								autoresize = yes
								align = left|nobaseline
								text = "TRADE_PARTNERS_HEADER_EXPORTS_LABEL"
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}

							widget = { size = { 0 1 } layoutpolicy_horizontal = expanding }

							textbox = {
								autoresize = yes
								align = right|nobaseline
								raw_text = "#gold_value [Market.GetTotalExportedAmount|D]#!"
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
						}
					}

					widget = {
						size = { 380 20 }

						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacing = 6

							textbox = {
								autoresize = yes
								align = left|nobaseline
								using = fontsize_small
								alpha = 0.90
								text = "TRADE_PARTNERS_EXPORT_PARTNERS_GRAPH_TITLE"
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}

							widget = { size = { 0 1 } layoutpolicy_horizontal = expanding }

							textbox = {
								autoresize = yes
								align = right|nobaseline
								using = fontsize_small
								raw_text = "#v [GetDataModelSize(Market.GetOwner.MakeScope.GetList('trade_partners_all_markets_export'))]#!"
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
						}
					}

					divider_clean = {
						size = { 380 2 }
						alpha = 0.4
					}

					# Interactive Market Trade Surplus/Deficit row (hovers to vanilla breakdown!)
					widget = {
						size = { 380 22 }
						alwaystransparent = no
						tooltip = "TRADE_SURPLUS_TOOLTIP"

						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacing = 6

							textbox = {
								autoresize = yes
								align = left|nobaseline
								using = fontsize_small
								alpha = 0.95
								text = "TRADE_DEFICIT_SURPLUS"
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}

							widget = { size = { 0 1 } layoutpolicy_horizontal = expanding }

							textbox = {
								autoresize = yes
								align = right|nobaseline
								raw_text = "#tooltippable [Market.GetTradeSurplus|=v%0]#!"
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
						}
					}
				}

				# Interactive Formula & Concepts Card
				flowcontainer = {
					using = tooltip_segment_background
					direction = vertical
					margin = { 12 8 }

					custom_tooltip_textbox = {
						maximumsize = { 380 -1 }
						text = "TRADE_PARTNERS_EXPORT_PARTNERS_GRAPH_TOOLTIP"
					}
				}
			}
		}
	}

	# =========================================================================
	# 0B. Import Partners Chart Heading Interactive FancyTooltip
	# =========================================================================
	type RegularTooltip_TradePartnersImportHeader = FancyTooltipWidgetType {
		blockoverride "name" {
