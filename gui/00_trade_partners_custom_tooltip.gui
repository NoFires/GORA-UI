							spacing = 6

							textbox = {
								autoresize = yes
								align = left|nobaseline
								using = fontsize_small
								alpha = 0.90
								text = "TRADE_PARTNERS_IMPORT_PARTNERS_GRAPH_TITLE"
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}

							widget = { size = { 0 1 } layoutpolicy_horizontal = expanding }

							textbox = {
								autoresize = yes
								align = right|nobaseline
								using = fontsize_small
								raw_text = "#v [GetDataModelSize(Market.GetOwner.MakeScope.GetList('trade_partners_all_markets_import'))]#!"
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
						}
					}

					divider_clean = {
						size = { 380 2 }
						alpha = 0.4
					}

					# Interactive Market Trade Surplus/Deficit row (hovers to vanilla breakdown!)
					widget = {
						size = { 380 22 }
						alwaystransparent = no
						tooltip = "TRADE_SURPLUS_TOOLTIP"

						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacing = 6

							textbox = {
								autoresize = yes
								align = left|nobaseline
								using = fontsize_small
								alpha = 0.95
								text = "TRADE_DEFICIT_SURPLUS"
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}

							widget = { size = { 0 1 } layoutpolicy_horizontal = expanding }

							textbox = {
								autoresize = yes
								align = right|nobaseline
								raw_text = "#tooltippable [Market.GetTradeSurplus|=v%0]#!"
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
						}
					}
				}

				# Interactive Formula & Concepts Card
				flowcontainer = {
					using = tooltip_segment_background
					direction = vertical
					margin = { 12 8 }

					custom_tooltip_textbox = {
						maximumsize = { 380 -1 }
						text = "TRADE_PARTNERS_IMPORT_PARTNERS_GRAPH_TOOLTIP"
					}
				}
			}
		}
	}

	# =========================================================================
	# 0C. Nested Bilateral Import Value (£) Per-Good Derivation Tooltip
	#     Shows exact Amount × World Market Price = Value for every imported good
	# =========================================================================
	type RegularTooltip_TradePartnersImportValueBreakdown = FancyTooltipWidgetType {
		blockoverride "name" {
			text = "IMPORTS"
		}

		blockoverride "type" {
			datacontext = "[Scope.GetMarket]"
			alpha = 0.92
			raw_text = "#white [Market.GetNameNoFormatting]#!"
			alwaystransparent = no
			tooltipwidget = {
				FancyTooltip_Market = {}
			}
		}

		blockoverride "color" {
			color = "[Scope.GetMarket.GetOwner.GetMapColor]"
		}

		blockoverride "replace_icon" {
			icon = {
				parentanchor = center
				size = { 36 36 }
				texture = "gfx/interface/icons/trade_icons/imports.dds"
			}
		}

		blockoverride "icon_background_texture" {}
		blockoverride "icon_frame" {}

		blockoverride "tooltip_icon_position" {
			position = { 10 8 }
		}

		blockoverride "header_text_margin_left" {
			margin_left = 62
		}

		blockoverride "go_to_button_visibility" {
			visible = no
		}

		blockoverride "text" {
			visible = no
		}

		blockoverride "tooltip_content_after" {
			flowcontainer = {
				direction = vertical
				spacing = 6

				flowcontainer = {
					using = tooltip_segment_background
					direction = vertical
					margin = { 12 8 }
					spacing = 4

					widget = {
						size = { @tp_inner_width 22 }

						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacing = 4

							container = {
								datacontext = "[Market]"
								alwaystransparent = no
								tooltipwidget = { FancyTooltip_Market = {} }

								textbox = {
									autoresize = yes
									align = left|nobaseline
									elide = right
									max_width = 152
									raw_text = "[Market.GetOwner.GetFlagTextIcon] #header [Market.GetNameNoFormatting]#!"
									fonttintcolor = "[TooltipInfo.GetTintColor]"
								}
							}

							textbox = {
								autoresize = yes
								align = center|nobaseline
								raw_text = "#gold ◀#!"
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}

							container = {
								datacontext = "[Scope.GetMarket]"
								alwaystransparent = no
								tooltipwidget = { FancyTooltip_Market = {} }

								textbox = {
									autoresize = yes
									align = left|nobaseline
									elide = right
									max_width = 152
									raw_text = "[Market.GetOwner.GetFlagTextIcon] #header [Market.GetNameNoFormatting]#!"
									fonttintcolor = "[TooltipInfo.GetTintColor]"
								}
							}

							widget = { size = { 0 1 } layoutpolicy_horizontal = expanding }

							textbox = {
								autoresize = yes
								align = right|nobaseline
								raw_text = "@money!#v [TradePartnersGetImportValueFrom(Market, Scope.GetMarket)|D]#!"
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
						}
					}

					custom_tooltip_textbox = {
						maximumsize = { @tp_inner_width -1 }
						using = fontsize_small
						alpha = 0.82
						text = "TRADE_PARTNERS_VALUE_FORMULA_NOTE"
					}

					# Aligned manifest column header
					widget = {
						visible = "[TradePartnersIsImporterFrom(Market, Scope.GetMarket)]"
						size = { @tp_inner_width 18 }

						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							margin_left = 8
							margin_right = 22
							spacing = 6

							textbox = {
								layoutpolicy_horizontal = expanding
								align = left|nobaseline
								using = fontsize_small
								alpha = 0.80
								text = "MARKET_FILTER_IMPORTS"
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}

							textbox = {
								size = { 60 18 }
								align = right|nobaseline
								using = fontsize_small
								alpha = 0.80
								text = "AMOUNT"
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}

							textbox = {
								size = { 68 18 }
								align = right|nobaseline
								using = fontsize_small
								alpha = 0.80
								text = "MARKET_PRICE"
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}

							textbox = {
								size = { 78 18 }
								align = right|nobaseline
								using = fontsize_small
								alpha = 0.80
								text = "MARKET_TRADED_AMOUNT"
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
						}
					}

					divider_clean = {
						size = { @tp_inner_width 2 }
					}

					textbox = {
						visible = "[Not(TradePartnersIsImporterFrom(Market, Scope.GetMarket))]"
						size = { @tp_inner_width 24 }
						align = center|nobaseline
						using = empty_state_text_properties
						text = "NONE"
					}

					scrollarea = {
						visible = "[TradePartnersIsImporterFrom(Market, Scope.GetMarket)]"
						autoresizescrollarea = yes
						maximumsize = { @tp_inner_width 300 }
						scrollbarpolicy_horizontal = always_off
						alwaystransparent = no

						scrollwidget = {
							flowcontainer = {
								datamodel = "[Scope.GetMarket.GetExports]"
								direction = vertical
								ignoreinvisible = yes
								spacing = 2

								item = {
									widget = {
										visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.GetMarket.GetExportedAmountToMarket(Market.Self, Goods.Self), '(CFixedPoint)1')]"
										size = { @tp_row_width 26 }
										alwaystransparent = no

										background = {
											using = entry_bg_simple
											alpha = 0.85
										}

										tooltipwidget = {
											FancyTooltip_Goods = {}
										}

										hbox = {
											layoutpolicy_horizontal = expanding
											layoutpolicy_vertical = expanding
											margin = { 8 2 }
											spacing = 6

											icon = {
												size = { 20 20 }
												texture = "[Goods.GetTexture]"
											}

											textbox = {
												layoutpolicy_horizontal = expanding
												size = { 0 20 }
												align = left|nobaseline
												elide = right
												using = fontsize_small
												text = "[Goods.GetNameNoFormatting]"
												fonttintcolor = "[TooltipInfo.GetTintColor]"
											}

											textbox = {
												size = { 60 20 }
												align = right|nobaseline
												using = fontsize_small
												alwaystransparent = no
												tooltip = "TRADE_PARTNERS_GOODS_IMPORT_AMOUNT_BREAKDOWN"
												raw_text = "#v [Scope.GetMarket.GetExportedAmountToMarket(Market.Self, Goods.Self)|0D]#!"
												fonttintcolor = "[TooltipInfo.GetTintColor]"
											}

											textbox = {
												size = { 68 20 }
												align = right|nobaseline
												using = fontsize_small
												alwaystransparent = no
												tooltip = "[Goods.GetWorldMarketBasePriceDesc]"
												raw_text = "@money!#v [Goods.GetWorldMarketBasePrice|1]#!"
												fonttintcolor = "[TooltipInfo.GetTintColor]"
											}

											textbox = {
												size = { 78 20 }
												align = right|nobaseline
												using = fontsize_small
												alwaystransparent = no
												tooltip = "TRADE_PARTNERS_GOODS_IMPORT_VALUE_BREAKDOWN"
												raw_text = "@money!#v [Multiply_CFixedPoint(Scope.GetMarket.GetExportedAmountToMarket(Market.Self, Goods.Self), Goods.GetWorldMarketBasePrice)|D]#!"
												fonttintcolor = "[TooltipInfo.GetTintColor]"
											}
										}
									}
								}
							}
						}

						scrollbar_vertical = {
							using = vertical_scrollbar
						}
					}
				}
			}
		}
	}

	# =========================================================================
	# 0D. Nested Bilateral Export Value (£) Per-Good Derivation Tooltip
	#     Shows exact Amount × World Market Price = Value for every exported good
